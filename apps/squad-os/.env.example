# Copie pra .env.local (dev) ou configure como env vars de projeto na Vercel.
# Nenhum destes é a chave privada Salesforce nem o Consumer Secret — esses
# nunca entram aqui, ficam só no GitHub Environment do cliente (ver
# docs/conexoes-e-setup.md na raiz do repo).

# Postgres — botão Connect do projeto, aba "Session pooler" (porta 5432).
# Não use a aba Transaction (6543): `vercel-build` roda `prisma migrate deploy`
# com esta mesma variável e o schema não declara `directUrl`; transaction mode
# não suporta prepared statements. A conexão direta (db.<ref>.supabase.co) é
# IPv6-only sem add-on de IPv4, então também não serve na Vercel.
# Percent-encode a senha: @ = %40, # = %23, ! = %21.
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-[regiao].pooler.supabase.com:5432/postgres"

# Supabase Auth (Project Settings → API). O ANON_KEY é público por design
# (fica no bundle do browser) — quem decide acesso é a tabela `usuarios`
# (papel + cliente), não este par. Ver ADMIN_BOOTSTRAP_EMAILS abaixo.
NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="..."

# Service role key (Project Settings -> API Keys). Ela ignora RLS, então é
# server-only e NUNCA pode virar NEXT_PUBLIC_ — com o prefixo iria pro bundle
# do browser. Usada em duas coisas:
#   1. Anexos de demanda. Crie o bucket uma vez: Storage -> New bucket ->
#      "anexos-demanda", Public DESMARCADO, sem policy. Quem autoriza cada
#      download é a API do Squad OS (que sabe o cliente de cada demanda), e o
#      arquivo sai por URL assinada de 60s.
#   2. Convite de usuário novo. Conceder acesso em /admin/usuarios cria o
#      usuário no Supabase Auth e manda o convite — sem isso ninguém novo
#      consegue entrar, porque o auto-cadastro foi fechado e "esqueci minha
#      senha" só funciona pra quem já existe em auth.users.
SUPABASE_SERVICE_ROLE_KEY=""

# Autentica o pipeline (GitHub Actions) escrevendo de volta em /api/sync/*:
# estágio da demanda, resultado do teste de conexão e assessment da org. Gere
# uma string aleatória longa (`openssl rand -hex 32`) e cadastre A MESMA como
# secret de repositório no GitHub. Sem ela essas rotas ficam FECHADAS (503),
# não abertas — o contrário transformaria "esqueci de configurar" em "qualquer
# um escreve no banco".
SQUAD_OS_SYNC_TOKEN=""

# E-mails que viram admin automaticamente no primeiro login — só existe pra
# destravar o primeiro admin (sem isso ninguém consegue logar pra criar o
# primeiro registro em `usuarios`). Separados por vírgula. Depois do primeiro
# login, cada um já é uma linha normal em `usuarios` — dá pra gerenciar (e
# revogar) pela tela de Administração a partir daí, sem depender mais desta
# variável.
ADMIN_BOOTSTRAP_EMAILS=""

# Ponte de materialização (Squad OS -> este repo -> GitHub Actions).
# Personal Access Token (fine-grained) com Contents:write e Actions:write
# só neste repositório. Guarde como secret de projeto na Vercel, nunca commit.
GITHUB_TOKEN=""
GITHUB_REPO_OWNER="lobarbosa"
GITHUB_REPO_NAME="salesforce-agents"
GITHUB_REPO_BRANCH="main"
