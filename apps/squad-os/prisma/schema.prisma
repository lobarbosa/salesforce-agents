// Squad OS — schema relacional que substitui as coleções `clients`/`demandas`
// do Artifact db. Ver apps/squad-os/README.md para o runbook de migração.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum StatusConexao {
  nao_configurado
  aguardando_teste
  conectado
  erro
}

enum TipoDemanda {
  projeto
  sustentacao
}

enum Role {
  admin
  consultor
  cliente
}

enum StatusDemanda {
  // triagem
  backlog
  planejada
  recorrente
  standby
  // execução (fluxo canônico do CLAUDE.md raiz)
  analise
  aguardando_gate_analise
  design
  aguardando_gate_design
  build
  aguardando_gate_build
  qa
  aguardando_homologacao
  release
  entregue
}

model Client {
  id       String   @id @default(cuid())
  // Nome do diretório em clients/<slug>/ neste repo — é a chave que liga
  // este registro ao workspace Salesforce DX do cliente (CLAUDE.md de conta,
  // force-app/, demandas materializadas). Gerado do nome na criação, estável
  // depois disso mesmo que o nome de exibição mude.
  slug     String   @unique
  nome     String
  segmento String   @default("")
  criadoEm DateTime @default(now()) @map("criado_em")

  // Conhecimento do Cliente (briefing de conta)
  marcas             String @default("")
  contatos           String @default("")
  ambienteSalesforce String @default("") @map("ambiente_salesforce")
  concorrentes       String @default("")
  integracoes        String @default("")
  regras             String @default("")

  ambientes AmbienteOrg[]
  demandas  Demanda[]
  usuarios  Usuario[]

  @@map("clients")
}

// A esteira vai de dev até o deploy na sandbox de QA, e o agente para ali —
// por isso o enum tem exatamente esses dois. Produção não é modelada aqui de
// propósito: o guardrail #1 proíbe o agente de tocar prod, e registrar a
// credencial dela no app criaria justamente a superfície que a doutrina diz
// não existir. Prod vive só no GitHub Environment, com required reviewer.
enum TipoAmbiente {
  dev
  qa
}

// Uma linha por ambiente por cliente — antes esses campos eram achatados em
// `clients`, o que só comportava uma org. O Environment correspondente no
// GitHub segue `<slug>-<tipo>` (ex.: acxya-dev, acxya-qa), e o alias da org
// segue `sbx-<slug>-<tipo>`.
model AmbienteOrg {
  id       String       @id @default(cuid())
  clientId String       @map("client_id")
  client   Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tipo     TipoAmbiente

  // Nunca a chave privada nem o Consumer Secret — esses ficam só no GitHub
  // Environment do cliente (docs/conexoes-e-setup.md). Aqui fica só o que
  // identifica a conexão, não o que autentica sozinho.
  orgAlias           String?       @map("org_alias")
  loginUrl           String?       @map("login_url")
  username           String?
  consumerKey        String?       @map("consumer_key")
  statusConexao      StatusConexao @default(nao_configurado) @map("status_conexao")
  testeSolicitadoPor String?       @map("teste_solicitado_por")
  testeSolicitadoEm  DateTime?     @map("teste_solicitado_em")

  @@unique([clientId, tipo])
  @@index([clientId])
  @@map("ambientes_org")
}

// Quem pode entrar no Squad OS e com que escopo — substitui a allowlist por
// domínio/lista de e-mail (ADMIN_BOOTSTRAP_EMAILS continua existindo só pra
// destravar o primeiro admin, ver lib/auth.ts). Login em si continua sendo
// magic link do Supabase Auth pra qualquer e-mail; esta tabela é quem decide
// se esse e-mail tem autorização, com que papel, e (pra role=cliente) de
// qual cliente — não existe fluxo de convite por e-mail próprio: o admin
// concede acesso aqui, a pessoa só faz login normalmente depois.
model Usuario {
  id       String  @id @default(cuid())
  email    String  @unique
  nome     String  @default("")
  role     Role
  // Obrigatório (em código, não em constraint) quando role = cliente;
  // null pra admin/consultor, que não são escopados a um cliente.
  clientId String? @map("client_id")
  client   Client? @relation(fields: [clientId], references: [id], onDelete: Cascade)

  criadoEm     DateTime @default(now()) @map("criado_em")
  concedidoPor String?  @map("concedido_por")

  @@index([clientId])
  @@map("usuarios")
}

model Demanda {
  id       String @id @default(cuid())
  clientId String @map("client_id")
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  // <CODE>-<n> (ex.: ACXYA-1) — mesmo formato e mesma numeração sequencial
  // por cliente que src/salesforce_agents/demands.py:_next_id() já usa pra
  // nomear clients/<slug>/demandas/<code>/. Gerado na criação, nunca reusado.
  code String

  titulo   String
  tipo     TipoDemanda   @default(sustentacao)
  texto    String        @default("")
  autor    String        @default("")
  status   StatusDemanda @default(backlog)
  criadoEm DateTime      @default(now()) @map("criado_em")

  // Perguntas em aberto, aprovação de gate e histórico de transição —
  // mantidos como JSON (mesma forma de documento do modelo anterior;
  // não ganham nada sendo normalizados em tabelas próprias).
  perguntas Json  @default("[]")
  aprovacao Json?
  historico Json  @default("[]")

  materializadoEm DateTime? @map("materializado_em")

  comentarios Comentario[]
  subtarefas  Subtarefa[]
  checklist   ChecklistItem[]
  tempos      RegistroTempo[]
  anexos      Anexo[]

  @@unique([clientId, code])
  @@index([clientId])
  @@index([status])
  @@map("demandas")
}

// A conversa em torno da demanda — hoje ela acontece fora do sistema, o que
// deixa o gate humano sem rastro: quem aprovou vê a decisão, não o caminho
// até ela. Tabela própria, e não JSON como `perguntas`/`historico`, porque
// aqui a granularidade é a linha (autor, momento, texto) e ela cresce sem
// limite — os outros dois são documentos pequenos e fechados.
model Comentario {
  id        String  @id @default(cuid())
  demandaId String  @map("demanda_id")
  demanda   Demanda @relation(fields: [demandaId], references: [id], onDelete: Cascade)

  // Nome de exibição no momento do comentário, congelado de propósito: se a
  // pessoa mudar de nome depois, o histórico não reescreve quem falou o quê.
  autor      String
  autorEmail String @map("autor_email")
  texto      String

  criadoEm DateTime @default(now()) @map("criado_em")

  @@index([demandaId])
  @@map("comentarios")
}

// Subtarefa é unidade de trabalho: tem título e pode ser atribuída. Checklist
// é lista de verificação: só texto e feito/não feito. Parecem a mesma coisa e
// não são — separá-las evita que "conferir X" e "implementar Y" disputem a
// mesma lista, que é o que faz um card virar depósito.
model Subtarefa {
  id        String  @id @default(cuid())
  demandaId String  @map("demanda_id")
  demanda   Demanda @relation(fields: [demandaId], references: [id], onDelete: Cascade)

  titulo      String
  feita       Boolean @default(false)
  responsavel String  @default("")
  // Posição na lista. Int em vez de índice do array porque reordenar não pode
  // depender da ordem de chegada no banco.
  ordem       Int     @default(0)

  criadoEm DateTime @default(now()) @map("criado_em")

  @@index([demandaId])
  @@map("subtarefas")
}

model ChecklistItem {
  id        String  @id @default(cuid())
  demandaId String  @map("demanda_id")
  demanda   Demanda @relation(fields: [demandaId], references: [id], onDelete: Cascade)

  texto String
  feito Boolean @default(false)
  ordem Int     @default(0)

  criadoEm DateTime @default(now()) @map("criado_em")

  @@index([demandaId])
  @@map("checklist_itens")
}

// `fimEm` nulo é o timer rodando — é o estado, não uma flag separada, para não
// existir a combinação impossível "parado mas sem fim". `minutos` é gravado no
// stop (ou direto, no lançamento manual) em vez de calculado toda leitura:
// congela o valor mesmo que o relógio do servidor mude depois.
model RegistroTempo {
  id        String  @id @default(cuid())
  demandaId String  @map("demanda_id")
  demanda   Demanda @relation(fields: [demandaId], references: [id], onDelete: Cascade)

  autor      String
  autorEmail String @map("autor_email")
  descricao  String @default("")

  inicioEm DateTime  @map("inicio_em")
  fimEm    DateTime? @map("fim_em")
  minutos  Int?

  criadoEm DateTime @default(now()) @map("criado_em")

  @@index([demandaId])
  @@map("registros_tempo")
}

// Só metadado — o arquivo em si vive no Supabase Storage, no bucket
// `anexos-demanda`. `caminho` é a chave lá dentro; nada de binário no Postgres.
model Anexo {
  id        String  @id @default(cuid())
  demandaId String  @map("demanda_id")
  demanda   Demanda @relation(fields: [demandaId], references: [id], onDelete: Cascade)

  nome    String
  caminho String @unique
  tamanho Int
  tipo    String @default("")

  autor      String
  autorEmail String @map("autor_email")

  criadoEm DateTime @default(now()) @map("criado_em")

  @@index([demandaId])
  @@map("anexos")
}
