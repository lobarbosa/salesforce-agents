    <description>Flow, verifica se a conta e as subcontas (se existir) teve atividades, oportunidades ou pedidos nos últimos 3 meses.</description>
    <formulas>
        <name>FormulaDataUltimaAtv</name>
        <dataType>Date</dataType>
        <expression>IF( OR(ISNULL({!vDataUltimaAtv}), ISBLANK({!vDataUltimaAtv})), {!vLoopSubContas.DataUltimaAtividade__c}, 
IF( {!vLoopSubContas.DataUltimaAtividade__c} &gt;= {!vDataUltimaAtv}, {!vLoopSubContas.DataUltimaAtividade__c} ,{!vDataUltimaAtv}))</expression>
    </formulas>
    <formulas>
        <name>FormulaDataUltimoPedido</name>
        <dataType>Date</dataType>
        <expression>IF( OR(ISNULL({!vDataUltimoPedido}), ISBLANK({!vDataUltimoPedido})), {!vLoopSubContas.DataUltimaCompra__c}, 
IF( {!vLoopSubContas.DataUltimaCompra__c} &gt;= {!vDataUltimoPedido}, {!vLoopSubContas.DataUltimaCompra__c} ,{!vDataUltimoPedido}))</expression>
    </formulas>
    <formulas>
        <name>FormulaTresMesesAtras</name>
        <dataType>Date</dataType>
        <expression>DATE(YEAR(DATEVALUE((NOW()-90))),MONTH(DATEVALUE((NOW()-90))),1)</expression>
    </formulas>
    <formulas>
        <name>FormulaVaiTrocarOwner</name>
        <dataType>Boolean</dataType>
        <expression>{!isNullOppSubContas} &amp;&amp; {!isNullTodasOppContaPai} &amp;&amp; OR(ISNULL({!vDataUltimaAtv}), {!vDataUltimaAtv} &lt;= DATE(YEAR(DATEVALUE((NOW()-90))),MONTH(DATEVALUE((NOW()-90))),1)) &amp;&amp;  OR(ISNULL({!vDataUltimoPedido}), {!vDataUltimoPedido} &lt;= DATE(YEAR(DATEVALUE((NOW()-90))),MONTH(DATEVALUE((NOW()-90))),1))</expression>
    </formulas>
