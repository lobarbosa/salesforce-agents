    <formulas>
        <name>fDataFim</name>
        <dataType>Date</dataType>
        <expression>If( Month( {!fDataInicio} ) + 1 &gt; 12, Date( Year( {!fDataInicio} ) + 1, 01, 01) - 1, Date( Year( {!fDataInicio} ), Month( {!fDataInicio} ) + 1, 01) - 1 )</expression>
