        <scale>0</scale>
    </formulas>
    <formulas>
        <name>fAnoVigente</name>
        <dataType>Date</dataType>
        <expression>DATE({!Ano_Quadro},01,01)</expression>
    </formulas>
    <formulas>
        <name>fDiasAnalisadosCancelamento</name>
        <dataType>Date</dataType>
        <expression>{!fMesSeguinte} - {!$Record.Cancelamentos_Dias_analisados__c}</expression>
    </formulas>
    <formulas>
        <name>fMediaCarteiraAno</name>
        <dataType>Number</dataType>
        <expression>IF ({!vMediaCarteira} = {!vCarteira}, {!vCarteira} ,{!vMediaCarteira}/{!vQuadrosEncontrados} )</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>fMesSeguinte</name>
        <dataType>Date</dataType>
        <expression>IF( MONTH({!$Record.Mes_Vigente__c}) = 12, DATE(YEAR({!$Record.Mes_Vigente__c}) + 1,01,01), DATE(YEAR({!$Record.Mes_Vigente__c}),MONTH({!$Record.Mes_Vigente__c})+1,01))</expression>
    </formulas>
    <formulas>
        <name>fNomeQuadroDeMetas</name>
        <dataType>String</dataType>
        <expression>&quot;META &quot; + UPPER({!$Record.Vendedor__r.Alias}) + &quot;-&quot; + TEXT({!Ano_Quadro}) +&quot;-&quot; + TEXT({!Mes_Quadro})</expression>
    </formulas>
    <formulas>
        <name>fProximoAno</name>
        <dataType>Date</dataType>
        <expression>DATE({!Ano_Quadro}+1,01,01)</expression>
    </formulas>
    <formulas>
        <name>Mes_Quadro</name>
        <dataType>Number</dataType>
        <expression>Month({!$Record.Mes_Vigente__c})</expression>
        <scale>0</scale>
    </formulas>
