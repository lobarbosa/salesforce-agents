    <description>Fluxo, atualiza Sinal e DtProximaAtividade da conta Carteirizada e de todas as subcontas, se existir.</description>
    <formulas>
        <name>FormulaCobertura</name>
        <dataType>Number</dataType>
        <expression>IF( OR(ISBLANK({!vVendasNoMes}),{!vVendasNoMes}=0),0,
IF({!vPotencialMes}=0,1,
({!vVendasNoMes} / {!vPotencialMes})/(day( TODAY() )/
CASE(MONTH(TODAY()),1, 31,2,28,3,31,4,30,5,31,6,30,7,31,8,31,9,30,10,31,11,30,12,31,30))))</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>FormulaDataProximaAtv</name>
        <dataType>Date</dataType>
        <expression>IF( OR(ISNULL({!vDataProxAtv}), ISBLANK({!vDataProxAtv})), {!vLoopSubContas.DataProximaAtividade__c}, 
IF( {!vLoopSubContas.DataProximaAtividade__c} &gt;= {!vDataProxAtv}, {!vLoopSubContas.DataProximaAtividade__c} ,{!vDataProxAtv}))</expression>
    </formulas>
    <formulas>
        <name>FormulaSinal</name>
        <dataType>String</dataType>
        <expression>IF( OR( {!FormulaCobertura} * 100 &lt; 33, ISNULL({!vDataProxAtv}) ), &quot;Vermelho&quot; , 
IF( OR({!FormulaCobertura} * 100 &lt; 66, {!vDataProxAtv}  &lt; TODAY() ) , &quot;Amarelo&quot;, &quot;Verde&quot; ) )</expression>
    </formulas>
