    <description>Atualiza meta real, totalizando os produtos diferente de cancelado no mês da meta.</description>
    <environments>Default</environments>
    <formulas>
        <name>Fim_proximo_mes</name>
        <dataType>Date</dataType>
        <expression>IF(  MONTH({!vMesMeta}) = 12, DATE(YEAR({!vMesMeta})+1,02,01),
DATE(YEAR({!vMesMeta}),MONTH({!vMesMeta})+2,01))</expression>
    </formulas>
    <formulas>
        <name>FormulaFimMesMeta</name>
        <dataType>Date</dataType>
        <expression>DATE(YEAR({!vMesMeta}),MONTH({!vMesMeta}),CASE(MONTH({!vMesMeta}),1, 31,2,28,3,31,4,30,5,31,6,30,7,31,8,31,9,30,10,31,11,30,12,31,30))</expression>
    </formulas>
    <formulas>
        <name>FormulaIdVendedor</name>
        <dataType>String</dataType>
        <expression>LEFT({!vVendedor},15)</expression>
    </formulas>
    <formulas>
        <name>Proximo_mes</name>
        <dataType>Date</dataType>
        <expression>IF(  MONTH({!vMesMeta}) = 12, DATE(YEAR({!vMesMeta})+1,01,01),
DATE(YEAR({!vMesMeta}),MONTH({!vMesMeta})+1,01))</expression>
    </formulas>
