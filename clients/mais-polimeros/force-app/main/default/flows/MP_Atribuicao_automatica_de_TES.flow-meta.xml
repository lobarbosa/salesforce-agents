    <formulas>
        <name>fCodFilial</name>
        <dataType>String</dataType>
        <expression>Left( {!veFilialFaturamento}, 2)</expression>
    </formulas>
    <formulas>
        <name>fDestino</name>
        <dataType>String</dataType>
        <expression>IF({!veUF_Filial} &lt;&gt; {!veUF_Venda}, &quot;Fora&quot;, &quot;Dentro&quot;)</expression>
    </formulas>
    <formulas>
        <name>fMensagemNotificacao</name>
        <dataType>String</dataType>
        <expression>IF({!veTipoDeOperacao} = &quot;Normal&quot;, &quot;A TES da cotação &quot; +{!veNomeDaCotacao}+ &quot; foi alterada automaticamente para &quot; +{!ObterTesVendaOB2.Name}+ &quot;, pois a Filial de faturamento foi alterada, por favor, verificar.&quot;,
IF({!veTipoDeOperacao} = &quot;Triangular&quot;, &quot;A TES de Venda e de Remessa da cotação &quot; +{!veNomeDaCotacao}+ &quot; foram alteradas automaticamente para &quot; +{!ObterTesVendaOB2.Name}+ &quot; e &quot; + {!ObterTesRemessaOB2.Name} + &quot;, pois a Filial de faturamento foi alterada, por favor, verificar.&quot;,&quot;&quot;))</expression>
    </formulas>
    <formulas>
        <name>fTipoDeVenda</name>
        <dataType>String</dataType>
        <expression>IF (AND({!veTipoDeVenda} = &quot;F&quot;, {!veAmostra} = false ), &quot;Consumidor Final&quot;,
IF(AND({!veTipoDeVenda} &lt;&gt; &quot;F&quot;, {!veAmostra} = true ) , &quot;Amostra&quot;, &quot;veTipoDeOperacao&quot;))</expression>
    </formulas>
    <formulas>
        <name>vCorpoNotificacao</name>
        <dataType>String</dataType>
        <expression>IF({!veTipoDeOperacao} = &quot;Normal&quot;, &quot;Recomendamos a TES de Venda Padrão &quot;+{!ObterTesVendaOB2.Name}+&quot; para a &quot;+{!veNomeDaCotacao}+&quot; o verifique antes de prosseguir&quot;,
IF({!veTipoDeOperacao} = &quot;Triangular&quot;, &quot;Recomendamos a TES de Venda Padrão &quot;+ {!ObterTesVendaOB2.Name} +&quot; e TES de Remessa &quot;+{!ObterTesRemessaOB2.Name} + &quot; para a &quot; +{!veNomeDaCotacao}+&quot; verifique antes de prosseguir&quot;,&quot;&quot;))</expression>
    </formulas>
