    <description>Fluxo, calcula o Ciclo de Vida da conta &quot;Carteirizada&quot; e todas as subcontas, se exisitr.</description>
    <formulas>
        <name>FormulaCicloDeVida</name>
        <dataType>String</dataType>
        <expression>IF( AND({!vQtdKg1}=0, {!vQtdKg2}=0, {!vQtdKg3}=0, {!vQtdKg4}=0, {!vQtdKg5}=0, {!vQtdKg6}=0, {!vTotalVendasNoMes}&gt;0), &apos;Novo&apos;, 
IF(AND({!vQtdKg1}=0, {!vQtdKg2}=0, {!vQtdKg3}=0, {!vTotalVendasNoMes}&gt;0), &apos;Reativado&apos;,
IF(AND( OR({!vQtdKg1}&gt;0,{!vQtdKg2}&gt;0,{!vQtdKg3}&gt;0), {!vPotencialMes} &gt;= {!vMetaMesSugerida} *0.9), &apos;Regular crescente&apos;,
IF(AND(OR({!vQtdKg1}&gt;0,{!vQtdKg2}&gt;0,{!vQtdKg3}&gt;0), {!vPotencialMes} &lt; {!vMetaMesSugerida} *0.9), &apos;Regular decrescente&apos;,
IF(AND({!vQtdKg1}=0,{!vQtdKg2}=0,{!vQtdKg3}=0,{!vTotalVendasNoMes}=0), &apos;Não regular&apos;, &apos;&apos;)))))</expression>
    </formulas>
