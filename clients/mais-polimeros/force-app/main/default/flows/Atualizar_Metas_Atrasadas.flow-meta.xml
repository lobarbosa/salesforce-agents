        <name>Dia1</name>
        <dataType>Boolean</dataType>
        <expression>Day(Today()) = 1</expression>
    </formulas>
    <formulas>
        <name>Dia1Data</name>
        <dataType>Date</dataType>
        <expression>Date(Year(Today()),Month(Today()),1)</expression>
