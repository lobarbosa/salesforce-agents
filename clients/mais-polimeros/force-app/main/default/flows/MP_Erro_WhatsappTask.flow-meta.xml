    </formulas>
    <formulas>
        <name>fContatoGrupo</name>
        <dataType>Boolean</dataType>
        <expression>len({!$Record.ChatIntegration__Customer_Phone__c}) &gt; 13</expression>
    </formulas>
    <formulas>
        <name>fFormatarTelefone</name>
        <dataType>String</dataType>
        <expression>IF(
    LEN({!$Record.ChatIntegration__Customer_Phone__c}) - 2 = 11,  /* 55 + DDD + 9 dígitos */
    &quot;(&quot; + MID({!$Record.ChatIntegration__Customer_Phone__c}, 3, 2) + &quot;) &quot; + MID({!$Record.ChatIntegration__Customer_Phone__c}, 5, 5) + &quot;-&quot; + RIGHT({!$Record.ChatIntegration__Customer_Phone__c}, 4),
    &quot;(&quot; +  MID({!$Record.ChatIntegration__Customer_Phone__c}, 3, 2) + &quot;) &quot; + MID({!$Record.ChatIntegration__Customer_Phone__c}, 5, 4) + &quot;-&quot; + RIGHT({!$Record.ChatIntegration__Customer_Phone__c}, 4)
)</expression>
    </formulas>
    <formulas>
        <name>fRichTextAndSimpleText</name>
        <dataType>String</dataType>
        <expression>SUBSTITUTE(SUBSTITUTE({!tTesteConversa}, &quot;&lt;p&gt;&quot;, &quot;&quot;), &quot;&lt;/p&gt;&quot;, BR())</expression>
    </formulas>
    <formulas>
        <name>fTesteConversa</name>
        <dataType>String</dataType>
        <expression>&quot;&lt;p&gt;&quot; 
+ SUBSTITUTE(TEXT({!Contagem_de_mensagem.ChatIntegration__MessageSentTime__c}),&quot;Z&quot;,&quot;&quot;) + &quot; &quot; 
+ IF(
    TEXT({!Contagem_de_mensagem.ChatIntegration__MessageDirection__c}) = &quot;Outgoing&quot;, 
   {!An_lise_Individual_de_WPP_Number.Owner:User.FirstName} + &quot; &quot; + {!An_lise_Individual_de_WPP_Number.Owner:User.LastName}, 
   {!Obter_Contato.Name} 
  ) 
+ &quot;: &quot; 
+ {!Contagem_de_mensagem.ChatIntegration__Message_Content__c} 
+ &quot;&lt;/p&gt;&quot;</expression>
    </formulas>
    <formulas>
        <name>HorasDecorridas</name>
        <dataType>String</dataType>
        <expression>LPAD(TEXT(FLOOR(({!UltimoHorario} - {!PrimeiroHorario}) * 24)), 2, &quot;0&quot;)
&amp; &quot;:&quot;
&amp; LPAD(TEXT(FLOOR(MOD(({!UltimoHorario} - {!PrimeiroHorario}) * 24 * 60, 60))), 2, &quot;0&quot;)</expression>
    </formulas>
