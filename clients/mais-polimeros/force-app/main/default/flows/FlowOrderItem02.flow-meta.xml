    <decisions>
        <name>Pedido_Faturado</name>
        <label>Pedido Faturado?</label>
        <locationX>900</locationX>
        <locationY>162</locationY>
        <defaultConnectorLabel>Padrão</defaultConnectorLabel>
        <rules>
            <name>Sim_faturado</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>vLoop2.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Faturado</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Soma_Total_Vendido</targetReference>
            </connector>
            <label>Sim, faturado</label>
        </rules>
        <rules>
            <name>NaoAFaturar</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>vLoop2.Status__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Faturado</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>vLoop2.Status__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Devolvido</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Soma_Total_Vendido_e_A_faturar</targetReference>
            </connector>
            <label>Não, a faturar</label>
        </rules>
    </decisions>
    <description>Sumariza vendas mês corrente, atribui ciclo de vida e datas ultima emissão e ultimo pedido</description>
    <formulas>
        <name>FormulaCicloDeVida</name>
        <dataType>String</dataType>
        <expression>IF(AND({!vQtdKg1}=0,{!vQtdKg2}=0,{!vQtdKg3}=0, {!vTotalVendasNoMes}&gt;0), &quot;Novo&quot;, IF(OR({!vQtdKg1}&gt;0,{!vQtdKg2}&gt;0,{!vQtdKg3}&gt;0), &quot;Regular&quot;,&quot;Não Regular&quot;))</expression>
    </formulas>
    <formulas>
        <name>FormulaDataFim</name>
        <dataType>Date</dataType>
        <expression>DATE(YEAR(TODAY()), MONTH(TODAY())+1, 01 ) - 1</expression>
    </formulas>
    <formulas>
        <name>FormulaDataInicio</name>
        <dataType>Date</dataType>
        <expression>DATE(YEAR(TODAY()), MONTH(TODAY()), 01)</expression>
    </formulas>
