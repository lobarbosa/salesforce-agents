        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>fAtualizarObservacoes</name>
        <dataType>String</dataType>
        <expression>{!$Record.Observacoes__c} + &quot;(Email automático enviado  em: &quot; + TEXT({!$Flow.CurrentDate}) +&quot;)&quot;</expression>
    </formulas>
    <formulas>
        <name>fTodayDiaUtil</name>
        <dataType>Boolean</dataType>
        <expression>AND(
  MOD(TODAY() - DATE(1900, 1, 7), 7) &lt;&gt; 0,  /* Domingo */
  MOD(TODAY() - DATE(1900, 1, 7), 7) &lt;&gt; 6   /* Sábado */
)</expression>
    </formulas>
    <formulas>
        <name>fValidacaoData</name>
        <dataType>Date</dataType>
        <expression>{!$Record.LastModifiedDate} + 30</expression>
    </formulas>
