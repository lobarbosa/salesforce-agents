    <description>Fluxo criado para notificar pedido gerados com estoque negativo na loja. Existe um Apex que realiza essa notificação para pedidos internos, porém para a loja não existia esse controle</description>
    <environments>Default</environments>
    <formulas>
        <name>fCalculoEstoque</name>
        <dataType>Number</dataType>
        <expression>IF ( {!$Record.Filial__c} = &quot;01&quot;, {!ObterEstoque.Estoque01SP__c},      /* Filial Cajamar */
IF ( {!$Record.Filial__c} = &quot;02&quot;, {!ObterEstoque.Estoque02PR__c},      /* Filial Piraquara */
IF ( {!$Record.Filial__c} = &quot;04&quot;, {!ObterEstoque.Estoque04GO__c},      /* Filial Goias */
IF ( {!$Record.Filial__c} = &quot;07&quot;, {!ObterEstoque.Estoque07SC__c},      /* Filial Itajai */
IF ( {!$Record.Filial__c} = &quot;0801&quot;, {!ObterEstoque.Estoque08RS__c},      /* Filial Sapucaia */
IF ( {!$Record.Filial__c} = &quot;08AB&quot;, {!ObterEstoque.Estoque06RS__c},      /* Filial Caxias */
0 /* Caso não encontre a filial retorna zero, talvez seja necessário cadastrar */ ))))))
- {!$Record.Quantity}</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>fCalculoEstoqueAtual</name>
        <dataType>Number</dataType>
        <expression>IF ( {!$Record.Filial__c} = &quot;01&quot;, {!ObterEstoque.Estoque01SP__c},      /* Filial Cajamar */
IF ( {!$Record.Filial__c} = &quot;02&quot;, {!ObterEstoque.Estoque02PR__c},      /* Filial Piraquara */
IF ( {!$Record.Filial__c} = &quot;04&quot;, {!ObterEstoque.Estoque04GO__c},      /* Filial Goias */
IF ( {!$Record.Filial__c} = &quot;07&quot;, {!ObterEstoque.Estoque07SC__c},      /* Filial Itajai */
IF ( {!$Record.Filial__c} = &quot;0801&quot;, {!ObterEstoque.Estoque08RS__c},      /* Filial Sapucaia */
IF ( {!$Record.Filial__c} = &quot;08AB&quot;, {!ObterEstoque.Estoque06RS__c},      /* Filial Caxias */
0 /* Caso não encontre a filial retorna zero, talvez seja necessário cadastrar */ ))))))</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>fVerificarUltimaAtualizacaoEstoque</name>
        <dataType>Boolean</dataType>
        <expression>(now() - {!ObterEstoque.LastModifiedDate}) * 1440 &gt;= 2</expression>
    </formulas>
