    <description>Flow, categoriza a conta &quot;Carteirizada&quot; e todas as subcontas, se existir.</description>
    <formulas>
        <name>FormulaCategoria</name>
        <dataType>String</dataType>
        <expression>IF({!MediaDos6} &gt;= 50000 , &quot;Diamond&quot; ,  
IF({!MediaDos6} &gt;= 25000 &amp;&amp; {!MediaDos6} &lt; 50000 , &quot;Platinum&quot; , 
IF({!MediaDos6} &gt;= 12000 &amp;&amp; {!MediaDos6} &lt; 25000 , &quot;Gold&quot; , 
IF({!MediaDos6} &gt;= 6000 &amp;&amp; {!MediaDos6} &lt; 12000 , &quot;Silver&quot; , 
IF({!MediaDos6} &gt;= 3000 &amp;&amp; {!MediaDos6} &lt; 6000 , &quot;Bronze&quot; , &quot;Standard&quot;)))))</expression>
    </formulas>
    <formulas>
        <name>MediaDos6</name>
        <dataType>Number</dataType>
        <expression>({!vQtdKg1} + {!vQtdKg2} + {!vQtdKg3} + {!vQtdKg4} + {!vQtdKg5} + {!vQtdKg6})/6</expression>
        <scale>2</scale>
    </formulas>
