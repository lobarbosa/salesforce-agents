<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Calculo_Volume_de_Venda_Concluido__c</fullName>
    <formula>If( Meta_Commodities__c + Meta_Especialidades__c = 0, 1,

(Volume_de_Venda_Commodities__c + Volume_de_Venda_Especialidades__c)

/

(Meta_Commodities__c + Meta_Especialidades__c))</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Cálculo: Volume de Venda Realizado</label>
    <precision>18</precision>
    <required>false</required>
    <scale>0</scale>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Percent</type>
</CustomField>
