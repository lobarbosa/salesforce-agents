<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Calculo_Cancelamento__c</fullName>
    <formula>IF( Cancelamentos_Mes_Vigente__c -  Cancelamentos_Limite_estabelecido__c &gt; 0 , 0 , 1 )</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <inlineHelpText>1) Serão aceitos até 02 (dois) cancelamentos por mês;
2) Caso o item “1” seja superado, a nota para este item será “0” (zero);</inlineHelpText>
    <label>Cálculo: Cancelamento - Peso Mensal</label>
    <precision>18</precision>
    <required>false</required>
    <scale>0</scale>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Percent</type>
</CustomField>
