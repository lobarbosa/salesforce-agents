<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Calculo_Vol_de_Ven_Peso_Mensal_Real__c</fullName>
    <formula>If(IsBlank(Calculo_Volume_de_Venda_Peso_Mensal__c), 0,

Volume_de_Venda_Peso_Anual__c / Meses_Concluidos_Anual__c * Calculo_Volume_de_Venda_Peso_Mensal__c

)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <inlineHelpText>Volume mensal do campo  &quot;Cálculo: Volume de Venda - Mês Atual&quot; na Perspectiva Anual (Máximo de 5% ao mês)</inlineHelpText>
    <label>Volume de venda: Mês Atual Ref. ao Ano</label>
    <precision>18</precision>
    <required>false</required>
    <scale>2</scale>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Percent</type>
</CustomField>
