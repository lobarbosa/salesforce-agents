<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>ProprietarioFila</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
Owner:Queue.QueueName = &quot;Cadastro&quot;,
NOT(ISPICKVAL(Status,&apos;Enviado análise cadastral&apos;))
)</errorConditionFormula>
    <errorDisplayField>OwnerId</errorDisplayField>
    <errorMessage>No momento o Lead se encontra em uma fila de cadastro.Para dar continuidade alguém de cadastro deve pegar o Lead para si</errorMessage>
</ValidationRule>
