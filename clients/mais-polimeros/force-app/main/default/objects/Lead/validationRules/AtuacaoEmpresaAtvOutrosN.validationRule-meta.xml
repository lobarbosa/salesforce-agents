<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>AtuacaoEmpresaAtvOutrosN</fullName>
    <active>false</active>
    <errorConditionFormula>AND(
OR( 
ISPICKVAL(AtuacaoEmpresa__c,&quot;Outro&quot;),
ISPICKVAL(Setor_atividade__c ,&quot;Outro&quot;) 
),
ISPICKVAL(Status,&quot;Validado&quot;)
)</errorConditionFormula>
    <errorMessage>&quot;Outro&quot; não aceitável em atuação de empresa e setor de atividade.
Para prosseguir com o lead, favor verificar esses itens com o cliente</errorMessage>
</ValidationRule>
