<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>FasesAprovado</fullName>
    <active>true</active>
    <errorConditionFormula>AND( 
Text(PRIORVALUE(Status)) == &apos;Aprovado&apos;,
NOT(ISPICKVAL(Status,&apos;Validado&apos;)),
NOT(ISPICKVAL(Status,&apos;Aprovado&apos;))
)</errorConditionFormula>
    <errorMessage>Um lead APROVADO pode apenas ser VALIDADO</errorMessage>
</ValidationRule>
