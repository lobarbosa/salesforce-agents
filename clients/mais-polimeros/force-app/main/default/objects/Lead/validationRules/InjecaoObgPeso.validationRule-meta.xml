<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>InjecaoObgPeso</fullName>
    <active>false</active>
    <errorConditionFormula>AND(
ISPICKVAL(   AtuacaoEmpresa__c,&quot;Injeção&quot;),
ISBLANK(PesoDaPeca__c)
)</errorConditionFormula>
    <errorDisplayField>PesoDaPeca__c</errorDisplayField>
    <errorMessage>Se a atuação da empresa for de INJEÇÃO, o PESO DA PEÇA deve ser informado</errorMessage>
</ValidationRule>
