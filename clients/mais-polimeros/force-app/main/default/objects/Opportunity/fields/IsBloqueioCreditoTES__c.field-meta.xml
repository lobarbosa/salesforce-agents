<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>IsBloqueioCreditoTES__c</fullName>
    <description>Define quais TES isentam do bloqueio de crédito</description>
    <formula>CASE(TEXT(TES__c),
      &apos;520&apos;, 0,
      &apos;523&apos;, 0,
      &apos;526&apos;, 0,
      &apos;861&apos;, 0,
      &apos;878&apos;, 0,
      1
 ) = 1</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Bloqueio de Crédito por TES</label>
    <trackHistory>false</trackHistory>
    <type>Checkbox</type>
</CustomField>
