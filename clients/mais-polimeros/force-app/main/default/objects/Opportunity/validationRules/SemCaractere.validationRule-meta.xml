<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>SemCaractere</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    NOT(ISBLANK(CNPJ_Receptor__c)),
    NOT(REGEX(CNPJ_Receptor__c, &quot;^[0-9]+$&quot;))
)</errorConditionFormula>
    <errorDisplayField>CNPJ_Receptor__c</errorDisplayField>
    <errorMessage>Não utilize caracteres especiais</errorMessage>
</ValidationRule>
