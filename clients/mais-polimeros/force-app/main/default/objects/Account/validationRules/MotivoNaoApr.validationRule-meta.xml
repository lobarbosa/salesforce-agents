<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>MotivoNaoApr</fullName>
    <active>false</active>
    <errorConditionFormula>AND(
 ISBLANK(MotivoRecusaCredito__c),
 ISPICKVAL( StatusCredito__c ,&quot;Não aprovado&quot;)  
)</errorConditionFormula>
    <errorDisplayField>MotivoRecusaCredito__c</errorDisplayField>
    <errorMessage>Declare o motivo ao recusar um crédito</errorMessage>
</ValidationRule>
