<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>DocumentosenviadosRecebidos</fullName>
    <active>false</active>
    <errorConditionFormula>AND( 
NOT(DocumentosEnviados__c),
NOT(ISBLANK( DocumentosRecebidos__c ))
)</errorConditionFormula>
    <errorDisplayField>DocumentosEnviados__c</errorDisplayField>
    <errorMessage>Antes de Informar quais documentos foram recebidos, informe se os documentos foram enviados</errorMessage>
</ValidationRule>
