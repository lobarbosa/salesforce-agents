<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>AprLimiteObg</fullName>
    <active>false</active>
    <errorConditionFormula>AND(
 ISPICKVAL( StatusCredito__c , &apos;Aprovado&apos;),
 ISBLANK( LimiteCredito__c)
)</errorConditionFormula>
    <errorDisplayField>LimiteCredito__c</errorDisplayField>
    <errorMessage>Ao aprovar um crédito é obrigatório inserir seu limite</errorMessage>
</ValidationRule>
