<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Valida_Lead_Atividades_Pendentes</fullName>
    <active>false</active>
    <errorConditionFormula>AND (
   IsConverted = true,
   Atividades_Pendentes__c = true
     )</errorConditionFormula>
    <errorMessage>Revise as atividades pendentes. Para converter o lead é necessário concluir todas as atividades.</errorMessage>
</ValidationRule>
