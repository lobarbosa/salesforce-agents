            </action>
        </approvalActions>
        <assignedApprover>
            <approver>
                <name>cteixeira@somosagility.com.br</name>
                <type>user</type>
            </approver>
            <approver>
                <name>geraldo.berghem@somosagility.com.br</name>
                <type>user</type>
            </approver>
            <approver>
                <name>grupogp@somosagility.com.br</name>
                <type>user</type>
            </approver>
            <whenMultipleApprovers>Unanimous</whenMultipleApprovers>
        </assignedApprover>
        <label>Aprovação de Operações</label>
        <name>Aprovacao_de_Operacoes</name>
