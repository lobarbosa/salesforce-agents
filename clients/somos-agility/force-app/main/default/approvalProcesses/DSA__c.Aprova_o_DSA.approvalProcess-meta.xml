                <type>user</type>
            </approver>
            <whenMultipleApprovers>Unanimous</whenMultipleApprovers>
        </assignedApprover>
        <label>Pré-Validação (Triagem)</label>
        <name>Pre_Validacao_Triagem</name>
    </approvalStep>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <approvalActions>
            <action>
                <name>Notifica_o_de_Aprova_o_de_Opera_es</name>
