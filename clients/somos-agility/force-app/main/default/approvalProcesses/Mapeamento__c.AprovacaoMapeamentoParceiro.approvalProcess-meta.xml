<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>true</active>
    <allowRecall>false</allowRecall>
    <allowedSubmitters>
        <type>owner</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>Name</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <assignedApprover>
            <approver>
                <name>fabio.soto@somosagility.com.br</name>
                <type>user</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <label>Aprovação Comercial</label>
        <name>AprovacaoComercial</name>
    </approvalStep>
    <emailTemplate>Todos/AprovacaoMapeamento</emailTemplate>
    <enableMobileDeviceAccess>false</enableMobileDeviceAccess>
    <entryCriteria>
        <criteriaItems>
            <field>Mapeamento__c.Fase__c</field>
            <operation>equals</operation>
            <value>Em Análise</value>
        </criteriaItems>
    </entryCriteria>
    <finalApprovalActions>
        <action>
            <name>MapeamentoAprovado</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>MapeamentoConcluido</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>ValidadeMapeamento90dias</name>
            <type>FieldUpdate</type>
        </action>
    </finalApprovalActions>
    <finalApprovalRecordLock>false</finalApprovalRecordLock>
    <finalRejectionActions>
        <action>
            <name>Mapeamento_Negado_ou_Expirado</name>
            <type>Alert</type>
        </action>
        <action>
            <name>MapeamentoConcluido</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>MapeamentoReprovado</name>
            <type>FieldUpdate</type>
        </action>
    </finalRejectionActions>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <initialSubmissionActions>
        <action>
            <name>Alerta_de_criacao_de_Mapeamento</name>
            <type>Alert</type>
        </action>
    </initialSubmissionActions>
    <label>Aprovação Mapeamento Parceiro</label>
    <processOrder>1</processOrder>
    <recordEditability>AdminOnly</recordEditability>
    <showApprovalHistory>true</showApprovalHistory>
</ApprovalProcess>
