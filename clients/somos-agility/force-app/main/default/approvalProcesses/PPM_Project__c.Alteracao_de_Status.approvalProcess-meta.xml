<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>false</active>
    <allowRecall>true</allowRecall>
    <allowedSubmitters>
        <submitter>grupogp@somosagility.com.br</submitter>
        <type>user</type>
    </allowedSubmitters>
    <allowedSubmitters>
        <submitter>tatiane.sousa@agilitynetworks.com.br</submitter>
        <type>user</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>Name</field>
        <field>Project_Status__c</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <assignedApprover>
            <approver>
                <name>tatiane.sousa@agilitynetworks.com.br</name>
                <type>user</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <label>Qualificação PMO</label>
        <name>Qualificacao_PMO</name>
    </approvalStep>
    <emailTemplate>Projetos/Solicitacao_de_Alteracao_de_Status</emailTemplate>
    <enableMobileDeviceAccess>false</enableMobileDeviceAccess>
    <entryCriteria>
        <criteriaItems>
            <field>PPM_Project__c.Project_Status__c</field>
            <operation>equals</operation>
            <value>Atrasado,Cancelado,Dentro do prazo,Encerrado,Finalizado,Freezing,Tendência de atraso,Inativo</value>
        </criteriaItems>
    </entryCriteria>
    <finalApprovalActions>
        <action>
            <name>Aprovacao_da_Solicitacao_de_Alteracao_de_Status_do_Projeto</name>
            <type>Alert</type>
        </action>
    </finalApprovalActions>
    <finalApprovalRecordLock>true</finalApprovalRecordLock>
    <finalRejectionActions>
        <action>
            <name>Alteracao_de_Status_para_o_Valor_Anterio</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Rejeicao_da_Solicitacao_de_Alteracao_de_Status_do_Projeto</name>
            <type>Alert</type>
        </action>
    </finalRejectionActions>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <label>Alteração de Status</label>
    <processOrder>2</processOrder>
    <recallActions>
        <action>
            <name>Atualizar_Status_para_o_Anterior</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Recall_da_Solicitacao_de_Alteracao_de_Status_do_Projeto</name>
            <type>Alert</type>
        </action>
    </recallActions>
    <recordEditability>AdminOrCurrentApprover</recordEditability>
    <showApprovalHistory>true</showApprovalHistory>
</ApprovalProcess>
