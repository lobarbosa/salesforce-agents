<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>true</active>
    <allowRecall>true</allowRecall>
    <allowedSubmitters>
        <type>owner</type>
    </allowedSubmitters>
    <allowedSubmitters>
        <submitter>sales.operations@somosagility.com.br</submitter>
        <type>user</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>Name</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <assignedApprover>
            <approver>
                <name>renovacoes@somosagility.com.br</name>
                <type>user</type>
            </approver>
            <approver>
                <name>sales.operations@somosagility.com.br</name>
                <type>user</type>
            </approver>
            <approver>
                <name>se@somosagility.com.br</name>
                <type>user</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <label>Orçamentista - Validar Cotação</label>
        <name>OrcamentistaValidarCotacao</name>
    </approvalStep>
    <description>Processo de aprovação configurado para colher a aprovação do Orçamentista designado para a Aprovação.</description>
    <emailTemplate>FluxoVendaProdutos/ConferenciaCotacao</emailTemplate>
    <enableMobileDeviceAccess>false</enableMobileDeviceAccess>
    <entryCriteria>
        <criteriaItems>
            <field>FluxoVendaProdutos__c.Status__c</field>
            <operation>equals</operation>
            <value>Produtos na PFP,Validar Cotação</value>
        </criteriaItems>
        <criteriaItems>
            <field>FluxoVendaProdutos__c.StatusAprovacoes__c</field>
            <operation>equals</operation>
            <value>Aguardando Cotação,Cotação Reprovada,Pendente</value>
        </criteriaItems>
    </entryCriteria>
    <finalApprovalActions>
        <action>
            <name>CotacaoAprovada</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>StatusValidacaoFiscal</name>
            <type>FieldUpdate</type>
        </action>
    </finalApprovalActions>
    <finalApprovalRecordLock>true</finalApprovalRecordLock>
    <finalRejectionActions>
        <action>
            <name>CotacaoReprovada</name>
            <type>Alert</type>
        </action>
        <action>
            <name>CotacaoReprovada</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>StatusProdutosPFP</name>
            <type>FieldUpdate</type>
        </action>
    </finalRejectionActions>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <initialSubmissionActions>
        <action>
            <name>AguardandoCotacao</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>AtualizaFase</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>NotificaEnvolvidos</name>
            <type>Alert</type>
        </action>
    </initialSubmissionActions>
    <label>Validação Cotação</label>
    <processOrder>1</processOrder>
    <recallActions>
        <action>
            <name>StatusPendente</name>
            <type>FieldUpdate</type>
        </action>
    </recallActions>
    <recordEditability>AdminOnly</recordEditability>
    <showApprovalHistory>true</showApprovalHistory>
</ApprovalProcess>
