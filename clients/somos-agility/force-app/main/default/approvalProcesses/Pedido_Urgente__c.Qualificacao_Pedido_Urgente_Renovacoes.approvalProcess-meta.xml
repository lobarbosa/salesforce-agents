<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>true</active>
    <allowRecall>false</allowRecall>
    <allowedSubmitters>
        <type>creator</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>Name</field>
        <field>Justificativa__c</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <assignedApprover>
            <approver>
                <name>grupooperacoes@somosagility.com.br</name>
                <type>user</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <label>Qualificação Financeiro</label>
        <name>Qualificacao_Financeiro</name>
    </approvalStep>
    <emailTemplate>Pedido_Urgente/Nova_Solicitacao_de_Pedido_Urgente</emailTemplate>
    <enableMobileDeviceAccess>false</enableMobileDeviceAccess>
    <entryCriteria>
        <criteriaItems>
            <field>DSA__c.CreatedBy</field>
            <operation>equals</operation>
            <value>Shirlei Bortoleto,Grupo Renovações</value>
        </criteriaItems>
        <criteriaItems>
            <field>DSA__c.Pedido_Urgente__c</field>
            <operation>equals</operation>
            <value>Verdadeiro</value>
        </criteriaItems>
    </entryCriteria>
    <finalApprovalActions>
        <action>
            <name>Aprovacao_da_solicitacao_de_urgencia_de_pedido</name>
            <type>Alert</type>
        </action>
        <action>
            <name>Status_Pedido_Urgente_Aprovado</name>
            <type>FieldUpdate</type>
        </action>
    </finalApprovalActions>
    <finalApprovalRecordLock>true</finalApprovalRecordLock>
    <finalRejectionActions>
        <action>
            <name>Rejeicao_da_solicitacao_de_urgencia_de_pedido</name>
            <type>Alert</type>
        </action>
        <action>
            <name>Status_Pedido_Urgente_Rejeitado</name>
            <type>FieldUpdate</type>
        </action>
    </finalRejectionActions>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <initialSubmissionActions>
        <action>
            <name>Notificacao_Inicial_para_o_Financeiro</name>
            <type>Alert</type>
        </action>
        <action>
            <name>Status_Pedido_Urgente_Pendente</name>
            <type>FieldUpdate</type>
        </action>
    </initialSubmissionActions>
    <label>Qualificação Pedido Urgente Renovações</label>
    <nextAutomatedApprover>
        <useApproverFieldOfRecordOwner>false</useApproverFieldOfRecordOwner>
        <userHierarchyField>Manager</userHierarchyField>
    </nextAutomatedApprover>
    <processOrder>2</processOrder>
    <recallActions>
        <action>
            <name>Recall_da_solicitacao_de_urgencia_de_pedido</name>
            <type>Alert</type>
        </action>
    </recallActions>
    <recordEditability>AdminOrCurrentApprover</recordEditability>
    <showApprovalHistory>true</showApprovalHistory>
</ApprovalProcess>
