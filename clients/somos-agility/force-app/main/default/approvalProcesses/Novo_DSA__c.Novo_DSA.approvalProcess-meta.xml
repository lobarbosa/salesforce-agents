<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>false</active>
    <allowRecall>true</allowRecall>
    <allowedSubmitters>
        <type>owner</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>Name</field>
        <field>Conta__c</field>
        <field>Oportunidade__c</field>
        <field>CreatedBy</field>
        <field>Status__c</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>true</allowDelegate>
        <approvalActions>
            <action>
                <name>Alerta_de_Novo_DSA</name>
                <type>Alert</type>
            </action>
            <action>
                <name>Atualizcaoo_de_status_pend</name>
                <type>FieldUpdate</type>
            </action>
        </approvalActions>
        <assignedApprover>
            <approver>
                <name>grupooperacoes@somosagility.com.br</name>
                <type>user</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <description>AM 23032018: há somente uma etapa de aprovação pelo Grupo Operações</description>
        <label>Aprovação Operações</label>
        <name>Aprovacao_Operacoes</name>
        <rejectionActions>
            <action>
                <name>Alerta_de_rejeicao</name>
                <type>Alert</type>
            </action>
            <action>
                <name>Atualizacao_de_status_rejeitado</name>
                <type>FieldUpdate</type>
            </action>
        </rejectionActions>
    </approvalStep>
    <description>AM 23032018: processo de aprovação do novo modelo de DSA</description>
    <emailTemplate>Modelos_de_Email_Agility/Novo_DSA</emailTemplate>
    <enableMobileDeviceAccess>true</enableMobileDeviceAccess>
    <finalApprovalActions>
        <action>
            <name>Alerta_de_aprovacao</name>
            <type>Alert</type>
        </action>
        <action>
            <name>Atualizacao_de_status_aprov</name>
            <type>FieldUpdate</type>
        </action>
    </finalApprovalActions>
    <finalApprovalRecordLock>true</finalApprovalRecordLock>
    <finalRejectionActions>
        <action>
            <name>Alerta_de_rejeicao</name>
            <type>Alert</type>
        </action>
        <action>
            <name>Atualizacao_de_status_rejeitado</name>
            <type>FieldUpdate</type>
        </action>
    </finalRejectionActions>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <label>Novo DSA</label>
    <nextAutomatedApprover>
        <useApproverFieldOfRecordOwner>false</useApproverFieldOfRecordOwner>
        <userHierarchyField>Manager</userHierarchyField>
    </nextAutomatedApprover>
    <processOrder>1</processOrder>
    <recallActions>
        <action>
            <name>Atualizacao_de_status_recall</name>
            <type>FieldUpdate</type>
        </action>
    </recallActions>
    <recordEditability>AdminOrCurrentApprover</recordEditability>
    <showApprovalHistory>false</showApprovalHistory>
</ApprovalProcess>
