<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>true</active>
    <allowRecall>false</allowRecall>
    <allowedSubmitters>
        <type>owner</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>Name</field>
        <field>Status_da_Solicitacao__c</field>
        <field>Solicitante__c</field>
        <field>Gestor__c</field>
        <field>Motivo__c</field>
        <field>Quantidade__c</field>
        <field>Valor_Total_da_Solicitacao__c</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <assignedApprover>
            <approver>
                <type>userHierarchyField</type>
            </approver>
        </assignedApprover>
        <label>Qualificação do Gestor</label>
        <name>Qualificacao_do_Gestor</name>
    </approvalStep>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <assignedApprover>
            <approver>
                <name>grupooperacoes@somosagility.com.br</name>
                <type>user</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <label>Qualificação Operações</label>
        <name>Qualificacao_Operacoes</name>
        <rejectBehavior>
            <type>RejectRequest</type>
        </rejectBehavior>
    </approvalStep>
    <emailTemplate>Solicitacao_de_Material_de_Escritorio/Nova_Solicitacao_de_Material_de_Escritorio</emailTemplate>
    <enableMobileDeviceAccess>false</enableMobileDeviceAccess>
    <finalApprovalActions>
        <action>
            <name>Atualizar_Data_da_Aprova_o</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Atualizar_novamente_o_Estoque_Atual_da_S</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Aviso_sobre_Estoque</name>
            <type>Alert</type>
        </action>
        <action>
            <name>Solicitacao_de_Material_de_Escritorio_Aprovada</name>
            <type>Alert</type>
        </action>
        <action>
            <name>Status_da_Solicitacao_Aprovada</name>
            <type>FieldUpdate</type>
        </action>
    </finalApprovalActions>
    <finalApprovalRecordLock>true</finalApprovalRecordLock>
    <finalRejectionActions>
        <action>
            <name>Solicitacao_de_Material_de_Escritorio_Rejeitada</name>
            <type>Alert</type>
        </action>
        <action>
            <name>Status_da_Solicitacao_Rejeitada</name>
            <type>FieldUpdate</type>
        </action>
    </finalRejectionActions>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <initialSubmissionActions>
        <action>
            <name>Status_da_Solicita_o_Pendente</name>
            <type>FieldUpdate</type>
        </action>
    </initialSubmissionActions>
    <label>Qualificação da Sol. de Material</label>
    <nextAutomatedApprover>
        <useApproverFieldOfRecordOwner>false</useApproverFieldOfRecordOwner>
        <userHierarchyField>Manager</userHierarchyField>
    </nextAutomatedApprover>
    <processOrder>1</processOrder>
    <recordEditability>AdminOrCurrentApprover</recordEditability>
    <showApprovalHistory>true</showApprovalHistory>
</ApprovalProcess>
