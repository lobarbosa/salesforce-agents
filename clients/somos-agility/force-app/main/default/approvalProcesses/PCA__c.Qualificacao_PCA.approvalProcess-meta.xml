<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>false</active>
    <allowRecall>true</allowRecall>
    <allowedSubmitters>
        <type>owner</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>Gestor_GC__c</field>
        <field>Name</field>
        <field>Owner</field>
        <field>Quarter__c</field>
        <field>Ano__c</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <assignedApprover>
            <approver>
                <name>Gestor_GC__c</name>
                <type>relatedUserField</type>
            </approver>
            <approver>
                <name>claudio.endo@somosagility.com.br</name>
                <type>user</type>
            </approver>
            <approver>
                <name>cteixeira@somosagility.com.br</name>
                <type>user</type>
            </approver>
            <approver>
                <name>fabio.soto@somosagility.com.br</name>
                <type>user</type>
            </approver>
            <approver>
                <name>pedro.sugaya@agilitynetworks.com.br</name>
                <type>user</type>
            </approver>
            <whenMultipleApprovers>Unanimous</whenMultipleApprovers>
        </assignedApprover>
        <label>Qualificação do PCA</label>
        <name>Qualificacao_do_PCA</name>
    </approvalStep>
    <emailTemplate>PCA/Notificacao_de_Novo_PCA</emailTemplate>
    <enableMobileDeviceAccess>true</enableMobileDeviceAccess>
    <finalApprovalActions>
        <action>
            <name>Notificacao_de_Aprovacao_do_PCA</name>
            <type>Alert</type>
        </action>
        <action>
            <name>Status_PCA_Aprovado</name>
            <type>FieldUpdate</type>
        </action>
    </finalApprovalActions>
    <finalApprovalRecordLock>true</finalApprovalRecordLock>
    <finalRejectionActions>
        <action>
            <name>Notificacao_de_Rejeicao_do_PCA</name>
            <type>Alert</type>
        </action>
        <action>
            <name>Status_PCA_Rejeitado</name>
            <type>FieldUpdate</type>
        </action>
    </finalRejectionActions>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <initialSubmissionActions>
        <action>
            <name>Status_PCA_Pendente</name>
            <type>FieldUpdate</type>
        </action>
    </initialSubmissionActions>
    <label>Qualificação PCA</label>
    <nextAutomatedApprover>
        <useApproverFieldOfRecordOwner>false</useApproverFieldOfRecordOwner>
        <userHierarchyField>Manager</userHierarchyField>
    </nextAutomatedApprover>
    <processOrder>1</processOrder>
    <recallActions>
        <action>
            <name>Notificacao_de_Recall_do_PCA</name>
            <type>Alert</type>
        </action>
        <action>
            <name>Status_PCA_Recall</name>
            <type>FieldUpdate</type>
        </action>
    </recallActions>
    <recordEditability>AdminOrCurrentApprover</recordEditability>
    <showApprovalHistory>false</showApprovalHistory>
</ApprovalProcess>
