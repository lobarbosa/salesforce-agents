<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>true</active>
    <allowRecall>false</allowRecall>
    <allowedSubmitters>
        <type>owner</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>Name</field>
        <field>Owner</field>
        <field>Fornecedor__c</field>
        <field>DSA_de_origem__c</field>
        <field>Tipo_do_Produto__c</field>
        <field>Tipo_de_Credito__c</field>
        <field>Motivo_do_Credito__c</field>
        <field>Valor_do_Credito_Convertido_RS__c</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <assignedApprover>
            <approver>
                <name>grupofinanceiro@somosagility.com.br</name>
                <type>user</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <label>Solicitação de aprovação Dir. Fin</label>
        <name>Solicita_o_de_aprova_o_Dir_Fin</name>
    </approvalStep>
    <emailTemplate>Modelos_de_Email_Agility/Cr_dito_com_Fornecedores_Aprova_o</emailTemplate>
    <enableMobileDeviceAccess>true</enableMobileDeviceAccess>
    <entryCriteria>
        <criteriaItems>
            <field>Credito_com_Fornecedores__c.Valor_do_Credito_Convertido_RS__c</field>
            <operation>greaterThan</operation>
            <value>0</value>
        </criteriaItems>
    </entryCriteria>
    <finalApprovalActions>
        <action>
            <name>Cr_dito_com_Fornecedores_solicita_o_aprovada</name>
            <type>Alert</type>
        </action>
        <action>
            <name>Status_Aprovado</name>
            <type>FieldUpdate</type>
        </action>
    </finalApprovalActions>
    <finalApprovalRecordLock>true</finalApprovalRecordLock>
    <finalRejectionActions>
        <action>
            <name>Cr_dito_com_Fornecedores_solicita_o_rejeitada</name>
            <type>Alert</type>
        </action>
        <action>
            <name>Status_Rejeitado</name>
            <type>FieldUpdate</type>
        </action>
    </finalRejectionActions>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <initialSubmissionActions>
        <action>
            <name>Notifica_cria_o_de_CF</name>
            <type>Alert</type>
        </action>
    </initialSubmissionActions>
    <label>Crédito com Fornecedores Solicitação</label>
    <nextAutomatedApprover>
        <useApproverFieldOfRecordOwner>false</useApproverFieldOfRecordOwner>
        <userHierarchyField>Manager</userHierarchyField>
    </nextAutomatedApprover>
    <processOrder>1</processOrder>
    <recordEditability>AdminOrCurrentApprover</recordEditability>
    <showApprovalHistory>true</showApprovalHistory>
</ApprovalProcess>
