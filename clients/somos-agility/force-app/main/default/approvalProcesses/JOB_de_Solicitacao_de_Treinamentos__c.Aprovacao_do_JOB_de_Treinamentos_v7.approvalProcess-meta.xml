        <assignedApprover>
            <approver>
                <type>userHierarchyField</type>
            </approver>
        </assignedApprover>
        <entryCriteria>
            <booleanFilter>1 AND 2 AND 3</booleanFilter>
            <criteriaItems>
                <field>User.Manager</field>
                <operation>equals</operation>
                <value>Claudio Akira Endo</value>
            </criteriaItems>
            <criteriaItems>
                <field>User.Manager</field>
                <operation>equals</operation>
                <value>Walmor</value>
            </criteriaItems>
            <criteriaItems>
                <field>User.Manager</field>
                <operation>equals</operation>
                <value>Claudio</value>
            </criteriaItems>
        </entryCriteria>
        <ifCriteriaNotMet>GotoNextStep</ifCriteriaNotMet>
        <label>Qualificação Gerenciador</label>
        <name>QualificacaoGerenciador</name>
    </approvalStep>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <assignedApprover>
            <approver>
                <name>fabio.soto@somosagility.com.br</name>
                <type>user</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <label>Qualificação Diretoria Executiva</label>
        <name>Qualificacao_Diretoria_Executiva</name>
