    <emailTemplate>Job_de_Treinamentos/Solicitacao_de_JOB_de_Treinamento</emailTemplate>
    <enableMobileDeviceAccess>false</enableMobileDeviceAccess>
    <entryCriteria>
        <booleanFilter>1 OR 2</booleanFilter>
        <criteriaItems>
            <field>JOB_de_Solicitacao_de_Treinamentos__c.Tentativa__c</field>
            <operation>equals</operation>
            <value>1a. Tentativa,2a. Tentativa,3a. Tentativa ou acima</value>
        </criteriaItems>
        <criteriaItems>
            <field>JOB_de_Solicitacao_de_Treinamentos__c.Objetivo__c</field>
            <operation>equals</operation>
            <value>Treinamento</value>
        </criteriaItems>
    </entryCriteria>
