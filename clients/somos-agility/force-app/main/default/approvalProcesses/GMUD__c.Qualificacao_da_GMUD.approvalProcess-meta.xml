<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>true</active>
    <allowRecall>false</allowRecall>
    <allowedSubmitters>
        <type>owner</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>Name</field>
        <field>Owner</field>
        <field>Cliente__c</field>
        <field>Status__c</field>
        <field>Objetivo__c</field>
        <field>Data_Comite__c</field>
        <field>Inicio__c</field>
        <field>Fim__c</field>
        <field>Grau_de_Impacto__c</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <assignedApprover>
            <approver>
                <name>Gilberto_Nascimento_gmud</name>
                <type>queue</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <label>Qualificação Governança Agility</label>
        <name>Qualificacao_Governanca_Agility</name>
    </approvalStep>
    <emailTemplate>GMUD/Solicitacao_de_GMUD</emailTemplate>
    <enableMobileDeviceAccess>false</enableMobileDeviceAccess>
    <finalApprovalActions>
        <action>
            <name>Solicitacao_de_GMUD_Aprovada</name>
            <type>Alert</type>
        </action>
        <action>
            <name>Status_Aprovado</name>
            <type>FieldUpdate</type>
        </action>
    </finalApprovalActions>
    <finalApprovalRecordLock>true</finalApprovalRecordLock>
    <finalRejectionActions>
        <action>
            <name>Solicitacao_de_GMUD_Rejeitada</name>
            <type>Alert</type>
        </action>
        <action>
            <name>Status_Rejeitado</name>
            <type>FieldUpdate</type>
        </action>
    </finalRejectionActions>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <initialSubmissionActions>
        <action>
            <name>Status_Pendente</name>
            <type>FieldUpdate</type>
        </action>
    </initialSubmissionActions>
    <label>Qualificação da GMUD</label>
    <processOrder>1</processOrder>
    <recallActions>
        <action>
            <name>Solicitacao_de_GMUD_em_Recall</name>
            <type>Alert</type>
        </action>
        <action>
            <name>Status_Recall</name>
            <type>FieldUpdate</type>
        </action>
    </recallActions>
    <recordEditability>AdminOnly</recordEditability>
    <showApprovalHistory>true</showApprovalHistory>
</ApprovalProcess>
