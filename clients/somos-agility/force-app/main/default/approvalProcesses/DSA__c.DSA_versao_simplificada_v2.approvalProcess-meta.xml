<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>true</active>
    <allowRecall>false</allowRecall>
    <allowedSubmitters>
        <type>owner</type>
    </allowedSubmitters>
    <allowedSubmitters>
        <submitter>administrator@somosagility.com.br</submitter>
        <type>user</type>
    </allowedSubmitters>
    <allowedSubmitters>
        <submitter>sales.operations@somosagility.com.br</submitter>
        <type>user</type>
    </allowedSubmitters>
    <allowedSubmitters>
        <submitter>vanessa.ranieri@somosagility.com.br</submitter>
        <type>user</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>Name</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <approvalActions>
            <action>
                <name>Alerta_de_DSA_simplificado</name>
                <type>Alert</type>
            </action>
            <action>
                <name>Status_D_S_A_Aprovado</name>
                <type>FieldUpdate</type>
            </action>
        </approvalActions>
        <assignedApprover>
            <approver>
                <name>grupooperacoes@somosagility.com.br</name>
                <type>user</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <description>AM060818: Qualificação Operações</description>
        <label>Qualificação Operações</label>
        <name>Qualifica_o_Operacoes</name>
    </approvalStep>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <assignedApprover>
            <approver>
                <name>grupooperacoes@somosagility.com.br</name>
                <type>user</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <label>Qualificação Operações Final</label>
        <name>Qualifica_o_Opera_es_Final</name>
        <rejectBehavior>
            <type>RejectRequest</type>
        </rejectBehavior>
    </approvalStep>
    <emailTemplate>Modelos_de_Email_Agility/Alerta_de_novo_DSA</emailTemplate>
    <enableMobileDeviceAccess>false</enableMobileDeviceAccess>
    <entryCriteria>
        <criteriaItems>
            <field>DSA__c.Status_DSA__c</field>
            <operation>notEqual</operation>
            <value>Aprovado</value>
        </criteriaItems>
        <criteriaItems>
            <field>DSA__c.Status_DSA__c</field>
            <operation>notEqual</operation>
            <value>Finalizado</value>
        </criteriaItems>
        <criteriaItems>
            <field>User.Profile</field>
            <operation>notEqual</operation>
            <value>Gerente de Contas</value>
        </criteriaItems>
    </entryCriteria>
    <finalApprovalActions>
        <action>
            <name>Alerta_de_DSA_Finalizado</name>
            <type>Alert</type>
        </action>
        <action>
            <name>Status_DSA</name>
            <type>FieldUpdate</type>
        </action>
    </finalApprovalActions>
    <finalApprovalRecordLock>true</finalApprovalRecordLock>
    <finalRejectionActions>
        <action>
            <name>Alerta_de_DSA_simplificado</name>
            <type>Alert</type>
        </action>
        <action>
            <name>Status_DSA_Rejeitado</name>
            <type>FieldUpdate</type>
        </action>
    </finalRejectionActions>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <initialSubmissionActions>
        <action>
            <name>Alerta_de_DSA_Criado</name>
            <type>Alert</type>
        </action>
        <action>
            <name>Status_DSA_Pendente</name>
            <type>FieldUpdate</type>
        </action>
    </initialSubmissionActions>
    <label>DSA versão simplificada v2</label>
    <processOrder>1</processOrder>
    <recallActions>
        <action>
            <name>Alerta_de_DSA_simplificado</name>
            <type>Alert</type>
        </action>
        <action>
            <name>Status_DSA_Recall</name>
            <type>FieldUpdate</type>
        </action>
    </recallActions>
    <recordEditability>AdminOrCurrentApprover</recordEditability>
    <showApprovalHistory>true</showApprovalHistory>
</ApprovalProcess>
