<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>false</active>
    <allowRecall>true</allowRecall>
    <allowedSubmitters>
        <type>owner</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>Name</field>
        <field>Owner</field>
        <field>Account</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <assignedApprover>
            <approver>
                <type>userHierarchyField</type>
            </approver>
        </assignedApprover>
        <description>AM 21052018: aprovação do gestor imediato</description>
        <label>Qualificação Gestor</label>
        <name>Qualificacao_Gestor</name>
    </approvalStep>
    <description>AM 21052018: processo de aprovação de avanço da fase OEG para PSL</description>
    <emailTemplate>Oportunidades/OEG_Notificacao_de_aprovacao_de_qualificacao_de_fase</emailTemplate>
    <enableMobileDeviceAccess>true</enableMobileDeviceAccess>
    <entryCriteria>
        <criteriaItems>
            <field>Opportunity.StageName</field>
            <operation>equals</operation>
            <value>OEG</value>
        </criteriaItems>
    </entryCriteria>
    <finalApprovalActions>
        <action>
            <name>Notificacao_de_aprovacao_de_avan_o_da_fase_OEG_para_PSL</name>
            <type>Alert</type>
        </action>
        <action>
            <name>Status_qualificacao_de_fase_aprovado</name>
            <type>FieldUpdate</type>
        </action>
    </finalApprovalActions>
    <finalApprovalRecordLock>true</finalApprovalRecordLock>
    <finalRejectionActions>
        <action>
            <name>Notificacao_de_rejeicao_de_avan_o_da_fase_OEG_para_PSL</name>
            <type>Alert</type>
        </action>
        <action>
            <name>Status_qualificacao_de_fase_rejeitado</name>
            <type>FieldUpdate</type>
        </action>
    </finalRejectionActions>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <initialSubmissionActions>
        <action>
            <name>Alerta_de_solicitacao_de_aprova_o_de_avancao_da_fase_OEG_para_PSL</name>
            <type>Alert</type>
        </action>
        <action>
            <name>Status_qualificacao_de_fase_pendente</name>
            <type>FieldUpdate</type>
        </action>
    </initialSubmissionActions>
    <label>Z_OEG - qualificação de Fasee</label>
    <nextAutomatedApprover>
        <useApproverFieldOfRecordOwner>false</useApproverFieldOfRecordOwner>
        <userHierarchyField>Manager</userHierarchyField>
    </nextAutomatedApprover>
    <processOrder>1</processOrder>
    <recallActions>
        <action>
            <name>Notificacao_de_recall_de_avancao_da_fase_OEG_para_PSL</name>
            <type>Alert</type>
        </action>
        <action>
            <name>Status_qualificacao_de_fase_recall</name>
            <type>FieldUpdate</type>
        </action>
    </recallActions>
    <recordEditability>AdminOnly</recordEditability>
    <showApprovalHistory>false</showApprovalHistory>
</ApprovalProcess>
