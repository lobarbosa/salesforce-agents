<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>false</active>
    <allowRecall>true</allowRecall>
    <allowedSubmitters>
        <type>owner</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>Name</field>
        <field>Owner</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <approvalActions>
            <action>
                <name>Aprovacao_Gestor</name>
                <type>Alert</type>
            </action>
            <action>
                <name>Etapa_Gerente_Aprovando</name>
                <type>FieldUpdate</type>
            </action>
        </approvalActions>
        <assignedApprover>
            <approver>
                <type>userHierarchyField</type>
            </approver>
        </assignedApprover>
        <label>Qualificação Gerente</label>
        <name>Qualificacao_Gerente</name>
        <rejectionActions>
            <action>
                <name>Etapa_Gerente_Rejeitando</name>
                <type>FieldUpdate</type>
            </action>
        </rejectionActions>
    </approvalStep>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <approvalActions>
            <action>
                <name>Etapa_Financeiro_Aprovando</name>
                <type>FieldUpdate</type>
            </action>
        </approvalActions>
        <assignedApprover>
            <approver>
                <name>grupofinanceiro@somosagility.com.br</name>
                <type>user</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <label>Qualificação Financeiro</label>
        <name>Qualifica_o_Financeiro</name>
        <rejectBehavior>
            <type>RejectRequest</type>
        </rejectBehavior>
        <rejectionActions>
            <action>
                <name>Etapa_Financeiro_Rejeitando</name>
                <type>FieldUpdate</type>
            </action>
        </rejectionActions>
    </approvalStep>
    <emailTemplate>Reembolsos/Solicita_o_de_Novo_Reembolso</emailTemplate>
    <enableMobileDeviceAccess>false</enableMobileDeviceAccess>
    <finalApprovalActions>
        <action>
            <name>Aprovacao_de_Reembolso</name>
            <type>Alert</type>
        </action>
        <action>
            <name>Etapa_Aprovado</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Status_Aprovado</name>
            <type>FieldUpdate</type>
        </action>
    </finalApprovalActions>
    <finalApprovalRecordLock>true</finalApprovalRecordLock>
    <finalRejectionActions>
        <action>
            <name>Etapa_Rejeitado</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Rejeicao_do_Reembolso</name>
            <type>Alert</type>
        </action>
        <action>
            <name>Status_Rejeitado</name>
            <type>FieldUpdate</type>
        </action>
    </finalRejectionActions>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <initialSubmissionActions>
        <action>
            <name>Status_Etapa_Aprova_o_Reembolso_Gerente</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Status_Pendente</name>
            <type>FieldUpdate</type>
        </action>
    </initialSubmissionActions>
    <label>Solicitação de Novo Reembolso</label>
    <nextAutomatedApprover>
        <useApproverFieldOfRecordOwner>true</useApproverFieldOfRecordOwner>
        <userHierarchyField>Manager</userHierarchyField>
    </nextAutomatedApprover>
    <processOrder>1</processOrder>
    <recallActions>
        <action>
            <name>Etapa_Recall</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Solicitacao_de_Reembolso_Devolvida</name>
            <type>Alert</type>
        </action>
        <action>
            <name>Status_Recall</name>
            <type>FieldUpdate</type>
        </action>
    </recallActions>
    <recordEditability>AdminOrCurrentApprover</recordEditability>
    <showApprovalHistory>true</showApprovalHistory>
</ApprovalProcess>
