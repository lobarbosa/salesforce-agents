<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>true</active>
    <allowRecall>true</allowRecall>
    <allowedSubmitters>
        <type>owner</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>Gestor_GC__c</field>
        <field>Owner</field>
        <field>Name</field>
        <field>Ano__c</field>
        <field>Quarter__c</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <assignedApprover>
            <approver>
                <type>userHierarchyField</type>
            </approver>
        </assignedApprover>
        <label>Envia Gestor Direto</label>
        <name>Envia_Gestor_Direto</name>
        <rejectionActions>
            <action>
                <name>Atualiza_PCA</name>
                <type>FieldUpdate</type>
            </action>
        </rejectionActions>
    </approvalStep>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <assignedApprover>
            <approver>
                <name>claudio.endo@somosagility.com.br</name>
                <type>user</type>
            </approver>
            <approver>
                <name>cteixeira@somosagility.com.br</name>
                <type>user</type>
            </approver>
            <approver>
                <name>fabio.soto@somosagility.com.br</name>
                <type>user</type>
            </approver>
            <whenMultipleApprovers>Unanimous</whenMultipleApprovers>
        </assignedApprover>
        <label>Envia Segundo Nível</label>
        <name>Envia_Segundo_Nivel</name>
        <rejectBehavior>
            <type>RejectRequest</type>
        </rejectBehavior>
    </approvalStep>
    <description>FO 28/12/17: Envia o registro de aprovação do PCA primeiro ao gestor direto e depois ao segundo nível de aprovação. Caso o registro seja rejeitado por qualquer um dos envolvidos, o registro deverá ser revisado.</description>
    <emailTemplate>Modelos_de_Email_Agility/PCA</emailTemplate>
    <enableMobileDeviceAccess>true</enableMobileDeviceAccess>
    <finalApprovalActions>
        <action>
            <name>Atualiza_PCA_Aprovada</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Notifica_o_de_Aprova_o_do_PCA</name>
            <type>Alert</type>
        </action>
    </finalApprovalActions>
    <finalApprovalRecordLock>false</finalApprovalRecordLock>
    <finalRejectionActions>
        <action>
            <name>Atualiza_PCA_Rejeitada</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Notifica_o_de_Rejei_o_do_PCA</name>
            <type>Alert</type>
        </action>
    </finalRejectionActions>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <initialSubmissionActions>
        <action>
            <name>Status_PCA_Pendente2</name>
            <type>FieldUpdate</type>
        </action>
    </initialSubmissionActions>
    <label>Aprovação Continuada PCA</label>
    <nextAutomatedApprover>
        <useApproverFieldOfRecordOwner>false</useApproverFieldOfRecordOwner>
        <userHierarchyField>Manager</userHierarchyField>
    </nextAutomatedApprover>
    <processOrder>1</processOrder>
    <recordEditability>AdminOrCurrentApprover</recordEditability>
    <showApprovalHistory>true</showApprovalHistory>
</ApprovalProcess>
