<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>true</active>
    <allowRecall>false</allowRecall>
    <allowedSubmitters>
        <type>owner</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>Name</field>
        <field>Owner</field>
        <field>Solicitante__c</field>
        <field>Tipo_de_Solicitacao__c</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <approvalActions>
            <action>
                <name>Emissao_Passagem_Aerea</name>
                <type>Alert</type>
            </action>
            <action>
                <name>Emissao_Realizada_e_Pendente_Financeiro</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>Qualificacao_Gestor_Aprovada</name>
                <type>FieldUpdate</type>
            </action>
        </approvalActions>
        <assignedApprover>
            <approver>
                <type>userHierarchyField</type>
            </approver>
        </assignedApprover>
        <entryCriteria>
            <criteriaItems>
                <field>Solicitacao_de_Passagem_Aerea__c.Status__c</field>
                <operation>equals</operation>
                <value>Cotação/Reserva Solicitada,Devolvida,Reserva Efetuada e Pendente Gestor</value>
            </criteriaItems>
        </entryCriteria>
        <ifCriteriaNotMet>GotoNextStep</ifCriteriaNotMet>
        <label>Qualificação Gestor</label>
        <name>Qualificacao_Gestor</name>
        <rejectionActions>
            <action>
                <name>Qualifica_o_Gestor_Rejeitado</name>
                <type>FieldUpdate</type>
            </action>
        </rejectionActions>
    </approvalStep>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <assignedApprover>
            <approver>
                <name>grupofinanceiro@somosagility.com.br</name>
                <type>user</type>
            </approver>
            <whenMultipleApprovers>Unanimous</whenMultipleApprovers>
        </assignedApprover>
        <label>Qualificação Financeiro</label>
        <name>Qualificacao_Financeiro</name>
        <rejectBehavior>
            <type>RejectRequest</type>
        </rejectBehavior>
        <rejectionActions>
            <action>
                <name>Rejeitada</name>
                <type>FieldUpdate</type>
            </action>
        </rejectionActions>
    </approvalStep>
    <emailTemplate>Passagem_Aerea/Solicitacao_de_Qualificacao_de_Passagem_Aerea</emailTemplate>
    <enableMobileDeviceAccess>true</enableMobileDeviceAccess>
    <entryCriteria>
        <booleanFilter>1</booleanFilter>
        <criteriaItems>
            <field>Solicitacao_de_Passagem_Aerea__c.Status__c</field>
            <operation>equals</operation>
            <value>Cotação/Reserva Solicitada,Rejeitada,Pendente Gestor,Devolvida,Reserva Efetuada e Pendente Gestor</value>
        </criteriaItems>
    </entryCriteria>
    <finalApprovalActions>
        <action>
            <name>Aprovacao_Passagem_Aerea</name>
            <type>Alert</type>
        </action>
        <action>
            <name>Aprovado</name>
            <type>FieldUpdate</type>
        </action>
    </finalApprovalActions>
    <finalApprovalRecordLock>true</finalApprovalRecordLock>
    <finalRejectionActions>
        <action>
            <name>Rejeicao_Passagem_Aerea</name>
            <type>Alert</type>
        </action>
        <action>
            <name>Rejeitada</name>
            <type>FieldUpdate</type>
        </action>
    </finalRejectionActions>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <initialSubmissionActions>
        <action>
            <name>Reserva_Solicitada_e_Pendente_Gestor</name>
            <type>FieldUpdate</type>
        </action>
    </initialSubmissionActions>
    <label>Qualificação Passagem Aérea</label>
    <nextAutomatedApprover>
        <useApproverFieldOfRecordOwner>false</useApproverFieldOfRecordOwner>
        <userHierarchyField>Manager</userHierarchyField>
    </nextAutomatedApprover>
    <processOrder>1</processOrder>
    <recallActions>
        <action>
            <name>Recall</name>
            <type>FieldUpdate</type>
        </action>
    </recallActions>
    <recordEditability>AdminOrCurrentApprover</recordEditability>
    <showApprovalHistory>true</showApprovalHistory>
</ApprovalProcess>
