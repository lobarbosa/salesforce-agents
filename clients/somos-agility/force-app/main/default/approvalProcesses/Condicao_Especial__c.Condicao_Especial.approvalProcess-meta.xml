<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>true</active>
    <allowRecall>false</allowRecall>
    <allowedSubmitters>
        <type>owner</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>Name</field>
        <field>Owner</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <assignedApprover>
            <approver>
                <name>pmo@somosagility.com.br</name>
                <type>user</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <description>AM050818: Operações qualifica</description>
        <label>Qualificação Grupo Operações</label>
        <name>Qualificacao_Grupo_Operacoes</name>
    </approvalStep>
    <emailTemplate>Condicoes_Especiais/Notificacao_de_Nova_Solicitacao_de_Condicao_Especial</emailTemplate>
    <enableMobileDeviceAccess>false</enableMobileDeviceAccess>
    <entryCriteria>
        <criteriaItems>
            <field>Condicao_Especial__c.CreatedBy</field>
            <operation>notEqual</operation>
        </criteriaItems>
        <criteriaItems>
            <field>Condicao_Especial__c.Status__c</field>
            <operation>notEqual</operation>
            <value>Aprovado</value>
        </criteriaItems>
    </entryCriteria>
    <finalApprovalActions>
        <action>
            <name>Alerta_de_Solicitacao_de_Condicao_Especial_Aprovada</name>
            <type>Alert</type>
        </action>
        <action>
            <name>Status_aprovado</name>
            <type>FieldUpdate</type>
        </action>
    </finalApprovalActions>
    <finalApprovalRecordLock>true</finalApprovalRecordLock>
    <finalRejectionActions>
        <action>
            <name>Alerta_de_Solicitacao_de_Condicao_Especial_Rejeitada</name>
            <type>Alert</type>
        </action>
        <action>
            <name>Status_rejeitado</name>
            <type>FieldUpdate</type>
        </action>
    </finalRejectionActions>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <initialSubmissionActions>
        <action>
            <name>Status_pendente</name>
            <type>FieldUpdate</type>
        </action>
    </initialSubmissionActions>
    <label>Condição Especial</label>
    <processOrder>1</processOrder>
    <recallActions>
        <action>
            <name>Status_recall</name>
            <type>FieldUpdate</type>
        </action>
    </recallActions>
    <recordEditability>AdminOrCurrentApprover</recordEditability>
    <showApprovalHistory>true</showApprovalHistory>
</ApprovalProcess>
