<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>true</active>
    <allowRecall>false</allowRecall>
    <allowedSubmitters>
        <type>owner</type>
    </allowedSubmitters>
    <allowedSubmitters>
        <submitter>administrator@somosagility.com.br</submitter>
        <type>user</type>
    </allowedSubmitters>
    <allowedSubmitters>
        <submitter>grupogp@somosagility.com.br</submitter>
        <type>user</type>
    </allowedSubmitters>
    <allowedSubmitters>
        <submitter>pmo@somosagility.com.br</submitter>
        <type>user</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>Name</field>
        <field>Conta__c</field>
        <field>ID_do_Projeto__c</field>
        <field>Nome_do_Projeto__c</field>
        <field>Projeto_Relacionado__c</field>
        <field>Gerente_do_Projeto__c</field>
        <field>Owner</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <assignedApprover>
            <approver>
                <name>wanderley.gadioli@somosagility.com.br</name>
                <type>user</type>
            </approver>
            <whenMultipleApprovers>Unanimous</whenMultipleApprovers>
        </assignedApprover>
        <label>Aprovação - Gerente de Entregas e Serviços</label>
        <name>Step_1</name>
    </approvalStep>
    <emailTemplate>Licoes_Aprendidas/Notificacao_de_Nova_Solicitacao_de_Aprovacao_DLA</emailTemplate>
    <enableMobileDeviceAccess>false</enableMobileDeviceAccess>
    <entryCriteria>
        <criteriaItems>
            <field>Documento_de_Licoes_Aprendidas__c.X1_Fase_do_Projeto__c</field>
            <operation>notEqual</operation>
        </criteriaItems>
        <criteriaItems>
            <field>Documento_de_Licoes_Aprendidas__c.X1_Impacto_Gerado__c</field>
            <operation>notEqual</operation>
        </criteriaItems>
        <criteriaItems>
            <field>Documento_de_Licoes_Aprendidas__c.X1_Licao_Aprendida__c</field>
            <operation>notEqual</operation>
        </criteriaItems>
        <criteriaItems>
            <field>Documento_de_Licoes_Aprendidas__c.X1_Problema_Ocorrido__c</field>
            <operation>notEqual</operation>
        </criteriaItems>
        <criteriaItems>
            <field>Documento_de_Licoes_Aprendidas__c.Status_de_Aprovacao__c</field>
            <operation>notEqual</operation>
            <value>Aprovado</value>
        </criteriaItems>
    </entryCriteria>
    <finalApprovalActions>
        <action>
            <name>Alerta_para_DLA_Aprovado</name>
            <type>Alert</type>
        </action>
        <action>
            <name>Atualiza_Status_Aprovado</name>
            <type>FieldUpdate</type>
        </action>
    </finalApprovalActions>
    <finalApprovalRecordLock>true</finalApprovalRecordLock>
    <finalRejectionActions>
        <action>
            <name>Alerta_para_DLA_Rejeitado</name>
            <type>Alert</type>
        </action>
        <action>
            <name>Atualiza_Status_Rejeitado</name>
            <type>FieldUpdate</type>
        </action>
    </finalRejectionActions>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <initialSubmissionActions>
        <action>
            <name>Atualiza_Status_em_Analise</name>
            <type>FieldUpdate</type>
        </action>
    </initialSubmissionActions>
    <label>Aprovação de DLA&apos;s para Revisão</label>
    <processOrder>1</processOrder>
    <recordEditability>AdminOnly</recordEditability>
    <showApprovalHistory>true</showApprovalHistory>
</ApprovalProcess>
