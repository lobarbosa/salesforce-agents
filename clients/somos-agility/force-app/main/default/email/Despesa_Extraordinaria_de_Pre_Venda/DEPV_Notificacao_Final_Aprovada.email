<![CDATA[<div style="font-family: arial; font-size: 12pt; color: rgb(0, 0, 0);">Olá, <b>{!Despesa_Extraordinaria_para_Pre_Venda__c.CreatedBy}</b>,</div><div style="font-family: arial; font-size: 12pt; color: rgb(0, 0, 0);">&nbsp;</div><div style="font-family: arial; font-size: 12pt; color: rgb(0, 0, 0);">Sua solicitação de Despesa Extraordinária de Venda foi <b>Aprovada!</b></div><div style="font-family: arial; font-size: 12pt; color: rgb(0, 0, 0);">&nbsp;</div><div style="font-family: arial; font-size: 12pt; color: rgb(0, 0, 0);"><font face="arial"><b>Comentários: </b>{!ApprovalRequest.Comments}</font></div><div style="font-family: arial; font-size: 12pt; color: rgb(0, 0, 0);">&nbsp;</div><div style="font-family: arial; font-size: 12pt; color: rgb(0, 0, 0);">Para maiores informações acesse o link abaixo:</div><div style="font-family: arial; font-size: 12pt; color: rgb(0, 0, 0);"><font face="arial" color="#000099"><b>{!Despesa_Extraordinaria_para_Pre_Venda__c.Link}</b></font></div><div style="font-family: arial; font-size: 12pt; color: rgb(0, 0, 0);">&nbsp;</div><div style="font-family: arial; font-size: 12pt; color: rgb(0, 0, 0);"><font face="arial">Atenciosamente,</font></div><div style="font-family: arial; font-size: 12pt; color: rgb(0, 0, 0);"><font face="arial">Equipe Agility</font></div>]]></td>
