<aura:component Controller="Opportunity" implements="force:appHostable,flexipage:availableForAllPageTypes,flexipage:availableForRecordHome,force:hasRecordId,forceCommunity:availableForAllPageTypes,force:lightningQuickAction" access="global" >
    <aura:attribute name="showFlow" type="boolean" default="true" />
    <aura:attribute name="waitMap" type="boolean" default="true" />
    <aura:attribute name="waitPSL" type="boolean" default="true" />
    <aura:attribute name="expiredMap" type="boolean" default="true" />
    <aura:attribute name="opp" type="Opportunity" />
    <force:recordData aura:id="opp"
                      layoutType="FULL"
                      recordId="{!v.recordId}"
                      targetFields="{!v.opp}"
                      mode="VIEW"/>
    <aura:handler name="render" value="{!this}" action="{!c.init}" />
    <lightning:path aura:id="path" variant="linear" hideUpdateButton="true" recordId="{!v.opp.Id}" />
    <aura:if isTrue="{!v.waitMap}">
        <br/><br/><p><b>Mapeamento(s) em análise.</b></p>
        <p>Existe(m) Mapeamento(s) em análise. Para verificar os Status, por gentileza selecionar um dos Mapeamentos ao lado.</p>
    </aura:if>
    <aura:if isTrue="{!v.waitPSL}">
        <br/><br/><p><b>Aguardando Proposta Comercial. </b></p>
        <p>Por gentileza, aguarde a finalização da Proposta de Solução para iniciar a fase de Fechamento com o cliente. </p>
    </aura:if>
    <aura:if isTrue="{!v.opp.HaMapVenc__c}">
        <br/><br/><p style="color:red;"><b>Mapeamento vencido!</b></p>
        <p>Por gentileza solicitar renovação. Para isso, basta abrir o Mapeamento vencido ao lado e selecionar a opção Solicitar Renovação. </p>
    </aura:if>
    <aura:if isTrue="{!v.showFlow}">
    	<lightning:flow aura:id="flowData" onstatuschange="{!c.changeStage}"/>
    </aura:if>
</aura:component>