                                <apex:param name="Idex" value="{!Idex + child.id}" />
                                </apex:commandButton>
                               <!--<apex:outputLink value="/apex/CadContratoSuportexPedido?id={!child.Negociacao_Comercial__c}&idProduto={!child.id}&Excluir=1">Excluir</apex:outputLink>-->
