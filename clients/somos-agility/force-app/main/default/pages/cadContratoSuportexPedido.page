    <!--CSS do PrimeUI-->
    <apex:stylesheet value="{!URLFOR($Resource.PrimeUI, '/development/primeui-0.9.6.css')}" />
    <!--CSS do JqueryUI-->
    <apex:stylesheet value="{!URLFOR($Resource.JqueryUI, '/themes/base/jquery-ui.css')}" />
    <!---------------------->
    <apex:stylesheet value="{!URLFOR($Resource.PrimeUI, '/themes/overcast/theme.css')}" />
    <apex:stylesheet value="{!URLFOR($Resource.PrimeUI, '/development/css/tabview/tabview.css')}" />
    <!---------------------->
    <script type="text/javascript">
          $(document).ready(function(){        
           $('#default').puitabview(); 
           
           $('#img_help_prazo_dur').puitooltip({  
            showEvent: 'mouseover',  
            at: 'left bottom',  
            content: 'Favor preencher na pesquisa apenas com número, escolhendo a opção Todos os Campos'});
            
             $('#img_help_tp_fat').puitooltip({  
            showEvent: 'mouseover',  
            at: 'left bottom',  
            content: 'Favor preencher na pesquisa com *mensal*, escolhendo a opção Todos os Campos'}); 
            
           }); 
    </script>
    <style>
