                                    </apex:form>
                                </div>
                            </td>
                        </tr>
                        <tr>
                            <td>
                                <div id="dv_produto" style="display: {!mostrarAdendo};">
                                <apex:pageBlockSection title="Produto"  id="pgProduto" columns="1" >
                                    <apex:form id="frmProduto">
                                        <table width="100%">
