                                                <td colspan="4"><apex:inputfield id="txtProduto" required="true"
                                                        value="{!Contrato_Suporte__c.Produto_1__c}" onchange="RetornaDesc(document.getElementById('CadContratoSuportexPedido:pgMaster:pgProduto:frmProduto:txtProduto_lkid').value);"/></td>
                                            </tr>
                                            <tr>
