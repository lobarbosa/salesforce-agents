    <script tyle="text/javascript">
    
    
     if(document.getElementById('idConfigfirst').value==''){
            document.getElementById('CadContratoSuportexPedido:pgMaster:frmPost:ddlOrigemFat').value='0015000000uacjU';
        }
        else{
            document.getElementById('CadContratoSuportexPedido:pgMaster:frmPost:ddlOrigemFat').value=document.getElementById('idConfigfirst').value;
        }
    
    function inativaCambio(vlr,tipo){
            if(tipo=='Produto'){
                if(vlr=='Real'){
                    document.getElementById('CadContratoSuportexPedido:pgMaster:pgProduto:frmProduto:txtCotacaoProduto').value=0;
                    document.getElementById('CadContratoSuportexPedido:pgMaster:pgProduto:frmProduto:txtCotacaoProduto').readOnly=true;
                }
                else{
                    if(document.getElementById('CadContratoSuportexPedido:pgMaster:pgProduto:frmProduto:txtCotacaoProduto').value==0){
                        document.getElementById('CadContratoSuportexPedido:pgMaster:pgProduto:frmProduto:txtCotacaoProduto').value='';
                    }
                    document.getElementById('CadContratoSuportexPedido:pgMaster:pgProduto:frmProduto:txtCotacaoProduto').readOnly=false;
                }
            }
            else if(tipo=='Mao') {
                if(vlr=='Real'){
                    document.getElementById('CadContratoSuportexPedido:pgMaster:pgRecurso:frmRecurso:txtCotacaoMaodeObra1').value=0;
                    document.getElementById('CadContratoSuportexPedido:pgMaster:pgRecurso:frmRecurso:txtCotacaoMaodeObra1').readOnly=true;
                }
                else{
                    //document.getElementById('CadContratoSuportexPedido:pgMaster:pgRecurso:frmRecurso:txtCotacaoMaodeObra1').value=0;
                     if(document.getElementById('CadContratoSuportexPedido:pgMaster:pgRecurso:frmRecurso:txtCotacaoMaodeObra1').value==0){
                        document.getElementById('CadContratoSuportexPedido:pgMaster:pgRecurso:frmRecurso:txtCotacaoMaodeObra1').value='';
                    }
                    document.getElementById('CadContratoSuportexPedido:pgMaster:pgRecurso:frmRecurso:txtCotacaoMaodeObra1').readOnly=false;
                }
            }
        
    }
    inativaCambio(document.getElementById('CadContratoSuportexPedido:pgMaster:pgProduto:frmProduto:txtMoedaProduto').value,'Produto');
    inativaCambio(document.getElementById('CadContratoSuportexPedido:pgMaster:pgRecurso:frmRecurso:txtMoeMaodeObra').value,'Mao');  
