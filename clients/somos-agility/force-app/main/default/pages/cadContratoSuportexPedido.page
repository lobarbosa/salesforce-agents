                                            <!--Aqui começa  o Recurso--->
                                            <tr
                                                class="pbSubheader brandTertiaryBgr first tertiaryPalette">
                                                <td colspan="4">&nbsp;&nbsp;&nbsp;<apex:inputField id="txtNegociacaoComercialRec"
                                                        value="{!Contrato_Suporte__c.Negociacao_Comercial__c}"
