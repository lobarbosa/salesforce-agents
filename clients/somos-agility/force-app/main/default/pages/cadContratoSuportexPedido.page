                               &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                               <apex:outputLink value="/apex/CadContratoSuportexPedido?id={!child.Contrato_Suporte__c}&idRecurso={!child.id}&Editar=1&Redict=0&idNegociacao={!idNegociacao}" target="_self">
                               <input type="button" id="btnEditar" value="Editar" class="btn" style="display:{!mBotao}"/>
                               </apex:outputLink>
                            </apex:column>
                            <apex:column headervalue="Nome Recurso">
                                {!child.Produto__r.Name}
                            </apex:column>
                            <apex:column value="{!child.Valor_do_recurso__c}" />
                            <apex:column value="{!child.Moeda__c}" />
                            <apex:column value="{!child.Cambio__c}" />
                        </apex:pageBlockTable>  
                        <!--Resumo total dos Recursos-->
