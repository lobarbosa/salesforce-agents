                                                        size="1" onchange="inativaCambio(this.value,'Mao')">
                                                        <apex:selectOptions value="{!MoedaCont}"></apex:selectOptions>
                                                    </apex:selectList>
                                                
                                                <!--<apex:inputfield id="txtMoeMaodeObra"
                                                        required="true"
                                                        value="{!Contrato_Suporte__c.Moeda_1_Mao_de_Obra__c}" onchange="inativaCambio(this.value,'Mao')"/>-->
                                                </td>
                                                <td>Cambio</td>
                                                <td colspan="4"><apex:inputfield id="txtCotacaoMaodeObra1" required="true"
                                                        value="{!Contrato_Suporte__c.Cotacao_do_Dolar_1_Mao_de_Obra__c}" onkeypress="mascara(this,moeda2Casas)"/>
