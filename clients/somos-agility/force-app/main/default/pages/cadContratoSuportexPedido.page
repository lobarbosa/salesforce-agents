<apex:page StandardController="Contrato_Suporte__c" showHeader="false"
    tabStyle="Contrato_Suporte__c"
    extensions="clsCadContratoSuportexPedido" id="CadContratoSuportexPedido">
    <!--Bibliotecas Jquery-->
    <apex:includeScript value="{!URLFOR($Resource.Jquery, 'jquery-1.9.1.js')}" />
    <apex:includeScript value="{!URLFOR($Resource.JqueryUI, '/ui/jquery-ui.js')}" />
    <!--Bibliotecas PrimeUI-->
    <apex:includeScript value="{!URLFOR($Resource.PrimeUI, '/development/primeui-0.9.6.js')}" />
    <!---------------------->
     <!--Bibliotecas de Formatações-->
    <apex:includeScript value="{!URLFOR($Resource.JqueryFormat, 'JqueryFormat.js')}" />
