        function AbreNovaNegociacao(){
            if(document.getElementById('frmNegociacaoComercial').style.display=='none'){
                var idP ="";
                document.getElementById('frmNegociacaoComercial').style.display='block';
                document.getElementById('frmNegociacaoComercial').style.width='1355px';
                document.getElementById('frmNegociacaoComercial').style.height='2050px';
                document.getElementById('frmNegociacaoComercial').iframeborder='0';
                if(idP!=null && idP!= ""){
                    window.open('https://cs13.salesforce.com/apex/CadNegociacaoComercial?id=' + idP + 
                                '&idProduto=' + document.getElementById('idProduto').value,'frmNegociacaoComercial');
                }
                else{
                    window.open('https://cs13.salesforce.com/apex/CadNegociacaoComercial?id=a0pW0000000NP3g','frmNegociacaoComercial');
                }
                
            }
            else{
                window.open('','frmNegociacaoComercial');
                document.getElementById('frmNegociacaoComercial').style.display='none';
                
            }
        }
        AbreNovaNegociacao();
    </script>
</apex:page>