                                        result = result.replace("{B}", "<br/>");
                                        //alert('Gravação realizada com sucesso');
                                        //window.location.reload(true);
                                        //alert(result);

                                        document
                                                .getElementById("txtFornecedor").innerHTML = result;
                                    }

                                }
                            });
        }

        //Funções de preenchimento automatico:
        function RetornaDescDest(idCNPJ) {
            //alert(idProd);
            Visualforce.remoting.Manager
                    .invokeAction(
                            '{!$RemoteAction.clsCadProdutoxPedido.RetornaCNPJDest}',
                            idCNPJ,
                            function(result, event) {
                                if (event.status) {
                                    if (result != '') {
                                        result = result.replace("{B}", "<br/>");
                                        result = result.replace("{B}", "<br/>");
                                        result = result.replace("{B}", "<br/>");
                                        result = result.replace("{B}", "<br/>");
                                        result = result.replace("{B}", "<br/>");
                                        result = result.replace("{B}", "<br/>");
                                        result = result.replace("{B}", "<br/>");
                                        result = result.replace("{B}", "<br/>");
                                        result = result.replace("{B}", "<br/>");
                                        result = result.replace("{B}", "<br/>");
                                        result = result.replace("{B}", "<br/>");
                                        result = result.replace("{B}", "<br/>");
                                        //alert('Gravação realizada com sucesso');
                                        //window.location.reload(true);
                                        //alert(result);

                                        document.getElementById("txtCNPJDest").innerHTML = result;
                                    }

                                }
                            });
        }

        RetornaDesc(document
