    <script style="text/javascript">
    
        

       

        if (document
                .getElementById('cadProdutoxPedido:frmPost:pgMaster:txtMoeda').value != 'Real'
                && document
                        .getElementById('cadProdutoxPedido:frmPost:pgMaster:txtMoeda').value != 'Dolar') {
            document
                    .getElementById('cadProdutoxPedido:frmPost:pgMaster:txtMoeda').value = 'Real';
        }

        if (document.getElementById('idConfigfirst').value == '') {
            document
                    .getElementById('cadProdutoxPedido:frmPost:pgMaster:ddlOrigemFat').value = '0015000000OZGSRAA5';
        } 
        
        function validarFRM(frm){
            var msg='';
            
            if(document.getElementById('cadProdutoxPedido:frmPost:pgMaster:txtCotacaoCompra').value=='0' && document.getElementById('cadProdutoxPedido:frmPost:pgMaster:txtMoedaCompra').value=='Dolar'){
                msg+='Por favor preencher o valor em dolar maior que 0\n';
            }
            
            if(document.getElementById('cadProdutoxPedido:frmPost:pgMaster:txtCotacao').value=='0' && document.getElementById('cadProdutoxPedido:frmPost:pgMaster:txtMoeda').value=='Dolar'){
                msg+='Por favor preencher o valor em dolar maior que 0\n';
            }
            if(msg!=''){
                alert(msg);
                return false;
            }
            else{
                return true;
            }
        }
        
        function inativaCambio(vlr, tipo) {
        var cambio=document.getElementById('CambioGlobal').value;
        var Rcambio=cambio.replace('.',',');
            if (tipo == 'Compra') {
                if (vlr == 'Real') {
                    document
                            .getElementById('cadProdutoxPedido:frmPost:pgMaster:txtCotacaoCompra').value = 0;
                    document
                            .getElementById('cadProdutoxPedido:frmPost:pgMaster:txtCotacaoCompra').readOnly = true;
                } else {
                    document.getElementById('cadProdutoxPedido:frmPost:pgMaster:txtCotacaoCompra').value = Rcambio;
                    document
                            .getElementById('cadProdutoxPedido:frmPost:pgMaster:txtCotacaoCompra').readOnly = false;
                }
            } else if (tipo == 'Venda') {
                if (vlr == 'Real') {
                    document
                            .getElementById('cadProdutoxPedido:frmPost:pgMaster:txtCotacao').value = 0;
                    document
                            .getElementById('cadProdutoxPedido:frmPost:pgMaster:txtCotacao').readOnly = true;
                } else {
                   document.getElementById('cadProdutoxPedido:frmPost:pgMaster:txtCotacao').value = Rcambio;
                    document
                            .getElementById('cadProdutoxPedido:frmPost:pgMaster:txtCotacao').readOnly = false;
                }

            }
        }
        inativaCambio(
                document
                        .getElementById('cadProdutoxPedido:frmPost:pgMaster:txtMoedaCompra').value,
                'Compra');
        inativaCambio(
                document
                        .getElementById('cadProdutoxPedido:frmPost:pgMaster:txtMoeda').value,
                'Venda');
        if (document.getElementById('ReadOnly').value == 'true') {
            //Irá bloquear todos os campos para edição
            itens = document.getElementsByTagName('input');
            for (i = 0; i < itens.length; i++) {
                itens[i].setAttribute('disabled', 'true');
            }
            itensList = document.getElementsByTagName('select');
            for (i = 0; i < itensList.length; i++) {
                itensList[i].setAttribute('disabled', 'true');
            }
        }
        var Habilitar = 1;
        if (document.getElementById('idProduto').value != ''
                && document.getElementById('Redict').value == '1') {
            window.open(
                    'https://na3.salesforce.com/apex/cadNegociacaoComercial?id='
                            + document.getElementById('idNegociacao').value
                            + '&idProduto='
                            + document.getElementById('idProduto').value
                            + '&Redict=1', '_top');
            Habilitar = 0;
        } else if (document.getElementById('Redict').value == '2') {
            window.open(
                    'https://na3.salesforce.com/apex/cadNegociacaoComercial?id='
                            + document.getElementById('idNegociacao').value
                            + '&idProduto=', '_top');
            Habilitar = 0;
        }
        if (Habilitar == 1) {
            document.getElementById('default').style.display = 'block';
        }
            
        //Funções de preenchimento automatico:
        function RetornaDesc(idProd) {
            //alert(idProd);
            Visualforce.remoting.Manager
                    .invokeAction(
                            '{!$RemoteAction.clsCadProdutoxPedido.RetornaDescricao}',
                            idProd,
                            function(result, event) {
                                if (event.status) {
                                    if (result != '') {
                                        result = result.replace("{B}", "<br/>");
                                        result = result.replace("{B}", "<br/>");
                                        result = result.replace("{B}", "<br/>");
                                        result = result.replace("{B}", "<br/>");
                                        result = result.replace("{B}", "<br/>");
                                        result = result.replace("{B}", "<br/>");
                                        result = result.replace("{B}", "<br/>");
                                        result = result.replace("{B}", "<br/>");
                                        result = result.replace("{B}", "<br/>");
                                        result = result.replace("{B}", "<br/>");
                                        result = result.replace("{B}", "<br/>");
                                        result = result.replace("{B}", "<br/>");
                                        //alert('Gravação realizada com sucesso');
                                        //window.location.reload(true);
                                        //alert(result);

                                        document
                                                .getElementById("cadProdutoxPedido:frmPost:pgMaster:txtDescricaoProduto").innerHTML = result;
                                    }

                                }
                            });
        }
        //Funções de preenchimento automatico:
        function RetornaValorTot(vlrUnit, qtdProd) {
            //alert(idProd);
            Visualforce.remoting.Manager
                    .invokeAction(
                            '{!$RemoteAction.clsCadProdutoxPedido.RetornaValor}',
                            vlrUnit,
                            qtdProd,
                            function(result, event) {
                                if (event.status) {
                                    if (result != '') {
                                        document
                                                .getElementById("txtValorTotal").innerHTML = result;
                                    }

                                }
                            });
        }

        //Funções de preenchimento automatico:
        function RetornaDescForn(idForn) {
            //alert(idProd);
            Visualforce.remoting.Manager
                    .invokeAction(
                            '{!$RemoteAction.clsCadProdutoxPedido.RetornaFornecedor}',
