                                                class="pbSubheader brandTertiaryBgr first tertiaryPalette">
                                                <td colspan="4">&nbsp;&nbsp;&nbsp;Informações de compra</td>
                                            </tr>
                                            
                                            <tr id="tr_Produto_1">
                                                <td>Fornecedor</td>
                                                <td><apex:inputfield id="txtFornecedorCompra" required="true"
                                                        value="{!Locacao_x_Pedido__c.Fornecedor__c}" onchange="RetornaDescForn(document.getElementById('cadLocacaoxPedido:pgMaster:pgProduto:frmProduto:txtFornecedorCompra_lkid').value);"/>
                                                        <br/>
                                                        <label id="txtFornecedor"></label>
