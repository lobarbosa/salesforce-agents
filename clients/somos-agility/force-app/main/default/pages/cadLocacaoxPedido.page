                                                <img   class="helpOrb2" id="img_help_CodFCompra" title="" src="/s.gif" ></img>
                                                </td>
                                                <td><apex:inputField id="txtCategoriaCompra"
                                                        required="true"
                                                        value="{!Locacao_x_Pedido__c.Categoria_de_Compra__c}" /></td>

                                            </tr>
                                            <tr id="tr_Produto_1">
                                                <td>Moeda de Compra</td>
