                            </td>
                        </tr>
                    </table>
                </apex:pageBlock>
                <apex:form id="frmAcoes">
                <!-- Releated List Produtos -->
                    <apex:pageBlock title="Produtos Cadastrados" id="ListProdutosCadastrados">
                        <apex:pageBlockTable value="{!Locacao_x_Pedido__c.Produtos_x_Locaoes__r}"
                            var="child"  >
                            <apex:column headervalue="Ação">
                            <apex:commandButton action="{!Excluir}"
                                id="btnRemover" value="Excluir" reRender="none" style="display:{!mBotao}">
