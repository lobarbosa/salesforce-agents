                                            <input type="hidden" value="{!mBotao}" name="mBotao" id="mBotao"/>
                                            <input type="hidden" value="{!idContaFatLoc}" name="idConfigfirst" id="idConfigfirst"/>
                                            <input type="hidden" value="{!CambioGlobal}" name="CambioGlobal" id="CambioGlobal" />
                                            <apex:inputfield id="txt1"
                                                        required="false"
                                                        value="{!Locacao_x_Pedido__c.Cambio__c}" style="display:none"/>
                                                        <apex:inputfield id="txt2"
