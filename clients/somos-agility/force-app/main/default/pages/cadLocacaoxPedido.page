    <!--CSS do JqueryUI-->
    <apex:stylesheet value="{!URLFOR($Resource.JqueryUI, '/themes/base/jquery-ui.css')}" />
    <!---------------------->
    <apex:stylesheet value="{!URLFOR($Resource.PrimeUI, '/themes/overcast/theme.css')}" />
    <apex:stylesheet value="{!URLFOR($Resource.PrimeUI, '/development/css/tabview/tabview.css')}" />
    <!---------------------->
    <script type="text/javascript">
          $(document).ready(function(){        
           $('#default').puitabview(); 
           $('#img_help_Locacao_Cond').puitooltip({  
            showEvent: 'mouseover',  
            at: 'left bottom',  
            content: 'Favor preencher na pesquisa ddl*, escolhendo a opção Todos os Campos'}); 
            
             $('#img_help_Locacao_PDuracao').puitooltip({  
            showEvent: 'mouseover',  
            at: 'left bottom',  
            content: 'Favor preencher na pesquisa apenas com número, escolhendo a opção Todos os Campos'}); 
            
             $('#img_help_Locacao_TFaturamento').puitooltip({  
            showEvent: 'mouseover',  
            at: 'left bottom',  
            content: 'Favor preencher na pesquisa *mensal*, escolhendo a opção Todos os Campos'}); 

            $('#img_help_prod').puitooltip({  
            showEvent: 'mouseover',  
            at: 'left bottom',  
            content: 'Favor preencher na pesquisa Nome do Item*, escolhendo a opção Todos os Campos'});
            
             $('#img_help_pagCompra').puitooltip({  
            showEvent: 'mouseover',  
            at: 'left bottom',  
            content: 'Favor preencher na pesquisa ddl*, escolhendo a opção Todos os Campos'}); 
            
            $('#img_help_pagVenda').puitooltip({  
            showEvent: 'mouseover',  
            at: 'left bottom',  
            content: 'Favor preencher na pesquisa ddl*, escolhendo a opção Todos os Campos'}); 
            
            $('#img_help_CodFCompra').puitooltip({  
            showEvent: 'mouseover',  
            at: 'left bottom',  
            content: 'Favor preencher na pesquisa Cat*, escolhendo a opção Todos os Campos'}); 
            
            $('#img_help_CodFVenda').puitooltip({  
            showEvent: 'mouseover',  
            at: 'left bottom',  
            content: 'Favor preencher na pesquisa Cat*, escolhendo a opção Todos os Campos'});
           
           }); 
    </script>
    <style>
