                                <apex:param name="idNegociacao" value="{!idNegociacao + child.Negociacao_Comercial__c}" />
                                <apex:param name="Tipo" value="{!Tipo + 'Prod'}" />                                
                                <apex:param name="Idex" value="{!Idex + child.id}" />
                                </apex:commandButton>
                               <!--<apex:outputLink value="/apex/CadContratoSuportexPedido?id={!child.Negociacao_Comercial__c}&idProduto={!child.id}&Excluir=1">Excluir</apex:outputLink>-->
                               &nbsp;&nbsp;
                               <apex:outputLink style="text-decoration:none" value="/apex/CadLocacaoxPedido?id={!child.Locacao_x_Pedido__c}&idProduto={!child.id}&Editar=1&Redict=0&idNegociacao={!child.Negociacao_Comercial__c}&CambioGlobal={!CambioGlobal}" target="_self">
