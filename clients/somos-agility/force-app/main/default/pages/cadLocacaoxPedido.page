                               </apex:outputLink>
                            </apex:column>
                            <apex:column headervalue="Nome Produto">
                                {!child.Produto_NewAgePr__r.Name}
                            </apex:column>
                            <apex:column value="{!child.Valor_do_produto__c}" />
                        </apex:pageBlockTable>  
                        <!--Resumo total dos produtos-->
                                <apex:pageBlockTable value="{!Locacao_x_Pedido__c}"
