                                                </td>
                                                <td>
                                                    <label id="descTipoFat" style="display:block">Descrição do Tipo de Faturamento</label>
                                                </td>
                                                <td>
                                                    <apex:inputfield id="txtDescTipoFat" required="false"
                                                        value="{!Locacao_x_Pedido__c.Descricao_Tipo_de_Faturamento__c}"  style="width:350px;height:30px;display:block" />
                                                </td>
                                            </tr>
                                        </table>
                                        <hr />
                                        <center>
                                            <apex:commandButton action="{!SalvarPedidoxLocacao}"
                                                id="btnSalvarOpt" value="Salvar Informação" style="display:{!mBotao}" />
                                        </center>

                                    </apex:form>
                                </div>
                            </td>
                        </tr>
                        <tr>
                            <td>
                            
                            <div id="dv_recurso" style="display: {!mostrarAdendo};">
                            <apex:pageBlockSection title="Produto"  id="pgProduto" columns="1" >
                            <apex:form id="frmProduto">
                            
                            
