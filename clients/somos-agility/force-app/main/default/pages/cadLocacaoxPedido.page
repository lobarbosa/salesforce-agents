    <script type="text/javascript">
    
    
    
     if(document.getElementById('idConfigfirst').value==''){
            document.getElementById('cadLocacaoxPedido:pgMaster:frmPost:ddlOrigemFat').value='0015000000OZGSRAA5';
        }
        else{
            document.getElementById('cadLocacaoxPedido:pgMaster:frmPost:ddlOrigemFat').value=document.getElementById('idConfigfirst').value;
        }
    
    
     function inativaCambio(vlr,tipo){
        if(tipo=='Compra'){
            if(vlr=='Real'){
                document.getElementById('cadLocacaoxPedido:pgMaster:pgProduto:frmProduto:txtCotacaoCompra').value=0;
                document.getElementById('cadLocacaoxPedido:pgMaster:pgProduto:frmProduto:txtCotacaoCompra').readOnly=true;
            }
            else{
                //document.getElementById('cadLocacaoxPedido:pgMaster:pgProduto:frmProduto:txtCotacaoCompra').value=0;
                if(document.getElementById('cadLocacaoxPedido:pgMaster:pgProduto:frmProduto:txtCotacaoCompra').value==0){
                document.getElementById('cadLocacaoxPedido:pgMaster:pgProduto:frmProduto:txtCotacaoCompra').value = document.getElementById('CambioGlobal').value;
                }
                document.getElementById('cadLocacaoxPedido:pgMaster:pgProduto:frmProduto:txtCotacaoCompra').readOnly=false;
            }
