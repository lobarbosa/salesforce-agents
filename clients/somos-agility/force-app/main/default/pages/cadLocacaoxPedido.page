                                                        required="true" value="{!Locacao_x_Pedido__c.Categoria__c}" /></td>
                                               
                                                
                                            </tr>
                                            <tr id="tr_Produto_1">
                                                <td>Moeda de Venda</td>
                                                <td>
                                                
                                                <apex:selectList id="txtMoeda"
                                                        value="{!Locacao_x_Pedido__c.Moeda_Prod__c}"
                                                        size="1" onchange="inativaCambio(this.value,'Venda')">
                                                        <apex:selectOptions value="{!MoedaLocacao}"></apex:selectOptions>
                                                    </apex:selectList>
                                                <!--  
                                                <apex:inputfield id="txtMoeda"
                                                        value="{!Locacao_x_Pedido__c.Moeda_Prod__c}" onchange="inativaCambio(this.value,'Venda')"/>-->
                                                        
