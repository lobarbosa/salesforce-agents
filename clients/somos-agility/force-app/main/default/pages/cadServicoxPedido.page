    <script tyle="text/javascript">
    
        document.getElementById('cadServicoxPedido:frmPost:pgMaster:txtLocalPrestServico').value="{!Servico_x_Pedido__c.Local_da_Prestacao_de_Servicos__c}";
        if (document.getElementById('idConfigfirst').value == '') {
            document
                    .getElementById('cadServicoxPedido:frmPost:pgMaster:ddlOrigemFat').value = '0015000000OZGSRAA5';
        } else {
            document
                    .getElementById('cadServicoxPedido:frmPost:pgMaster:ddlOrigemFat').value = document
                    .getElementById('idConfigfirst').value;
        }

        function inativaCambio(vlr, tipo) {
        //alert(vlr);
            if (vlr == 'Real') {
                document
                        .getElementById('cadServicoxPedido:frmPost:pgMaster:txtCambio').value = 0;
                document
                        .getElementById('cadServicoxPedido:frmPost:pgMaster:txtCambio').readOnly = true;
            } else {
                document
                        .getElementById('cadServicoxPedido:frmPost:pgMaster:txtCambio').readOnly = false;
                 if(document.getElementById('cadServicoxPedido:frmPost:pgMaster:txtCambio').value=="" || document.getElementById('cadServicoxPedido:frmPost:pgMaster:txtCambio').value=="0"){
                    document.getElementById('cadServicoxPedido:frmPost:pgMaster:txtCambio').value = document.getElementById('CambioGlobal').value;
                 }
            }
        }
        
        if (document.getElementById('ReadOnly').value == 'true') {
            //Irá bloquear todos os campos para edição
            itens = document.getElementsByTagName('input');
            for (i = 0; i < itens.length; i++) {
                itens[i].setAttribute('disabled', 'true');
            }
            itensList = document.getElementsByTagName('select');
            for (i = 0; i < itensList.length; i++) {
                itensList[i].setAttribute('disabled', 'true');
            }
        }
        var Habilitar = 1;
        
        if (document.getElementById('idServico').value != ''
                && document.getElementById('Redict').value == '1') {
            window.open(
                    'https://na3.salesforce.com/apex/cadNegociacaoComercial?id='
                            + document.getElementById('idNegociacao').value
                            + '&idServico='
                            + document.getElementById('idServico').value
                            + '&Redict=1', '_top');
            Habilitar = 0;
        } else if (document.getElementById('Redict').value == '2') {
            window.open(
                    'https://na3.salesforce.com/apex/cadNegociacaoComercial?id='
                            + document.getElementById('idNegociacao').value
                            + '&idServico=', '_top');
            Habilitar = 0;
        }

        if (Habilitar == 1) {
            document.getElementById('default').style.display = 'block';
        }

        //alert("{!$Component.frmPost.txtValorTerceiro}");
        //Campos ReadOnly.
//        document.getElementById("cadServicoxPedido:frmPost:pgMaster:txtVerbaPreAlocadaDeslocamento").readOnly = true;
        //Funções de preenchimento automatico:
        
        function CalcularVerba(qtdAnalista, qtdHorasExtra, qtdHorasNormais,
                valor) {

            Visualforce.remoting.Manager
                    .invokeAction(
                            '{!$RemoteAction.clsCadServicoxPedido.CalculaVerba}',
                            qtdAnalista,
                            qtdHorasExtra,
                            qtdHorasNormais,
                            valor,
                            function(result, event) {
                                if (event.status) {
                                    if (result != '') {
                                        //alert('Gravação realizada com sucesso');
                                        //window.location.reload(true);
                                        document
                                                .getElementById("cadServicoxPedido:frmPost:pgMaster:txtVerbaPreAlocadaDeslocamento").value = result;
                                    }

                                }
                            });
        }

        //Bloqueia e Desbloqueia os campos de Custo de Viajem.
        function HabilitarDesp(vlr,vlr_viagem) {
            //alert(vlr);
            //alert(vlr_viagem);
            if (vlr == 'Cliente ( Nota de Débito )' || (vlr_viagem != 'Viagem(Acima 200KM)' && vlr_viagem != '')) {
                document.getElementById("dv_Custo").style.display = 'none';
            } else if (vlr != '') {
                document.getElementById("dv_Custo").style.display = 'block';
            }
            else{
              document.getElementById("dv_Custo").style.display = 'block';
            }
        }

        function validarFRM(frm){
            var msg='';
            try{
            if(document.getElementById("cadServicoxPedido:frmPost:pgMaster:ddlCompetencia").value==''){
                msg+='Por favor preencher a Competencia\n';
            }
            
            if(document.getElementById("cadServicoxPedido:frmPost:pgMaster:ddlFase").value==''){
                msg+='Por favor preencher a Fase da Metodologia\n';
            }
            if(document.getElementById('cadServicoxPedido:frmPost:pgMaster:txtCambio').value=='0' && document.getElementById('cadServicoxPedido:frmPost:pgMaster:txtMoeda').value=='Dolar'){
                msg+='Por favor preencher o valor em dolar maior que 0\n';
            }
            if(msg!=''){
                alert(msg);
                return false;
            }
            else{
                return true;
            }
                }
            catch(err){
                return true;
            }
        }

        function habilitalcob(vlr){
            if (vlr == 'Viagem(Acima 200KM)') {
                document.getElementById("lblNome").style.display = 'block';
                document.getElementById("cadServicoxPedido:frmPost:pgMaster:txtInstrucaoCobranca").style.display = 'block';
            }
            else{
                document.getElementById("lblNome").style.display = 'none';
                document.getElementById("cadServicoxPedido:frmPost:pgMaster:txtInstrucaoCobranca").style.display = 'none';
            }
        }

        //Funções de preenchimento automatico:
