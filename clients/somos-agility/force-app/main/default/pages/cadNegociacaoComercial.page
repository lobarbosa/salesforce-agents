    <script type="text/javascript">
        var URLT = window.location + "";
        var Pos=0;
        if (URLT.indexOf('idProduto')>0){
                Pos=1;
            }
        else if (URLT.indexOf('idServico')>0){
                Pos=2;
            }
        else if (URLT.indexOf('idContrato')>0){
                Pos=3;
            }
        else if (URLT.indexOf('idLocacao')>0){
                Pos=4;
            }
            
        

          $(document).ready(function(){ 
           $('#default').puitabview({
            orientation: 'top',
            activeIndex:(Pos)}  
           ); }); 
     
    </script>
    <script type="text/javascript">
    
        var sinc="{!Sinc}";
        var Tipo='info';
        if (sinc != 'OK' && sinc !='' ){
            Tipo='error';
        }
    if(sinc!=''){
        $(document).ready(function () { 
         $('#informacao').puigrowl({initialize:90000,sticky:true});
         $('#informacao').puigrowl('show', [{severity: Tipo, summary: 'Sincronização de Negociação Comercial', detail: '{!msgSincronia}'}]);
        });
     }
    
    
    </script>
    
    
