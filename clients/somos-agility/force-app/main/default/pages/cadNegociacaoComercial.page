    <script type="text/javascript">
        
    
        var txt='';
        if (document.getElementById('Travar').value=="1"){
            document.getElementById('default').style.display='none';
        }
        else{
            document.getElementById('default').style.display='block';
        }
        try{
            var idOportunidade=document.getElementById("{!$Component.frmPost.txtOportunidade}_lkid").value;
        }
        catch(err){
            /*txt="There was an error on this page.\n\n";
            txt+="Error description: " + err.message + "\n\n";
            txt+="Click OK to continue.\n\n";
            alert(txt);*/
        }
        try{
            var idNegociacao=document.getElementById("idNegociacao").value;
            var idProduto = document.getElementById("idProduto").value;
            var idServico = document.getElementById("idServico").value;
            var idContrato = document.getElementById("idContrato").value;
            var idLocacao = document.getElementById('idLocacao').value;
            var redireciona = document.getElementById('Redict').value;
            
            
            var idContaFatProd = document.getElementById('idContaFatProd').value;
            var idContaFatServ = document.getElementById('idContaFatServ').value;
            var idContaFatLoc = document.getElementById('idContaFatLoc').value;
            var idContaFatCont = document.getElementById('idContaFatCont').value;
            var Cambio = document.getElementById('Cambio').value;
            var CambioVenda = document.getElementById('CambioVenda').value;
            var HCambioGlobal = document.getElementById('CambioGlobal').value;
            
            //alert(redireciona);
        }
        catch(err){
            /*txt="There was an error on this page.\n\n";
            txt+="Error description: " + err.message + "\n\n";
            txt+="Click OK to continue.\n\n";
            alert(txt);*/
        }
        function atualizar(){
            if (idNegociacao!=''){
                document.getElementById('default').style.display='none';
                document.getElementById("{!$Component.frmPost}").submit();
                window.open('https://na3.salesforce.com/apex/cadNegociacaoComercial?id=' +idNegociacao,'_top');
            }
        }
        function AbreNovoProduto(){
            
            if(document.getElementById('frmProduto').style.display=='none'){
                var URL= '&CambioGlobal='+HCambioGlobal+'&prodCambioVenda='+CambioVenda+'&prodCambio='+Cambio+'&idContaFatProd='+idContaFatProd+'&idNegociacao='+idNegociacao +'&mbotao={!mbotao}&ReadOnly={!ReadOnly}&DisabledField={!DisabledField}';
                if(idProduto!=''){
                    URL=URL+'&id=' + idProduto + '&Redict='+redireciona;
                }
                document.getElementById('frmProduto').style.display='block';
                document.getElementById('frmProduto').style.width='100%';
                document.getElementById('frmProduto').style.height='690px';
                document.getElementById('frmProduto').iframeborder='0';
                window.open('https://na3.salesforce.com/apex/cadProdutoxPedido?idOportunidade=' +
                            idOportunidade+URL ,'frmProduto');
            }
            else{
                document.getElementById('frmProduto').style.display='none';
            }
        }
        
        function AbreNovoServico(){
         var URL= '&CambioGlobal='+HCambioGlobal+'&idContaFatServ='+idContaFatServ+'&idNegociacao='+idNegociacao +'&mbotao={!mbotao}&ReadOnly={!ReadOnly}&DisabledField={!DisabledField}';
                if(idServico!=''){
                    URL=URL+'&id=' + idServico + '&Redict='+redireciona;
                }
            if(document.getElementById('frmServico').style.display=='none'){
                document.getElementById('frmServico').style.display='block';
                document.getElementById('frmServico').style.width='100%';
                document.getElementById('frmServico').style.height='699px';
                document.getElementById('frmServico').iframeborder='0';
                window.open('https://na3.salesforce.com/apex/cadServicoxPedido?idOportunidade=' +idOportunidade+
                URL,'frmServico');
            }
            else{
                document.getElementById('frmServico').style.display='none';
            }
        }
        
        function AbreNovoContrato(){
            if(document.getElementById('frmContratoSuporte').style.display=='none'){
                var URL= '&CambioGlobal='+HCambioGlobal+'&idContaFatCont='+idContaFatCont+'&idNegociacao=' + idNegociacao+'&mbotao={!mbotao}&ReadOnly={!ReadOnly}&DisabledField={!DisabledField}';
                    if(idContrato!=''){
                        URL=URL+'&id=' + idContrato + '&Redict='+redireciona;
                    }
                document.getElementById('frmContratoSuporte').style.display='block';
                document.getElementById('frmContratoSuporte').style.width='100%';
                document.getElementById('frmContratoSuporte').style.height='1400px';
                document.getElementById('frmContratoSuporte').iframeborder='0';
                window.open('https://na3.salesforce.com/apex/cadContratoSuportexPedido?idOportunidade=' +idOportunidade + 
                URL,'frmContratoSuporte');
            }
            else{
                document.getElementById('frmContratoSuporte').style.display='none';
            }
        }
        
        function AbreNovaLocacao(){
            if(document.getElementById('frmLocacao').style.display=='none'){
            var URL= '&CambioGlobal='+HCambioGlobal+'&idContaFatLoc='+idContaFatLoc+'&idNegociacao=' + idNegociacao+'&mbotao={!mbotao}&ReadOnly={!ReadOnly}&DisabledField={!DisabledField}';
                if(idLocacao!=''){
                    URL=URL+'&id=' + idLocacao + '&Redict='+redireciona;
                }
                document.getElementById('frmLocacao').style.display='block';
                document.getElementById('frmLocacao').style.width='100%';
                document.getElementById('frmLocacao').style.height='1400px';
                document.getElementById('frmLocacao').iframeborder='0';
                window.open('https://na3.salesforce.com/apex/cadLocacaoxPedido?idOportunidade=' +idOportunidade+URL
                ,'frmLocacao');
            }
            else{
                document.getElementById('frmLocacao').style.display='none';
            }
        }
        
        function AbrePedido(){
            
            if(document.getElementById('frmPedido').style.display=='none'){
                var URL= '&idNegociacao='+idNegociacao + '&ConvertidoOK=block';
                document.getElementById('frmPedido').style.display='block';
                document.getElementById('frmPedido').style.width='100%';
                document.getElementById('frmPedido').style.height='690px';
                document.getElementById('frmPedido').iframeborder='0';
                window.open('https://na3.salesforce.com/apex/cadPedido?idOportunidade=' +
                            idOportunidade+URL ,'frmPedido');
            }
            else{
                document.getElementById('frmPedido').style.display='none';
            }
        }
        function ChamarServico(){
            document.getElementById('default').style.display='none';
            document.getElementById('Dv_Informacaoes').style.display='none';
            document.getElementById('dv_Sinc').style.display='block';
        }
        AbreNovoProduto();
        AbreNovaLocacao();
        AbreNovoServico();
        AbreNovoContrato();
        AbrePedido();
        /*var Mesagem="{!Mesagem}";
        if(Mesagem!=''){
            alert(Mesagem);
        }*/
    </script>
