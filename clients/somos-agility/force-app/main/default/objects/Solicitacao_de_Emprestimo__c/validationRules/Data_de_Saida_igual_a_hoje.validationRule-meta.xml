<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Data_de_Saida_igual_a_hoje</fullName>
    <active>false</active>
    <errorConditionFormula>AND(ISNEW(),Data_de_Saida_do_Equipamento__c &lt; Today())</errorConditionFormula>
    <errorDisplayField>Data_de_Saida_do_Equipamento__c</errorDisplayField>
    <errorMessage>A Data de Saída do equipamento não deve ser uma data inferior a data de hoje.</errorMessage>
</ValidationRule>
