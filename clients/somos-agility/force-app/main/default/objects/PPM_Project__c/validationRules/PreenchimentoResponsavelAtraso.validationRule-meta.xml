<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>PreenchimentoResponsavelAtraso</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
ISPICKVAL(Project_Status__c,&apos;Atrasado&apos;),
ISPICKVAL(ResponsavelAtraso__c,&apos;&apos;)
)</errorConditionFormula>
    <errorMessage>Ao informar que o Projeto está Atrasado, será necessário informar o Responsável pelo atraso.</errorMessage>
</ValidationRule>
