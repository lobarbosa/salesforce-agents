<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Status_Finalizado</fullName>
    <active>false</active>
    <description>Não pode alterar o Status do Projeto após Finalizado</description>
    <errorConditionFormula>AND(ISPICKVAL( PRIORVALUE(Project_Status__c) , &quot;Finalizado&quot;), ISCHANGED( Project_Status__c))</errorConditionFormula>
    <errorDisplayField>Project_Status__c</errorDisplayField>
    <errorMessage>Após Finalizado, não pode alterar o Status do Projeto.</errorMessage>
</ValidationRule>
