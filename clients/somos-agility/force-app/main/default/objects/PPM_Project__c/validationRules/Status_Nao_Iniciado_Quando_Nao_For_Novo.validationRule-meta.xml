<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Status_Nao_Iniciado_Quando_Nao_For_Novo</fullName>
    <active>false</active>
    <description>Não é permitido Retornar ao Status Não Iniciado</description>
    <errorConditionFormula>NOT(ISNEW()) &amp;&amp; ISCHANGED( Project_Status__c ) 
&amp;&amp; 
( 
TEXT(Project_Status__c ) = &quot;Não iniciado&quot;)</errorConditionFormula>
    <errorDisplayField>Project_Status__c</errorDisplayField>
    <errorMessage>GP, o Status não pode retornar para Não Iniciado</errorMessage>
</ValidationRule>
