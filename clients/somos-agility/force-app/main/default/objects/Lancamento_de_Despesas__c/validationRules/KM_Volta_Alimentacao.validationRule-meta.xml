<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>KM_Volta_Alimentacao</fullName>
    <active>true</active>
    <errorConditionFormula>AND(ISPICKVAL(Tipo_da_Despesa__c,&quot;Alimentação&quot;),NOT(ISBLANK(  Kilometros_Percorridos_Volta__c  )))</errorConditionFormula>
    <errorMessage>A Despesa é de Alimentação, não devendo preencher o campo de KM Volta</errorMessage>
</ValidationRule>
