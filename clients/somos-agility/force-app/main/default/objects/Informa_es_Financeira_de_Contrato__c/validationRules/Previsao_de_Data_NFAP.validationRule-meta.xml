<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Previsao_de_Data_NFAP</fullName>
    <active>false</active>
    <errorConditionFormula>AND (  ISPICKVAL  (Faturamento__c, &quot;NFAP&quot;) ,
 ISBLANK(  Previsao_de_Data_de_Entrega_do_Projeto_o__c ))</errorConditionFormula>
    <errorDisplayField>Previsao_de_Data_de_Entrega_do_Projeto_o__c</errorDisplayField>
    <errorMessage>Favor Informar a Previsão de Data</errorMessage>
</ValidationRule>
