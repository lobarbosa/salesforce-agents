<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Status_Faturamento_FANR</fullName>
    <active>true</active>
    <errorConditionFormula>AND (ISPICKVAL(Faturamento__c,&quot;FANR&quot;),
OR(
(Valor_Reconhecido__c &lt;&gt;0)))</errorConditionFormula>
    <errorMessage>Se o Status do Faturamento é FANR o campo Valor Reconhecido (R$) deverá estar vazio ou igual a 0</errorMessage>
</ValidationRule>
