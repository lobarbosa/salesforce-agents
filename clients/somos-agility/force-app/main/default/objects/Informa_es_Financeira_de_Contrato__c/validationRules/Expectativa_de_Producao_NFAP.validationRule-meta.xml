<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Expectativa_de_Producao_NFAP</fullName>
    <active>false</active>
    <errorConditionFormula>AND (  ISPICKVAL  (Faturamento__c, &quot;NFAP&quot;) ,
 ISBLANK(    Expectativa_de_Producao_Parcial_old__c   ))</errorConditionFormula>
    <errorDisplayField>Expectativa_de_Producao_Parcial_old__c</errorDisplayField>
    <errorMessage>Favor Informar a Expectativa de Produção Parcial</errorMessage>
</ValidationRule>
