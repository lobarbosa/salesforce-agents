<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Status_Faturamento_NFR</fullName>
    <active>false</active>
    <errorConditionFormula>AND (ISPICKVAL(Faturamento__c,&quot;NFR&quot;), 
OR( 
(Valor_Faturado__c &lt;&gt;0), 
(Valor_Reconhecido__c &lt;1), 
ISNULL(Valor_Faturado__c), 
ISNULL(Valor_Reconhecido__c) 
) 
)</errorConditionFormula>
    <errorMessage>Se o Status do Faturamento é NFR o Valor de Faturamento (R$)deve ser igual a 0 e o Valor Reconhecido (R$) deve ser maior que 1</errorMessage>
</ValidationRule>
