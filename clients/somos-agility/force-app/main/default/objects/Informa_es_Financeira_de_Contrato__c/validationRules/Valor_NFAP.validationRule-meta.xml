<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Valor_NFAP</fullName>
    <active>true</active>
    <errorConditionFormula>AND (  ISPICKVAL  (Faturamento__c, &quot;NFAP&quot;) ,
 ISBLANK( Valor_NFAP__c ))</errorConditionFormula>
    <errorDisplayField>Valor_NFAP__c</errorDisplayField>
    <errorMessage>Informar o Valor NFAP</errorMessage>
</ValidationRule>
