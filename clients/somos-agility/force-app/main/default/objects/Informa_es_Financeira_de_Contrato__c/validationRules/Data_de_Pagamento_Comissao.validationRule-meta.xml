<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Data_de_Pagamento_Comissao</fullName>
    <active>true</active>
    <errorConditionFormula>AND(ISBLANK( Data_do_Pagamento__c),(Pago__c =TRUE),TRUE,TRUE)</errorConditionFormula>
    <errorDisplayField>Data_do_Pagamento__c</errorDisplayField>
    <errorMessage>Favor informar a Data de Pagamento da Comissão</errorMessage>
</ValidationRule>
