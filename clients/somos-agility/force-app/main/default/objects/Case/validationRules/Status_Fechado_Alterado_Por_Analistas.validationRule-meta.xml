<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Status_Fechado_Alterado_Por_Analistas</fullName>
    <active>true</active>
    <description>Os Analistas não podem alterar o status dos casos após fechado</description>
    <errorConditionFormula>ISPICKVAL(PRIORVALUE(Status), &quot;Fechado&quot;)&amp;&amp;
( $User.Department = &apos;EA&apos; || $User.Department = &apos;DC&amp;C&apos;|| $User.Department = &apos;SEC&apos; || $User.Department = &apos;MS&apos;||$User.Department = &apos;Grupo Itau&apos; || $User.Department = &apos;Facility&apos;|| $User.Department = &apos;TIC&apos; )</errorConditionFormula>
    <errorMessage>Não é permitido alterar um Caso com Status Fechado</errorMessage>
</ValidationRule>
