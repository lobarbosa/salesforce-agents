<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>M04_Campo_projeto_obrigatorio</fullName>
    <active>true</active>
    <description>AM100918: obrigatório o preenchimento do campo &quot;Projeto&quot; quando a &quot;Origem da despesa&quot; for &quot;Projetos&quot;</description>
    <errorConditionFormula>AND(
ISPICKVAL(Origem_da_despesa__c, &quot;Projetos&quot;),
ISBLANK(Relacionado_ao_Projeto__c))</errorConditionFormula>
    <errorDisplayField>Relacionado_ao_Projeto__c</errorDisplayField>
    <errorMessage>Informe o número do projeto (Msg04)</errorMessage>
</ValidationRule>
