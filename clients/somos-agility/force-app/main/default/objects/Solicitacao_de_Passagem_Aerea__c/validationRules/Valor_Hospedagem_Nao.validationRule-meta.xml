<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Valor_Hospedagem_Nao</fullName>
    <active>true</active>
    <errorConditionFormula>AND(ISPICKVAL( Hospedagem__c ,&quot;Não&quot;),
NOT(ISBLANK( Valor_Unitario_da_Hospedagem__c )))</errorConditionFormula>
    <errorDisplayField>Valor_Unitario_da_Hospedagem__c</errorDisplayField>
    <errorMessage>Para este Tipo de Solicitação não é necessário informar este valor.</errorMessage>
</ValidationRule>
