<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Hospedagem_Nao_Preecha_Chkin</fullName>
    <active>true</active>
    <errorConditionFormula>AND(ISPICKVAL( Hospedagem__c  , &quot;Não&quot; ), NOT(ISBLANK(   Check_in__c )))</errorConditionFormula>
    <errorDisplayField>Check_in__c</errorDisplayField>
    <errorMessage>Para este tipo de solicitação não é necessário informar a data de Check-in</errorMessage>
</ValidationRule>
