<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Data_Checkin</fullName>
    <active>true</active>
    <errorConditionFormula>AND(ISPICKVAL(Hospedagem__c ,&quot;Sim&quot;),ISBLANK(Check_in__c ))</errorConditionFormula>
    <errorDisplayField>Check_in__c</errorDisplayField>
    <errorMessage>Informar a data para Check-in</errorMessage>
</ValidationRule>
