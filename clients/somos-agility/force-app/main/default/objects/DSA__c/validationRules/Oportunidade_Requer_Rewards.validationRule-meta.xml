<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Oportunidade_Requer_Rewards</fullName>
    <active>false</active>
    <errorConditionFormula>AND (ISPICKVAL( Oportunidade_Qualificada_para_Rewards__c, &quot;Sim&quot;) , 
ISBLANK( Valor_Rewards_USD__c ))</errorConditionFormula>
    <errorMessage>Informe o Valor a ser recebido de Rewards</errorMessage>
</ValidationRule>
