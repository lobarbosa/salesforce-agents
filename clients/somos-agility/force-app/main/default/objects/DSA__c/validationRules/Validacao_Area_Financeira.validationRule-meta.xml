<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Validacao_Area_Financeira</fullName>
    <active>false</active>
    <errorConditionFormula>AND ( ISPICKVAL(  Validado_pela_rea_Financeira__c  ,&quot;não&quot;),
 ISBLANK(  Observa_es_da_rea_Financeira__c  ))</errorConditionFormula>
    <errorDisplayField>Validado_pela_rea_Financeira__c</errorDisplayField>
    <errorMessage>Favor preencher Observações da Área Financeira</errorMessage>
</ValidationRule>
