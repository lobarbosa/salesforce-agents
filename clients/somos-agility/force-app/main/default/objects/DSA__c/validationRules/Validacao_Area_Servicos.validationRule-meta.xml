<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Validacao_Area_Servicos</fullName>
    <active>false</active>
    <errorConditionFormula>AND ( ISPICKVAL( Validado_pela_rea_de_Servi_os__c ,&quot;não&quot;),
 ISBLANK( Observa_es_da_rea_de_Servi_os__c ))</errorConditionFormula>
    <errorDisplayField>Validado_pela_rea_de_Servi_os__c</errorDisplayField>
    <errorMessage>Favor preencher Observações da Área de Serviços.</errorMessage>
</ValidationRule>
