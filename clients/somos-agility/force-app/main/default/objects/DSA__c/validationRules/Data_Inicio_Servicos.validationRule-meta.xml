<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Data_Inicio_Servicos</fullName>
    <active>false</active>
    <errorConditionFormula>AND (ISPICKVAL (  Oportunidade__r.Categoria__c  , &quot;Projeto (Produto + Serviços)&quot;), 
ISBLANK ( Data_estimada_de_in_cio_dos_Servi_os__c ))</errorConditionFormula>
    <errorMessage>Informar a Data Estimada de Início dos Serviços</errorMessage>
</ValidationRule>
