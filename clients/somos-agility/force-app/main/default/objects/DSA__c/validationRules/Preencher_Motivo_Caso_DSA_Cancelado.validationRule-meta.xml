<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Preencher_Motivo_Caso_DSA_Cancelado</fullName>
    <active>false</active>
    <errorConditionFormula>AND(ISPICKVAL( Status_DSA__c ,&quot;Cancelado&quot;),ISBLANK( Motivo__c ))</errorConditionFormula>
    <errorDisplayField>Motivo__c</errorDisplayField>
    <errorMessage>Favor Informar o Motivo pelo Cancelamento do DSA</errorMessage>
</ValidationRule>
