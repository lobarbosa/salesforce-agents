<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>M03_Informar_o_tipo_do_contrato</fullName>
    <active>false</active>
    <description>AM270818: Informar_o_tipo_do_contrato</description>
    <errorConditionFormula>AND (ISPICKVAL(   Cliente_Contratou_Servi_os_de_Suporte__c, &quot;Sim&quot;) , 
ISBLANK(TEXT(Tipo_de_Contrato_de_Suporte__c)))</errorConditionFormula>
    <errorDisplayField>Tipo_de_Contrato_de_Suporte__c</errorDisplayField>
    <errorMessage>Informe o campo &quot;Tipo de Contrato de Suporte&quot; (Msg03)</errorMessage>
</ValidationRule>
