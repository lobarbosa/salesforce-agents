<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Trade_in</fullName>
    <active>false</active>
    <errorConditionFormula>AND (ISPICKVAL( Envolve_Trade_in__c, &quot;Sim&quot;) , 
ISBLANK( Descrever_Produtos_que_ser_o_devolvidos__c ))</errorConditionFormula>
    <errorMessage>Quando o DSA envolver Trade-In, favor informar os produtos que serão devolvidos.</errorMessage>
</ValidationRule>
