<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Nao_Preencher_Motivo_Caso_DSA_Cancelado</fullName>
    <active>false</active>
    <errorConditionFormula>AND(TEXT( Status_DSA__c) &lt;&gt; &quot;Cancelado&quot;, NOT(ISBLANK( Motivo__c )))</errorConditionFormula>
    <errorDisplayField>Motivo__c</errorDisplayField>
    <errorMessage>O Motivo deve ser preenchido somente caso o DSA seja cancelado</errorMessage>
</ValidationRule>
