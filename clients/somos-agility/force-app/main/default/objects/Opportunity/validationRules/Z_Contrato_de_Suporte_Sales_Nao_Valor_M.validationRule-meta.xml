<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Z_Contrato_de_Suporte_Sales_Nao_Valor_M</fullName>
    <active>false</active>
    <errorConditionFormula>AND( ISPICKVAL( Contrato_de_Suporte__c , &quot;Não&quot;), NOT(ISNULL(  Valor_Mensal_de_Suporte__c )))</errorConditionFormula>
    <errorDisplayField>Valor_Mensal_de_Suporte__c</errorDisplayField>
    <errorMessage>Não é possível apontar o Valor Mensal (Sales In) com a opção &quot;Não&quot; no Contrato de Suporte</errorMessage>
</ValidationRule>
