<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Z_Contrato_de_Suporte_Sim_Contrato_2</fullName>
    <active>false</active>
    <errorConditionFormula>AND( ISPICKVAL( Contrato_de_Suporte__c , &quot;Sim - Novo (Sales In)&quot;), NOT(ISBLANK(N_Contrato_a_ser_Renovado_2__c  )))</errorConditionFormula>
    <errorDisplayField>N_Contrato_a_ser_Renovado_2__c</errorDisplayField>
    <errorMessage>Não é possível apontar o Contrato 2 com a opção &quot;	
Sim - Novo (Sales In)&quot; no Contrato de Suporte</errorMessage>
</ValidationRule>
