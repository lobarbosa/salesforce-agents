<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Z_Lock_Opportunity</fullName>
    <active>false</active>
    <errorConditionFormula>AND(
TEXT(PRIORVALUE(StageName)) = &quot;OEG&quot;,
ISCHANGED(StageName),
ISPICKVAL(StageName, &quot;CVS/RVS&quot;),
$Profile.Name &lt;&gt; &quot;Administração&quot;)</errorConditionFormula>
    <errorMessage>Essa oportunidade já está qualificada, e não pode ser alterada para estágios anteriores.</errorMessage>
</ValidationRule>
