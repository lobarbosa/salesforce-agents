<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Checa_Preenchimento_CPF</fullName>
    <active>true</active>
    <description>Valida se o CPF possui 11 dígitos.</description>
    <errorConditionFormula>AND(
    LEN(CPF__c) &lt;&gt; 11,
    ISPICKVAL(Contato_Trabalha_Atualmente_na_Empresa__c, &quot;Sim&quot;),
    Account.Id = &apos;0015000000OZGSRAA5&apos;
)</errorConditionFormula>
    <errorDisplayField>CPF__c</errorDisplayField>
    <errorMessage>O CPF deve ter 11 dígitos.</errorMessage>
</ValidationRule>
