<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Lead_Novo</fullName>
    <active>true</active>
    <errorConditionFormula>ISNEW() &amp;&amp; 
TEXT(Status) &lt;&gt; &quot;Novo&quot;</errorConditionFormula>
    <errorDisplayField>Status</errorDisplayField>
    <errorMessage>O Status do Lead deve ser criado como Novo</errorMessage>
</ValidationRule>
