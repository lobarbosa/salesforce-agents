<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>GC_Responsavel</fullName>
    <active>false</active>
    <errorConditionFormula>AND( ISBLANK( AccountId__c ) , ISBLANK( Propriet_rio_da_Conta_GC__c ))</errorConditionFormula>
    <errorDisplayField>AccountId__c</errorDisplayField>
    <errorMessage>Ao criar um novo Lead deve ser selecionada uma conta existente (Nome da Conta) ou Gerente de Conta (Gerente de Conta Atribuído)</errorMessage>
</ValidationRule>
