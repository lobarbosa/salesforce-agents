<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Validacao_Telefone</fullName>
    <active>false</active>
    <errorConditionFormula>IF( 
NOT ( ISBLANK(Phone)), 
NOT (REGEX(Phone, &quot;\\(\\d{3}\\)\\ \\d{2}( \\d{4})(\\d{4})&quot;)), 
Null)</errorConditionFormula>
    <errorDisplayField>Phone</errorDisplayField>
    <errorMessage>Este campo deve estar no formato (0XX) XX YYYY YYYY</errorMessage>
</ValidationRule>
