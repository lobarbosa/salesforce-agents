<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>CNPJ</fullName>
    <active>true</active>
    <errorConditionFormula>AND(NOT( ISBLANK( CNPJ_Fornecedor__c ) ) ,NOT( REGEX( CNPJ_Fornecedor__c , &quot;[0-9]{2}.[0-9]{3}.[0-9]{3}[- /.][0-9]{4}-[0-9]{2}&quot;)))</errorConditionFormula>
    <errorMessage>O Formato deve ser 99.999.999/9999-99.</errorMessage>
</ValidationRule>
