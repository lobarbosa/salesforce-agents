<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Tem_servico__c</fullName>
    <formula>AND(
    OR(
        NOT(ISBLANK(TEXT(PropostaSolucao__r.Oportunidade__r.Produto_Recorrente__c))),
        INCLUDES(PropostaSolucao__r.TipoPsl__c, &quot;Serviços&quot;)
    ),
    PropostaSolucao__r.Oportunidade__r.Renova_o__c = FALSE
)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Tem serviço?</label>
