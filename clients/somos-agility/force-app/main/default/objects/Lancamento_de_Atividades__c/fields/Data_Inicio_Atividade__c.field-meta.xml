<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Data_Inicio_Atividade__c</fullName>
    <description>Campo utilizado para apoiar o campo fórmula &quot;Validação HC HNC&quot;, quando o campo data de início da atividade for 0h ou 0:30h.</description>
    <formula>IF(
    Controle_Zero_Hora__c = true,
    DATEVALUE(Inicio_da_atividade__c) + 1,
    DATEVALUE(Inicio_da_atividade__c)
)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <inlineHelpText>Utilizado para desenvolvimento</inlineHelpText>
    <label>Data início da atividade</label>
    <required>false</required>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Date</type>
</CustomField>
