<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Nao_Preencher_Numero_do_Contrato</fullName>
    <active>true</active>
    <errorConditionFormula>AND(ISPICKVAL(	Tipo_do_Contrato__c , &quot;Novo (Sales In)&quot;), NOT(ISBLANK(  N_Contrato_Renovado_Upgrade__c  )))</errorConditionFormula>
    <errorDisplayField>N_Contrato_Renovado_Upgrade__c</errorDisplayField>
    <errorMessage>Não é necessário informar o número do contrato para este tipo de registro</errorMessage>
</ValidationRule>
