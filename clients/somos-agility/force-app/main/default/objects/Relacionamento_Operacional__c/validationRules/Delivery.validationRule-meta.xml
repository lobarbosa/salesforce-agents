<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Delivery</fullName>
    <active>true</active>
    <errorConditionFormula>AND (Delivery_Realizado__c=false, ISBLANK ( Motivo__c ))</errorConditionFormula>
    <errorMessage>Preencher o campo Motivo</errorMessage>
</ValidationRule>
