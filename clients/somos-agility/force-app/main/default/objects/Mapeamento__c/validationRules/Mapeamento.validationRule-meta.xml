<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Mapeamento</fullName>
    <active>false</active>
    <errorConditionFormula>AND(ISPICKVAL(Situa_o_do_Mapeamento__c, &apos;Aprovado&apos;), 
(OR(ISBLANK(Data_de_Aprova_o__c), 
ISBLANK(Data_de_Mapeamento__c), 
ISBLANK(Data_de_Validade_do_Registro__c), 
ISBLANK( N_mero_do_Registro__c ))))</errorConditionFormula>
    <errorMessage>Quando campo Situação do Mapeamento Aprovado obrigatório o preenchimento dos campos da Seção de Mapeamento.</errorMessage>
</ValidationRule>
