<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Mapeamento_Palo_Alto</fullName>
    <active>false</active>
    <errorConditionFormula>AND(ISPICKVAL(Solu_o__c , &quot;Palo Alto&quot;), 
(OR(ISBLANK(Problema_que_o_cliente_quer_resolver__c), 
ISBLANK(Produtos_que_o_cliente_possui_firewwall__c), 
ISBLANK(Pr_oximos_passos_no_projeto__c), 
ISBLANK(Data_da_visita_ao_cliente_e_apresenta_o__c))))</errorConditionFormula>
    <errorMessage>Preencher os Campos da Sessão Questionário Exclusivo Palo Alto</errorMessage>
</ValidationRule>
