<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Inicio_menor_45_dias</fullName>
    <active>false</active>
    <errorConditionFormula>IF( Colaborador__r.Pode_solicitar_ferias_45_dias__c =False&amp;&amp;Inicio__c &lt;= Today()+44&amp;&amp;(ISPICKVAL( Status_da_Qualificao__c ,&quot;0 - Não Enviado&quot;)||TEXT(Status_da_Qualificao__c)=&quot;&quot;),True,False)</errorConditionFormula>
    <errorMessage>Caro Colaborador, você deve solicitar suas férias com antecedência mínima de 45 dias. Caso tenha dúvidas procure o departamento de Recursos Humanos</errorMessage>
</ValidationRule>
