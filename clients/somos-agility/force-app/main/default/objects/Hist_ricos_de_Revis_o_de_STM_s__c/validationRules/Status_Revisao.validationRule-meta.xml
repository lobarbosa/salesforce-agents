<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Status_Revisao</fullName>
    <active>true</active>
    <errorConditionFormula>AND( ISPICKVAL( Status_da_Revis_o__c,&quot;Completo&quot;),
 ISBLANK( Data_da_Revis_o__c ))</errorConditionFormula>
    <errorDisplayField>Data_da_Revis_o__c</errorDisplayField>
    <errorMessage>Favor Informar a Data de Revisão</errorMessage>
</ValidationRule>
