<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Nao_pode_desmarcar_o_Cancelamento</fullName>
    <active>false</active>
    <errorConditionFormula>AND(Cancelar__c = False,ISCHANGED( Cancelar__c ))</errorConditionFormula>
    <errorDisplayField>Cancelar__c</errorDisplayField>
    <errorMessage>Sua solicitação já foi cancelada. Não é possível desmarcar este campo.</errorMessage>
</ValidationRule>
