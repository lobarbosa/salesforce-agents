<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Propriedade_Outros</fullName>
    <active>true</active>
    <errorConditionFormula>AND (ISPICKVAL( Propriedade__c , &quot;Outros&quot;) , 
ISBLANK( Descrever__c ))</errorConditionFormula>
    <errorMessage>Descrever Propriedade do Equipamento</errorMessage>
</ValidationRule>
