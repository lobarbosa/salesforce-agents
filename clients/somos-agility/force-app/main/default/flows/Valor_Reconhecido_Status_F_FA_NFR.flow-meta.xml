<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>55.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>Migrado de: regra de fluxo de trabalho Valor Reconhecido Status F &amp; FA &amp; NFR
Descrição da regra de fluxo de trabalho: Quando o Status do Faturamento for igual a F &amp; FA &amp; NFR será aplicado o Valor do Indice de Reajuste no Valor Reconhecido.&quot;</description>
    <formulas>
        <name>Atualizar_Valor_ReconhecidoFormula</name>
        <dataType>Currency</dataType>
        <expression>$Record.Valor_Reconhecido__c + ( $Record.Valor_Reconhecido__c *  $Record.Indice_de_Reajuste__c )</expression>
        <scale>0</scale>
    </formulas>
    <label>Valor Reconhecido Status F &amp; FA &amp; NFR</label>
    <migratedFromWorkflowRuleName>Valor Reconhecido Status F &amp; FA &amp; NFR</migratedFromWorkflowRuleName>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>mainUpdate</name>
        <label>mainUpdate</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>Valor_Reconhecido__c</field>
            <value>
                <elementReference>Atualizar_Valor_ReconhecidoFormula</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>mainUpdate</targetReference>
        </connector>
        <filterFormula>(ISPICKVAL( {!$Record.Faturamento__c} ,&quot;F&quot;)||ISPICKVAL( {!$Record.Faturamento__c} ,&quot;FA&quot;)||ISPICKVAL( {!$Record.Faturamento__c} ,&quot;NFR&quot;))&amp;&amp; (ISCHANGED( {!$Record.Indice_de_Reajuste__c} ) || ISCHANGED( {!$Record.Valor_Reconhecido__c} ))</filterFormula>
        <object>Informa_es_Financeira_de_Contrato__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Obsolete</status>
</Flow>
