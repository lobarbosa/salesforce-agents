<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>61.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>Ao criar-se uma DSA, captura-se os valores de CIF e FOB da PFV e os repassa para DSA.</description>
    <environments>Default</environments>
    <interviewLabel>Atualiza DSA com informações da PFV {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Atualiza DSA com informações da PFV</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Captura_PFV_relacionada</name>
        <label>Captura PFV relacionada</label>
        <locationX>176</locationX>
        <locationY>323</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Atualiza_DSA_relacionada</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Oportunidade__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Oportunidade__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Produto_da_Proposta_de_Solucao__c</object>
        <sortField>CreatedDate</sortField>
        <sortOrder>Desc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Atualiza_DSA_relacionada</name>
        <label>Atualiza DSA relacionada</label>
        <locationX>176</locationX>
        <locationY>431</locationY>
        <inputAssignments>
            <field>Valor_CIF_Moeda__c</field>
            <value>
                <elementReference>Captura_PFV_relacionada.Valor_CIF_Moeda__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Valor_CIF__c</field>
            <value>
                <elementReference>Captura_PFV_relacionada.Valor_CIF__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Valor_FOB_Moeda__c</field>
            <value>
                <elementReference>Captura_PFV_relacionada.Valor_FOB_Moeda__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Valor_FOB__c</field>
            <value>
                <elementReference>Captura_PFV_relacionada.Valor_FOB__c</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Captura_PFV_relacionada</targetReference>
        </connector>
        <object>DSA__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
