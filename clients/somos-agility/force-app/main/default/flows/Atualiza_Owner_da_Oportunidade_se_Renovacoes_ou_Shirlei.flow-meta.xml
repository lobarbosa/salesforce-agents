<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Verifica_ID_do_Owner_da_Oportunidade</name>
        <label>Verifica ID do Owner da Oportunidade</label>
        <locationX>1022</locationX>
        <locationY>185</locationY>
        <defaultConnectorLabel>Saída</defaultConnectorLabel>
        <rules>
            <name>Renovacoes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record__Prior.Owner.Email</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>renovacoes@somosagility.com.br</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Atualiza_Owner_da_Oportunidade</targetReference>
            </connector>
            <label>Renovações</label>
        </rules>
        <rules>
            <name>Shirlei</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record__Prior.Owner.Email</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>shirlei.bortoleto@somosagility.com.br</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Atualiza_Owner_da_Oportunidade_2</targetReference>
            </connector>
            <label>Shirlei</label>
        </rules>
    </decisions>
    <description>Quando há alteração do owner da conta, as oportunidades também teem seus owners alterados, baseado no laço de amarração entre conta e oportunidade. Para os usuários renovações e shirlei, essa mudança não pode ocorrer, isto é, se as oportunidades pertencem a estes 2 usuários, devem permanecer imutáveis.</description>
    <environments>Default</environments>
    <interviewLabel>Atualiza Owner da Oportunidade se Renovações ou Shirlei {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Atualiza Owner da Oportunidade se Renovações ou Shirlei</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>FREE_FORM_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Atualiza_Owner_da_Oportunidade</name>
        <label>Atualiza Owner da Oportunidade</label>
        <locationX>1273</locationX>
        <locationY>50</locationY>
        <inputAssignments>
            <field>OwnerId</field>
            <value>
                <stringValue>0050z00000791PmAAI</stringValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>Atualiza_Owner_da_Oportunidade_2</name>
        <label>Atualiza Owner da Oportunidade</label>
        <locationX>1273</locationX>
        <locationY>324</locationY>
        <inputAssignments>
            <field>OwnerId</field>
            <value>
                <stringValue>0050z00000791PmAAI</stringValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>573</locationX>
        <locationY>72</locationY>
        <connector>
            <targetReference>Verifica_ID_do_Owner_da_Oportunidade</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>OwnerId</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>Opportunity</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
