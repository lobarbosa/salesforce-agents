<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>52.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <interviewLabel>Travar Oportunidade {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Travar Oportunidade mapeamento concluido</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>FREE_FORM_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>mapeamento</name>
        <label>mapeamento</label>
        <locationX>176</locationX>
        <locationY>448</locationY>
        <inputAssignments>
            <field>Status_Aprovacao__c</field>
            <value>
                <stringValue>Vencido</stringValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>Travar_OP</name>
        <label>Travar OP</label>
        <locationX>176</locationX>
        <locationY>309</locationY>
        <connector>
            <targetReference>mapeamento</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Oportunidade__r.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Travar_Oportunidade__c</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <object>Opportunity</object>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>50</locationY>
        <connector>
            <targetReference>Travar_OP</targetReference>
        </connector>
        <filterLogic>1 AND (2 or 3)</filterLogic>
        <filters>
            <field>Dias_para_vencimento__c</field>
            <operator>EqualTo</operator>
            <value>
                <numberValue>-1.0</numberValue>
            </value>
        </filters>
        <filters>
            <field>Fase_Oportunidade__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>fechada ganha</stringValue>
            </value>
        </filters>
        <filters>
            <field>Fase_Oportunidade__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>fechada perdida</stringValue>
            </value>
        </filters>
        <object>Mapeamento__c</object>
        <schedule>
            <frequency>Once</frequency>
            <startDate>2021-07-21</startDate>
            <startTime>00:15:00.000Z</startTime>
        </schedule>
        <triggerType>Scheduled</triggerType>
    </start>
    <status>Active</status>
</Flow>
