<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>AlertaAlteracaoOportunidadeSEC</name>
        <label>Opportunity.AlertaAlteracaoOportunidadeSEC</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <actionName>Opportunity.AlertaAlteracaoOportunidadeSEC</actionName>
        <actionType>emailAlert</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>SObjectRowId</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputParameters>
        <nameSegment>Opportunity.AlertaAlteracaoOportunidadeSEC</nameSegment>
    </actionCalls>
    <apiVersion>55.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>Migrado de: regra de fluxo de trabalho Alerta de alteração de oportunidade - Security
Descrição da regra de fluxo de trabalho: Alerta de e-mail enviado caso haja alteração no meu compromisso de fechamento, data de fechamento, One time previsto ou recorrente ajustado previsto desde que o meu compromisso de fechamento da oportunidade seja &quot;Commit&quot;.&quot;</description>
    <label>Alerta de alteração de oportunidade - Security</label>
    <migratedFromWorkflowRuleName>Alerta de alteração de oportunidade - Security</migratedFromWorkflowRuleName>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>AlertaAlteracaoOportunidadeSEC</targetReference>
        </connector>
        <filterFormula>AND( 					 {!$Record.Meu_Compromisso_de_Fechamento__c} = &apos;Commit&apos;, 				    ISPICKVAL({!$Record.Linha_de_Negocio__c}, &apos;SECURITY&apos;),  					    OR( 													ISCHANGED({!$Record.CloseDate}), 													ISCHANGED({!$Record.Certeza_de_Conclus_o__c}), 													ISCHANGED({!$Record.Certeza_de_Vit_ria__c}), 													ISCHANGED({!$Record.Rentabilidade_prevista__c}), 													ISCHANGED({!$Record.Sales_In_Previsto__c}) 										) 				)</filterFormula>
        <object>Opportunity</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
