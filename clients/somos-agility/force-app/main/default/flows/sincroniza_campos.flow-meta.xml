<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>60.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>sincroniza campos com reembolso para mostrar notificação</description>
    <environments>Default</environments>
    <interviewLabel>sincroniza campos {!$Flow.CurrentDateTime}</interviewLabel>
    <label>sincroniza campos</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>FREE_FORM_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>atualiza_solicita_o_reembolso</name>
        <label>atualiza solicitação reembolso</label>
        <locationX>762</locationX>
        <locationY>485</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Solicitacao_de_Reembolso__c</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Despesa_Gerente_de_Projeto__c</field>
            <value>
                <elementReference>$Record.Gerente_do_Projeto__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>despesa_Descri_o__c</field>
            <value>
                <elementReference>$Record.Descricao_da_Despesa__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>despesa_Relacionado_a_entrega__c</field>
            <value>
                <elementReference>$Record.Relacionado_a_entrega__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>despesa_Relacionado_ao_cliente__c</field>
            <value>
                <elementReference>$Record.Relacionado_a_Conta__r.Name</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>despesa_classe__c</field>
            <value>
                <elementReference>$Record.Classe__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>despesa_tipo_de_despesa__c</field>
            <value>
                <elementReference>$Record.Tipo_da_Despesa__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>despesa_total_despesa__c</field>
            <value>
                <elementReference>$Record.Valor_Total_da_Despesa__c</elementReference>
            </value>
        </inputAssignments>
        <object>Solicitacao_de_Reembolso__c</object>
    </recordUpdates>
    <start>
        <locationX>650</locationX>
        <locationY>48</locationY>
        <connector>
            <targetReference>atualiza_solicita_o_reembolso</targetReference>
        </connector>
        <object>Lancamento_de_Despesas__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
