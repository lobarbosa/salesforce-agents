LEFT(
    TEXT(MOD(VALUE(TEXT(NOW())), 1000000)) &amp; 
    TEXT(MOD(VALUE(TEXT(NOW())), 36)) &amp; 
    TEXT(MOD(VALUE(TEXT(NOW())), 36)) &amp; 
    TEXT(MOD(VALUE(TEXT(NOW())), 36)) &amp; 
    TEXT(MOD(VALUE(TEXT(NOW())), 36)) &amp; 
    TEXT(MOD(VALUE(TEXT(NOW())), 36)) &amp; 
    TEXT(MOD(VALUE(TEXT(NOW())), 36)),
    15
)
*/
TEXT(UNIXTIMESTAMP(NOW()) - UNIXTIMESTAMP({!Atribui_um_UUID_aleatorio_para_cada_contato.Data_de_Anivers_rio__c})) + REVERSE({!Atribui_um_UUID_aleatorio_para_cada_contato.FirstName})</expression>
