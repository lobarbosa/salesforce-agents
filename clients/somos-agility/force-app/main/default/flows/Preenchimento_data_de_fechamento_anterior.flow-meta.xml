<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>55.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>Migrado de: regra de fluxo de trabalho Preenchimento data de fechamento anterior
Descrição da regra de fluxo de trabalho: Preenchimento do campo Data de fechamento com o valor antes da atualização para que seja possível ter um rastreamento no modelo de email.&quot;</description>
    <formulas>
        <name>AtualizaDataFechamentoAnteriorFormula</name>
        <dataType>Date</dataType>
        <expression>PRIORVALUE($Record.CloseDate)</expression>
    </formulas>
    <label>Preenchimento data de fechamento anterior</label>
    <migratedFromWorkflowRuleName>Preenchimento data de fechamento anterior</migratedFromWorkflowRuleName>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <description>Atualização do campo &quot;data de fechamento anterior&quot; com o valor anterior do campo &quot;data de fechamento&quot;.</description>
        <name>mainUpdate</name>
        <label>mainUpdate</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>Data_de_Fechamento_Anterior__c</field>
            <value>
                <elementReference>AtualizaDataFechamentoAnteriorFormula</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>mainUpdate</targetReference>
        </connector>
        <filterFormula>ISCHANGED({!$Record.Meu_Compromisso_de_Fechamento__c})</filterFormula>
        <object>Opportunity</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
