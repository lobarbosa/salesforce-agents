            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <description>Atualização do campo &quot;Previsto RR ajustado (Valor Anterior)&quot; com o valor anterior do campo &quot;Recorrente ajustado previsto&quot;.</description>
        <name>mainUpdate</name>
        <label>mainUpdate</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>PrevistoRRAjustadoValorAnterior__c</field>
