    <description>Envia a notificação da ativação de serviços do contrato, inclusos os times envolvidos - Atualizado em 18/08/2025.</description>
    <environments>Default</environments>
    <formulas>
        <name>motivo_da_ativacao</name>
        <dataType>String</dataType>
        <expression>&apos;Início dos serviços referentes ao contrato &quot;&apos; + {!$Record.Contrato__r.Descri_ao_do_Contrato__c} + &apos;&quot;.&apos;</expression>
    </formulas>
    <formulas>
        <name>primeiro_email</name>
        <dataType>String</dataType>
        <expression>IF(
  CONTAINS({!$Record.Destinatarios__c}, &quot;;&quot;),
  LEFT({!$Record.Destinatarios__c}, FIND(&quot;;&quot;, {!$Record.Destinatarios__c}) - 1),
  {!$Record.Destinatarios__c}
)</expression>
    </formulas>
    <formulas>
        <name>primeiro_time</name>
        <dataType>String</dataType>
        <expression>LEFT(
   {!$Record.E_mail_time_envolvido__c},
   IF(CONTAINS({!$Record.E_mail_time_envolvido__c}, &quot;;&quot;), FIND(&quot;;&quot;, {!$Record.E_mail_time_envolvido__c}) - 1, LEN({!$Record.E_mail_time_envolvido__c}))
)</expression>
    </formulas>
    <formulas>
        <name>segundo_email</name>
        <dataType>String</dataType>
        <expression>IF(
  CONTAINS({!$Record.Destinatarios__c}, &quot;;&quot;),
  IF(
    CONTAINS(RIGHT({!$Record.Destinatarios__c}, LEN({!$Record.Destinatarios__c}) - FIND(&quot;;&quot;, {!$Record.Destinatarios__c})), &quot;;&quot;),
    LEFT(
      RIGHT({!$Record.Destinatarios__c}, LEN({!$Record.Destinatarios__c}) - FIND(&quot;;&quot;, {!$Record.Destinatarios__c})),
      FIND(&quot;;&quot;, RIGHT({!$Record.Destinatarios__c}, LEN({!$Record.Destinatarios__c}) - FIND(&quot;;&quot;, {!$Record.Destinatarios__c})) ) - 1
    ),
    RIGHT({!$Record.Destinatarios__c}, LEN({!$Record.Destinatarios__c}) - FIND(&quot;;&quot;, {!$Record.Destinatarios__c}))
  ),
  &quot;&quot;
)</expression>
    </formulas>
    <formulas>
        <name>segundo_time</name>
        <dataType>String</dataType>
        <expression>IF(
   CONTAINS({!$Record.E_mail_time_envolvido__c}, &quot;;&quot;),
   MID(
      {!$Record.E_mail_time_envolvido__c},
      FIND(&quot;;&quot;, {!$Record.E_mail_time_envolvido__c}) + 1,
      IF(CONTAINS(MID({!$Record.E_mail_time_envolvido__c}, FIND(&quot;;&quot;, {!$Record.E_mail_time_envolvido__c}) + 1, LEN({!$Record.E_mail_time_envolvido__c})), &quot;;&quot;),
         FIND(&quot;;&quot;, MID({!$Record.E_mail_time_envolvido__c}, FIND(&quot;;&quot;, {!$Record.E_mail_time_envolvido__c}) + 1, LEN({!$Record.E_mail_time_envolvido__c}))) - 1,
         LEN(MID({!$Record.E_mail_time_envolvido__c}, FIND(&quot;;&quot;, {!$Record.E_mail_time_envolvido__c}) + 1, LEN({!$Record.E_mail_time_envolvido__c})))
      )
   ),
   &quot;&quot;
)</expression>
    </formulas>
    <formulas>
        <name>terceiro_email</name>
        <dataType>String</dataType>
        <expression>IF(
  LEN(SUBSTITUTE({!$Record.Destinatarios__c}, &quot;;&quot;, &quot;&quot;)) = LEN({!$Record.Destinatarios__c}),
  &quot;&quot;,
  IF(
    LEN(SUBSTITUTE({!$Record.Destinatarios__c}, &quot;;&quot;, &quot;&quot;)) = LEN({!$Record.Destinatarios__c}) - 1,
    &quot;&quot;,
    RIGHT(
      {!$Record.Destinatarios__c},
      LEN({!$Record.Destinatarios__c}) - FIND(&quot;;&quot;, {!$Record.Destinatarios__c}, FIND(&quot;;&quot;, {!$Record.Destinatarios__c}) + 1)
    )
  )
)</expression>
    </formulas>
    <formulas>
        <name>terceiro_time</name>
        <dataType>String</dataType>
        <expression>IF(
   AND(CONTAINS({!$Record.E_mail_time_envolvido__c}, &quot;;&quot;), CONTAINS(MID({!$Record.E_mail_time_envolvido__c}, FIND(&quot;;&quot;, {!$Record.E_mail_time_envolvido__c}) + 1, LEN({!$Record.E_mail_time_envolvido__c})), &quot;;&quot;)),
   MID(
      {!$Record.E_mail_time_envolvido__c},
      FIND(&quot;;&quot;, {!$Record.E_mail_time_envolvido__c}, FIND(&quot;;&quot;, {!$Record.E_mail_time_envolvido__c}) + 1) + 1,
      IF(CONTAINS(MID({!$Record.E_mail_time_envolvido__c}, FIND(&quot;;&quot;, {!$Record.E_mail_time_envolvido__c}, FIND(&quot;;&quot;, {!$Record.E_mail_time_envolvido__c}) + 1) + 1, LEN({!$Record.E_mail_time_envolvido__c})), &quot;;&quot;),
         FIND(&quot;;&quot;, MID({!$Record.E_mail_time_envolvido__c}, FIND(&quot;;&quot;, {!$Record.E_mail_time_envolvido__c}, FIND(&quot;;&quot;, {!$Record.E_mail_time_envolvido__c}) + 1) + 1, LEN({!$Record.E_mail_time_envolvido__c}))) - 1,
         LEN(MID({!$Record.E_mail_time_envolvido__c}, FIND(&quot;;&quot;, {!$Record.E_mail_time_envolvido__c}, FIND(&quot;;&quot;, {!$Record.E_mail_time_envolvido__c}) + 1) + 1, LEN({!$Record.E_mail_time_envolvido__c})))
      )
   ),
   &quot;&quot;
)</expression>
    </formulas>
