<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Campo_cidade_obrigatorio</fullName>
    <active>true</active>
    <description>Campo &quot;Cidade&quot; obrigatório.</description>
    <errorConditionFormula>AND(
  ISBLANK( City ),
  TEXT(LeadSource) != &quot;RD Station&quot;
)</errorConditionFormula>
    <errorDisplayField>City</errorDisplayField>
    <errorMessage>Campo &quot;Cidade&quot; obrigatório.</errorMessage>
</ValidationRule>
