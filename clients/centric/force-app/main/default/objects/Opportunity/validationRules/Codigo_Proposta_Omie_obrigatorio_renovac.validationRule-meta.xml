<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Codigo_Proposta_Omie_obrigatorio_renovac</fullName>
    <active>false</active>
    <errorConditionFormula>AND(
  ISPICKVAL(StageName, &quot;Fechado&quot;),
  ISBLANK(CodigoIntegracao__c ),
  ISPICKVAL(Omie_Codigo_Categoria__c, &quot;1.01.99&quot;)
)</errorConditionFormula>
    <errorDisplayField>CodigoIntegracao__c</errorDisplayField>
    <errorMessage>Em caso de renovação, código da Oportunidade original no Omie deve ser informado.</errorMessage>
</ValidationRule>
