<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>60.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>Flow calcula o preço de venda de cada Produto da Oportunidade, para que valor seja passado corretamente para o Omie (considerando as casas decimais de dólar). Roda às 20:00 BRT.</description>
    <environments>Default</environments>
    <formulas>
        <name>salesPriceOmie</name>
        <dataType>Number</dataType>
        <expression>{!conversionDolar} * {!$Record.UnitPrice}</expression>
        <scale>6</scale>
    </formulas>
    <interviewLabel>[Produto da Oportunidade] - Sales Price Omie - 20:00 BRT {!$Flow.CurrentDateTime}</interviewLabel>
    <label>[Produto da Oportunidade] - Sales Price Omie - 20:00 BRT</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <description>Busca a moeda tipo dolar, realiza a conversão e salva na variável conversionDolar</description>
        <name>Obter_Cotacao_do_Dolar</name>
        <label>Obter Cotação do Dólar</label>
        <locationX>176</locationX>
        <locationY>252</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Atualizar_Produto_da_Oportunidade</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>IsoCode</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>BRL</stringValue>
            </value>
        </filters>
        <object>CurrencyType</object>
        <outputAssignments>
            <assignToReference>conversionDolar</assignToReference>
            <field>ConversionRate</field>
        </outputAssignments>
    </recordLookups>
    <recordUpdates>
        <description>Atualiza Produto da Oportunidade que acionou o fluxo.</description>
        <name>Atualizar_Produto_da_Oportunidade</name>
        <label>Atualizar Produto da Oportunidade</label>
        <locationX>176</locationX>
        <locationY>360</locationY>
        <inputAssignments>
            <field>Sales_Price_Omie__c</field>
            <value>
                <elementReference>salesPriceOmie</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Obter_Cotacao_do_Dolar</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>CurrencyIsoCode</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>USD</stringValue>
            </value>
        </filters>
        <filters>
            <field>Oportunidade_fechada__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>OpportunityLineItem</object>
        <schedule>
            <frequency>Daily</frequency>
            <startDate>2024-05-17</startDate>
            <startTime>20:00:00.000Z</startTime>
        </schedule>
        <triggerType>Scheduled</triggerType>
    </start>
    <status>Obsolete</status>
    <variables>
        <name>conversionDolar</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <scale>6</scale>
    </variables>
    <variables>
        <name>opportunityLineItem</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>OpportunityLineItem</objectType>
    </variables>
</Flow>
