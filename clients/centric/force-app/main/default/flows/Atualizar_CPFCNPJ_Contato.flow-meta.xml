<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>59.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>Flow passa alguns campos que existem em Conta para Contato, quando Contato é criado.</description>
    <environments>Default</environments>
    <interviewLabel>Atualizar CPFCNPJ Contato {!$Flow.CurrentDateTime}</interviewLabel>
    <label>[Contato] - Passar dados de Conta para Contato</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <description>Atualizar Contato com informações vindas da Conta relacionada.</description>
        <name>Atualizar_Contato</name>
        <label>Atualizar Contato</label>
        <locationX>176</locationX>
        <locationY>323</locationY>
        <inputAssignments>
            <field>Bairro__c</field>
            <value>
                <elementReference>$Record.Account.Bairro__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>CEP__c</field>
            <value>
                <elementReference>$Record.Account.CEP__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Endere_o__c</field>
            <value>
                <elementReference>$Record.Account.Endere_o__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Estado__c</field>
            <value>
                <elementReference>$Record.Account.Estado__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>N_mero__c</field>
            <value>
                <elementReference>$Record.Account.N_mero__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Raz_o_Social__c</field>
            <value>
                <elementReference>$Record.Account.Raz_o_Social__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>cpfcnpj__c</field>
            <value>
                <elementReference>$Record.Account.cpfcnpj__c</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Atualizar_Contato</targetReference>
        </connector>
        <object>Contact</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
