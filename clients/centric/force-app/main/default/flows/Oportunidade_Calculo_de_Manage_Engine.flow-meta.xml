    <description>Flow faz o cálculo de Manage Engine (uma regra de três com uma média ponderada considerando a multiplicação do valor de licenças em cada produto vezes o valor de lista de cada produto).</description>
    <environments>Default</environments>
    <formulas>
        <name>calculo_ME</name>
        <dataType>Currency</dataType>
        <expression>(({!maior_preco} - {!menor_preco}) / {!menor_numero_de_licencas}) * ({!Numero_de_licencas_pedido} - {!menor_numero_de_licencas}) + {!menor_preco}</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>maior_numero_de_licencas</name>
        <dataType>Number</dataType>
        <expression>max({!Numero_de_licencas1}, {!Numero_de_licencas2})</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>maior_preco</name>
        <dataType>Currency</dataType>
        <expression>max({!Preco_de_lista1}, {!Preco_de_lista2})</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>menor_numero_de_licencas</name>
        <dataType>Number</dataType>
        <expression>min({!Numero_de_licencas1}, {!Numero_de_licencas2})</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>menor_preco</name>
        <dataType>Currency</dataType>
        <expression>min({!Preco_de_lista1}, {!Preco_de_lista2})</expression>
        <scale>2</scale>
    </formulas>
