        <name>Moeda_da_Oportunidade_a_mesma_dos_produtos</name>
        <label>Moeda da Oportunidade é a mesma dos produtos?</label>
        <locationX>182</locationX>
        <locationY>674</locationY>
        <defaultConnector>
