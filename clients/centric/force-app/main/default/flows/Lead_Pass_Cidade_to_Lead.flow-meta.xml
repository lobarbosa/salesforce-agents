<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>60.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>Flow busca a City do Lead no objeto &quot;Cidade&quot;, para que dado seja passado corretamente na integração com o Omie.</description>
    <environments>Default</environments>
    <interviewLabel>[Lead] - Pass Cidade to Lead {!$Flow.CurrentDateTime}</interviewLabel>
    <label>[Lead] - Passar Cidade para Conta</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <description>Componente busca a cidade do Lead no objeto &quot;Cidade&quot;</description>
        <name>Obter_Cidade</name>
        <label>Obter Cidade</label>
        <locationX>176</locationX>
        <locationY>287</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Atualizar_Lead_com_Cidade</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>cNome__c</field>
            <operator>Contains</operator>
            <value>
                <elementReference>$Record.City</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Cidade__c</object>
        <queriedFields>Id</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <description>Atualiza o Lead que acionou o fluxo, passando o valor buscado para a variável Cidade2__c</description>
        <name>Atualizar_Lead_com_Cidade</name>
        <label>Atualizar Lead com Cidade</label>
        <locationX>176</locationX>
        <locationY>395</locationY>
        <inputAssignments>
            <field>Cidade2__c</field>
            <value>
                <elementReference>Obter_Cidade.Id</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Obter_Cidade</targetReference>
        </connector>
        <filterFormula>OR(
  AND(
  ISNEW(), NOT(ISNULL({!$Record.City}) ))
, ISCHANGED({!$Record.City})
)</filterFormula>
        <object>Lead</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
