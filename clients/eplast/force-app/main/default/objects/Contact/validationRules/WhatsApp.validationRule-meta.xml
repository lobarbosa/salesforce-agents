<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>WhatsApp</fullName>
    <active>true</active>
    <errorConditionFormula>NOT(
OR(
ISBLANK(WhatsApp__c ),

REGEX(WhatsApp__c , &quot;\\([0-9]{2}\\)\\s?[0-9]{4,5}-?[0-9]{4}&quot;)
)
)</errorConditionFormula>
    <errorDisplayField>WhatsApp__c</errorDisplayField>
    <errorMessage>O formato do Celular deve ser: (xx)xxxxxxxx ou (xx)xxxxxxxxx</errorMessage>
</ValidationRule>
