<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Contato_Fiscal</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    !ISBLANK(TaxContact__c),
    NOT(REGEX(TaxContact__c , &quot;\\(\\d{2}\\)\\s?9?\\d{4}-?\\d{4}&quot;))
)</errorConditionFormula>
    <errorDisplayField>TaxContact__c</errorDisplayField>
    <errorMessage>O formato do campo Contato Fiscal deve ser: (xx)xxxxxxxx ou (xx)xxxxxxxxx</errorMessage>
</ValidationRule>
