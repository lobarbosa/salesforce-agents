<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Celular</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    !ISBLANK(MobilePhone__c),
    NOT(REGEX(MobilePhone__c , &quot;\\(\\d{2}\\)\\s?9?\\d{4}-?\\d{4}&quot;))
)</errorConditionFormula>
    <errorDisplayField>MobilePhone__c</errorDisplayField>
    <errorMessage>O formato do campo Celular deve ser: (xx)xxxxxxxx ou (xx)xxxxxxxxx</errorMessage>
</ValidationRule>
