<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>TaxAnalysis</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
ISPICKVAL(StageName, &apos;Fechado/Ganho&apos;),
NOT(  TaxAnalysis__c  )
) &amp;&amp; NomeTipoRegistro__c != &apos;Industria&apos;</errorConditionFormula>
    <errorMessage>A Fase Análise Fiscal precisa ser iniciada e concluída para continuidade do processo.</errorMessage>
</ValidationRule>
