<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>CheckAccountHasPhone</fullName>
    <active>true</active>
    <errorConditionFormula>ISBLANK(Account.Phone)</errorConditionFormula>
    <errorMessage>Por favor, preencha o campo Telefone da Conta selecionada</errorMessage>
</ValidationRule>
