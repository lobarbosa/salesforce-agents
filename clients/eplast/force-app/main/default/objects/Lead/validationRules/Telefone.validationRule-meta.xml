<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Telefone</fullName>
    <active>true</active>
    <errorConditionFormula>NOT(
OR(
ISBLANK( Phone ),

REGEX(Phone , &quot;\\([0-9]{2}\\)[0-9]{4}[0-9]{4}&quot;)
)
)</errorConditionFormula>
    <errorDisplayField>Phone</errorDisplayField>
    <errorMessage>O formato do telefone deve ser: (xx)xxxxxxxx</errorMessage>
</ValidationRule>
