    <formulas>
        <name>IsShipmentSaleType</name>
        <dataType>String</dataType>
        <expression>IF(
  {!Quote.Opportunity.RecordTypeId} = {!SellWithShipping.Id},
  IF(
    ISPICKVAL({!Quote.Opportunity.Account.IsBlowerCustomer__c}, &apos;Sim&apos;),
    &apos;isBlowerCustomer&apos;,
    IF(
      ISPICKVAL({!Quote.Opportunity.Account.IsBlowerCustomer__c}, &apos;Não&apos;),
      &apos;isNotBlowerCustomer&apos;,
      &apos;isCustomer&apos;
    )
  ),
  &apos;isCustomer&apos;
)</expression>
    </formulas>
