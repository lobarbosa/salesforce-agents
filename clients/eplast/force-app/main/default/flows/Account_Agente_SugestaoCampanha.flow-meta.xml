                <targetReference>GetSetReativ</targetReference>
            </connector>
            <label>Encontrada</label>
        </rules>
    </decisions>
    <decisions>
        <name>CheckSignals</name>
        <label>Há sinais de cruzada?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>DecideResult</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Padrão</defaultConnectorLabel>
        <rules>
            <name>HasSignals</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>SignalCount</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>LoopSignals</targetReference>
            </connector>
            <label>Há sinais</label>
        </rules>
    </decisions>
    <decisions>
        <name>CheckNewerDate</name>
        <label>Data mais recente?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>LoopSignals</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Padrão</defaultConnectorLabel>
        <rules>
            <name>IsNewer</name>
            <conditionLogic>1 OR 2</conditionLogic>
            <conditions>
                <leftValueReference>MaxCalcDate</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>LoopSignals.CalculationDate__c</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <elementReference>MaxCalcDate</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>SetMaxDate</targetReference>
            </connector>
            <label>Mais recente</label>
        </rules>
    </decisions>
    <decisions>
        <name>CheckGroupKnown</name>
