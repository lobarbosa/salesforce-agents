            <label>Já listado</label>
        </rules>
    </decisions>
    <decisions>
        <name>DecideResult</name>
        <label>Quais campanhas se aplicam?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>CheckSemHistorico</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Padrão</defaultConnectorLabel>
        <rules>
            <name>BothApply</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>ReativApplies</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>MixApplies</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>CheckOrder</targetReference>
            </connector>
            <label>As duas</label>
        </rules>
        <rules>
            <name>OnlyReativ</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>ReativApplies</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>SetReativ</targetReference>
            </connector>
            <label>Só reativação</label>
        </rules>
        <rules>
            <name>OnlyMix</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>MixApplies</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>SetMix</targetReference>
            </connector>
            <label>Só ampliação de mix</label>
        </rules>
    </decisions>
    <decisions>
        <name>CheckOrder</name>
        <label>Qual vem primeiro?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>SetBothReativFirst</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Padrão</defaultConnectorLabel>
        <rules>
            <name>MixFirst</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>MixPriority</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <elementReference>ReativPriority</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>SetBothMixFirst</targetReference>
            </connector>
            <label>Ampliação primeiro</label>
        </rules>
    </decisions>
    <decisions>
        <name>CheckSemHistorico</name>
        <label>Sem histórico?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>SetNone</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Padrão</defaultConnectorLabel>
        <rules>
            <name>NoHistory</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>GetAccount.LastPurchase__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>SignalCount</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>SetSemHistorico</targetReference>
            </connector>
            <label>Sem histórico</label>
        </rules>
    </decisions>
    <description>EPLAST-46. Autolancado, sem gatilho e sem DML. Monta a lista de campanhas sugeridas para uma conta (reativacao por Account.Inactive__c e ampliacao de mix pelos sinais CommercialSignal__c Cruzada da EPLAST-33), com contagem de contatos elegiveis por canal respeitando opt-out. Chamado pela acao SugestaoCampanha_EPLAST46 do SFAgent2. Nao envia nada: o disparo e do Marketing Cloud. Acesso pela custom permission SugestaoCampanha_EPLAST46.</description>
    <formulas>
        <name>CurrentGroup</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!LoopProducts.Group__c}), "sem grupo", {!LoopProducts.Group__c})</expression>
    </formulas>
    <formulas>
        <name>DaysSince</name>
        <dataType>Number</dataType>
        <expression>TODAY() - {!GetAccount.LastPurchase__c}</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>BandReport</name>
        <dataType>String</dataType>
        <expression>IF({!DaysSince} &lt;= 180, "SEM COMPRA - 91 A 180 DIAS", IF({!DaysSince} &lt;= 365, "SEM COMPRA - 181 A 365 DIAS", "SEM COMPRA - MAIS DE 365 DIAS"))</expression>
    </formulas>
    <formulas>
        <name>ChannelText</name>
        <dataType>String</dataType>
        <expression>"Contatos elegíveis: " &amp; IF({!EmailCount} = 0, "sem contato elegível para e-mail", TEXT({!EmailCount}) &amp; " para e-mail") &amp; "; " &amp; IF({!MsgCount} = 0, "sem contato elegível para mensagem", TEXT({!MsgCount}) &amp; " para mensagem") &amp; "."</expression>
    </formulas>
    <formulas>
        <name>GroupsDisplay</name>
        <dataType>String</dataType>
        <expression>IF(LEFT({!GroupsText}, 2) = ", ", MID({!GroupsText}, 3, 500), {!GroupsText})</expression>
    </formulas>
    <formulas>
        <name>MaxCalcDateText</name>
        <dataType>String</dataType>
        <expression>TEXT({!MaxCalcDate})</expression>
    </formulas>
    <formulas>
        <name>MixApplies</name>
        <dataType>Boolean</dataType>
        <expression>AND({!GetSetMix.Active__c} = true, {!SignalCount} &gt; 0)</expression>
    </formulas>
    <formulas>
        <name>MixPriority</name>
        <dataType>Number</dataType>
        <expression>{!GetSetMix.Priority__c}</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>ReativApplies</name>
        <dataType>Boolean</dataType>
        <expression>AND({!GetSetReativ.Active__c} = true, {!GetAccount.Inactive__c} = true)</expression>
    </formulas>
    <formulas>
        <name>ReativPriority</name>
        <dataType>Number</dataType>
        <expression>{!GetSetReativ.Priority__c}</expression>
        <scale>0</scale>
    </formulas>
