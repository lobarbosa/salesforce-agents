    <decisions>
        <name>CheckAccess</name>
        <label>Tem a custom permission?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>SetNoAccess</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Padrão</defaultConnectorLabel>
        <rules>
            <name>HasAccess</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Permission.SugestaoCampanha_EPLAST46</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>GetAccount</targetReference>
            </connector>
            <label>Tem acesso</label>
        </rules>
    </decisions>
    <decisions>
        <name>CheckAccountFound</name>
