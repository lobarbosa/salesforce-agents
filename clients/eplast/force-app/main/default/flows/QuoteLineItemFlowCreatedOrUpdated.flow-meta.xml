    <decisions>
        <name>CheckPrice</name>
        <label>Verificar preço</label>
        <locationX>314</locationX>
        <locationY>731</locationY>
        <defaultConnectorLabel>Resultado padrão</defaultConnectorLabel>
        <rules>
            <name>UnitPriceIsChanged</name>
            <conditionLogic>(5 AND 1 AND 2 AND (3 OR 4)) OR (8 AND 6 AND 2 AND (7 OR 4)) OR (9 AND 10)</conditionLogic>
            <conditions>
                <leftValueReference>$Record.AmountNoIPI__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>$Record.PricebookEntry.UnitPrice</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Quote.SubmittedForApproval__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.AmountNoIPI__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>IsNew</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Quote.HasCPQ__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.UnitPrice</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>$Record.PricebookEntry.UnitPrice</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.UnitPrice</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Quote.HasCPQ__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>OpportunityPaymentWayIsAV</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Discount</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>1.4</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>SubmitQuoteForApproval</targetReference>
            </connector>
            <label>Valor de Venda Alterado</label>
        </rules>
    </decisions>
    <decisions>
        <name>UpdatedField</name>
        <label>Campo atualizado</label>
        <locationX>314</locationX>
        <locationY>323</locationY>
        <defaultConnector>
            <targetReference>PublishEvent</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Resultado padrão</defaultConnectorLabel>
        <rules>
            <name>QuantityIsChanged</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>MainQuantityIsChanged</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>UpdateSecondQuantity</targetReference>
            </connector>
            <label>Quantidade é alterada</label>
        </rules>
        <rules>
            <name>SecondQuantityIsChanged</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>SecondQuantityChangedFormula</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>UpdateMainQuantity</targetReference>
            </connector>
            <label>Segunda Quantidade é Alterada</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>ChangeMainQuantity</name>
        <dataType>Number</dataType>
        <expression>IF( {!$Record.Product2.QuantityConverter__c}&gt;0, {!$Record.SecondUnitQuantity__c} * {!$Record.Product2.QuantityConverter__c}, 1 )</expression>
        <scale>4</scale>
    </formulas>
    <formulas>
        <name>ChangeSecondQuantity</name>
        <dataType>Number</dataType>
        <expression>IF( {!$Record.Product2.QuantityConverter__c}&gt;0, {!$Record.Quantity} / {!$Record.Product2.QuantityConverter__c}, 0 )</expression>
        <scale>4</scale>
    </formulas>
    <formulas>
        <name>IsNew</name>
        <dataType>Boolean</dataType>
        <expression>ISNEW()</expression>
    </formulas>
    <formulas>
        <name>MainQuantityIsChanged</name>
        <dataType>Boolean</dataType>
        <expression>OR (ISCHANGED( {!$Record.Quantity} ), ISNEW() )</expression>
    </formulas>
    <formulas>
        <name>OpportunityPaymentWayIsAV</name>
        <dataType>Boolean</dataType>
        <expression>INCLUDES({!$Record.Quote.Opportunity.Formas_de_Pagamento__c}, &apos;AV&apos;)</expression>
    </formulas>
    <formulas>
        <name>SecondQuantityChangedFormula</name>
        <dataType>Boolean</dataType>
        <expression>ISCHANGED( {!$Record.SecondUnitQuantity__c} )</expression>
    </formulas>
