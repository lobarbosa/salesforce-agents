    <formulas>
        <name>AssuntoVazio</name>
        <description>Verdadeiro se o assunto estiver vazio ou so com espacos.</description>
        <dataType>Boolean</dataType>
        <expression>ISBLANK(TRIM({!Assunto}))</expression>
    </formulas>
    <formulas>
        <name>AssuntoCheckIn</name>
        <description>Verdadeiro se o assunto comecar com Check In @ (sem diferenciar maiusculas).</description>
        <dataType>Boolean</dataType>
        <expression>BEGINS(LOWER(TRIM({!Assunto})), "check in @")</expression>
    </formulas>
    <formulas>
        <name>DesligadoOuSemParametro</name>
        <description>Verdadeiro se nao ha registro Padrao de parametros ou se Ativo__c esta desmarcado.</description>
        <dataType>Boolean</dataType>
        <expression>OR(ISBLANK({!ParametrosTarefa.Id}), NOT({!ParametrosTarefa.Ativo__c}))</expression>
    </formulas>
    <formulas>
        <name>DescricaoExigidaVazia</name>
        <description>Verdadeiro se DescricaoObrigatoria__c esta marcado e a descricao veio vazia ou so com espacos.</description>
        <dataType>Boolean</dataType>
        <expression>AND({!ParametrosTarefa.DescricaoObrigatoria__c}, ISBLANK(TRIM({!Descricao})))</expression>
    </formulas>
    <formulas>
        <name>EhLead</name>
        <description>Verdadeiro se o Id comeca com 00Q (Lead).</description>
        <dataType>Boolean</dataType>
        <expression>LEFT({!RegistroRelacionadoId}, 3) = "00Q"</expression>
    </formulas>
    <formulas>
        <name>LeadNaoAchado</name>
        <description>Verdadeiro se o Get do Lead nao devolveu registro.</description>
        <dataType>Boolean</dataType>
        <expression>ISBLANK({!RegistroLead.Id})</expression>
    </formulas>
    <formulas>
        <name>EhConta</name>
        <description>Verdadeiro se o Id comeca com 001 (Account).</description>
        <dataType>Boolean</dataType>
        <expression>LEFT({!RegistroRelacionadoId}, 3) = "001"</expression>
    </formulas>
    <formulas>
        <name>RegistroInvalido</name>
        <description>Verdadeiro se o Id nao tiver 15/18 caracteres, nao for de Account (001), Opportunity (006) ou Lead (00Q), ou o prefixo nao estiver em PrefixosPermitidos__c.</description>
        <dataType>Boolean</dataType>
        <expression>OR(ISBLANK({!RegistroRelacionadoId}), AND(LEN({!RegistroRelacionadoId}) &lt;&gt; 15, LEN({!RegistroRelacionadoId}) &lt;&gt; 18), AND(LEFT({!RegistroRelacionadoId}, 3) &lt;&gt; "001", LEFT({!RegistroRelacionadoId}, 3) &lt;&gt; "006", LEFT({!RegistroRelacionadoId}, 3) &lt;&gt; "00Q"), NOT(CONTAINS(";" &amp; {!ParametrosTarefa.PrefixosPermitidos__c} &amp; ";", ";" &amp; LEFT({!RegistroRelacionadoId}, 3) &amp; ";")))</expression>
    </formulas>
    <formulas>
        <name>DataVazia</name>
        <description>Verdadeiro se a data de vencimento nao foi informada.</description>
        <dataType>Boolean</dataType>
        <expression>ISBLANK({!DataVencimento})</expression>
    </formulas>
    <formulas>
        <name>ContaNaoAchada</name>
        <description>Verdadeiro se o Get da Account nao devolveu registro.</description>
        <dataType>Boolean</dataType>
        <expression>ISBLANK({!RegistroConta.Id})</expression>
    </formulas>
    <formulas>
        <name>OppNaoAchada</name>
        <description>Verdadeiro se o Get da Opportunity nao devolveu registro.</description>
        <dataType>Boolean</dataType>
        <expression>ISBLANK({!RegistroOportunidade.Id})</expression>
    </formulas>
    <formulas>
        <name>PrioridadeFinal</name>
        <description>High ou Normal se o agente enviou; qualquer outro valor ou vazio vira PrioridadePadrao__c.</description>
        <dataType>String</dataType>
        <expression>IF(LOWER(TRIM({!Prioridade})) = "high", "High", IF(LOWER(TRIM({!Prioridade})) = "normal", "Normal", {!ParametrosTarefa.PrioridadePadrao__c}))</expression>
    </formulas>
    <formulas>
        <name>DescricaoFinal</name>
        <description>Descricao recebida + linha final de origem vinda de MarcaOrigem__c (rastreabilidade, AC-8).</description>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!Descricao}), "", {!Descricao} &amp; BR() &amp; BR()) &amp; {!ParametrosTarefa.MarcaOrigem__c}</expression>
    </formulas>
