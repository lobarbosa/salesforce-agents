    <description>EPLAST-29 (v2). Autolaunched chamado pelo agente SFAgent2 (topico acoes_comerciais). Cria UMA Task para o usuario que pediu, ligada a lead (WhoId), conta ou oportunidade (WhatId), depois de confirmacao no chat. Parametros lidos de AssistenteTarefaSetting__mdt (registro Padrao). Recusa assunto vazio, assunto Check In @, registro fora dos prefixos permitidos, lead convertido, data vazia e descricao vazia quando obrigatoria. Nao grava em nenhum outro objeto, nao envia e-mail.</description>
    <decisions>
        <name>DecParametros</name>
        <label>Assistente ativo?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <description>Guarda 0: recusa se nao ha registro Padrao de parametros ou se Ativo__c esta desmarcado.</description>
        <defaultConnector><targetReference>DecAssuntoVazio</targetReference></defaultConnector>
        <defaultConnectorLabel>Ativo</defaultConnectorLabel>
        <rules>
            <name>DecParametros_R</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>DesligadoOuSemParametro</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue><booleanValue>true</booleanValue></rightValue>
            </conditions>
            <connector><targetReference>FalhaDesligado</targetReference></connector>
            <label>Desligado</label>
        </rules>
    </decisions>
    <decisions>
