        <defaultConnector><targetReference>DecObjeto</targetReference></defaultConnector>
        <defaultConnectorLabel>Nao</defaultConnectorLabel>
        <rules>
            <name>DecDescricao_R</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>DescricaoExigidaVazia</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue><booleanValue>true</booleanValue></rightValue>
            </conditions>
            <connector><targetReference>FalhaDescricao</targetReference></connector>
            <label>Sim</label>
        </rules>
    </decisions>
