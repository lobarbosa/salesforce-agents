    <description>EPLAST-30 (design rev. 2, opção E). Ponto de entrada do apoio a propostas, follow-ups e argumentos comerciais via IA. Só leitura: zero criação, atualização ou exclusão de registro, e-mail ou aprovação. Lê Opportunity, Account, cotação primária (SBQQ__Quote__c) e até 50 linhas (SBQQ__QuoteLine__c) com Get Records no contexto do usuário (CRUD, FLS e sharing aplicados), monta o texto de dados e o passa ao template Flex escolhido pela ação de Prompt Template. Sem acesso ao registro, mostra negativa e não chama o modelo. Acesso restrito pelo PSG PSG_Comercial_RascunhoIA. Ver demandas/EPLAST-30/03-design.md seções 3.2 a 3.4. EPLAST-41 (v2): texto gerado exposto como saída (varTextoGerado) para o Flow Task_Screen_RascunhoRelacionamento; continua só leitura.</description>
    <environments>Default</environments>
    <formulas>
        <name>fDadosCotacao</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!varQuote.Id}),&quot;sem cotação&quot;,&quot;Status da cotação: &quot;&amp;IF(ISBLANK(TEXT({!varQuote.SBQQ__Status__c})),&quot;[dado ausente: Status da cotação]&quot;,TEXT({!varQuote.SBQQ__Status__c}))&amp;CHR(10)&amp;&quot;Valor líquido da cotação: &quot;&amp;IF(ISBLANK({!varQuote.SBQQ__NetAmount__c}),&quot;[dado ausente: Valor líquido da cotação]&quot;,TEXT({!varQuote.CurrencyIsoCode})&amp;&quot; &quot;&amp;SUBSTITUTE(TEXT({!varQuote.SBQQ__NetAmount__c}),&quot;.&quot;,&quot;,&quot;))&amp;CHR(10)&amp;&quot;Condição de pagamento: &quot;&amp;IF(ISBLANK(TEXT({!varQuote.SBQQ__PaymentTerms__c})),&quot;[dado ausente: Condição de pagamento]&quot;,TEXT({!varQuote.SBQQ__PaymentTerms__c}))&amp;CHR(10)&amp;&quot;Validade da cotação: &quot;&amp;IF(ISBLANK({!varQuote.SBQQ__ExpirationDate__c}),&quot;[dado ausente: Validade da cotação]&quot;,TEXT(DAY({!varQuote.SBQQ__ExpirationDate__c}))&amp;&quot;/&quot;&amp;TEXT(MONTH({!varQuote.SBQQ__ExpirationDate__c}))&amp;&quot;/&quot;&amp;TEXT(YEAR({!varQuote.SBQQ__ExpirationDate__c})))&amp;CHR(10)&amp;&quot;Desconto do cliente: &quot;&amp;IF(ISBLANK({!varQuote.SBQQ__CustomerDiscount__c}),&quot;[dado ausente: Desconto do cliente]&quot;,SUBSTITUTE(TEXT({!varQuote.SBQQ__CustomerDiscount__c}),&quot;.&quot;,&quot;,&quot;)&amp;&quot;%&quot;)&amp;CHR(10)&amp;&quot;Quantidade de linhas: &quot;&amp;IF(ISBLANK({!varQuote.SBQQ__LineItemCount__c}),&quot;[dado ausente: Quantidade de linhas]&quot;,SUBSTITUTE(TEXT({!varQuote.SBQQ__LineItemCount__c}),&quot;.&quot;,&quot;,&quot;))&amp;CHR(10)&amp;&quot;Linhas (maior total líquido primeiro):&quot;&amp;CHR(10)&amp;IF({!varContador}=0,&quot;[dado ausente: linhas da cotação]&quot;,{!varLinhasTxt})&amp;IF(BLANKVALUE({!varQuote.SBQQ__LineItemCount__c},0)&gt;50,&quot;e mais &quot;&amp;TEXT(BLANKVALUE({!varQuote.SBQQ__LineItemCount__c},0)-50)&amp;&quot; itens (ver cotação)&quot;,&quot;&quot;))</expression>
    </formulas>
    <formulas>
        <name>fDadosOportunidade</name>
        <dataType>String</dataType>
        <expression>&quot;Oportunidade (nome): &quot;&amp;IF(ISBLANK({!varOpp.Name}),&quot;[dado ausente: Nome da oportunidade]&quot;,{!varOpp.Name})&amp;CHR(10)&amp;&quot;Etapa: &quot;&amp;IF(ISBLANK(TEXT({!varOpp.StageName})),&quot;[dado ausente: Etapa]&quot;,TEXT({!varOpp.StageName}))&amp;CHR(10)&amp;&quot;Data de fechamento prevista: &quot;&amp;IF(ISBLANK({!varOpp.CloseDate}),&quot;[dado ausente: Data de fechamento]&quot;,TEXT(DAY({!varOpp.CloseDate}))&amp;&quot;/&quot;&amp;TEXT(MONTH({!varOpp.CloseDate}))&amp;&quot;/&quot;&amp;TEXT(YEAR({!varOpp.CloseDate})))&amp;CHR(10)&amp;&quot;Valor da oportunidade: &quot;&amp;IF(ISBLANK({!varOpp.Amount}),&quot;[dado ausente: Valor da oportunidade]&quot;,TEXT({!varOpp.CurrencyIsoCode})&amp;&quot; &quot;&amp;SUBSTITUTE(TEXT({!varOpp.Amount}),&quot;.&quot;,&quot;,&quot;))&amp;CHR(10)&amp;&quot;Probabilidade: &quot;&amp;IF(ISBLANK({!varOpp.Probability}),&quot;[dado ausente: Probabilidade]&quot;,SUBSTITUTE(TEXT({!varOpp.Probability}),&quot;.&quot;,&quot;,&quot;)&amp;&quot;%&quot;)&amp;CHR(10)&amp;&quot;Tipo: &quot;&amp;IF(ISBLANK(TEXT({!varOpp.Type})),&quot;[dado ausente: Tipo]&quot;,TEXT({!varOpp.Type}))&amp;CHR(10)&amp;&quot;Origem do lead: &quot;&amp;IF(ISBLANK(TEXT({!varOpp.LeadSource})),&quot;[dado ausente: Origem do lead]&quot;,TEXT({!varOpp.LeadSource}))&amp;CHR(10)&amp;&quot;Encerrada: &quot;&amp;IF({!varOpp.IsClosed},&quot;sim&quot;,&quot;não&quot;)&amp;CHR(10)&amp;&quot;Ganha: &quot;&amp;IF({!varOpp.IsWon},&quot;sim&quot;,&quot;não&quot;)&amp;CHR(10)&amp;&quot;Última atividade: &quot;&amp;IF(ISBLANK({!varOpp.LastActivityDate}),&quot;[dado ausente: Última atividade]&quot;,TEXT(DAY({!varOpp.LastActivityDate}))&amp;&quot;/&quot;&amp;TEXT(MONTH({!varOpp.LastActivityDate}))&amp;&quot;/&quot;&amp;TEXT(YEAR({!varOpp.LastActivityDate})))&amp;CHR(10)&amp;&quot;Conta (nome): &quot;&amp;IF(ISBLANK({!varAcc.Name}),&quot;[dado ausente: Nome da conta]&quot;,{!varAcc.Name})&amp;CHR(10)&amp;&quot;Conta (setor): &quot;&amp;IF(ISBLANK(TEXT({!varAcc.Industry})),&quot;[dado ausente: Setor da conta]&quot;,TEXT({!varAcc.Industry}))&amp;CHR(10)&amp;&quot;Conta (tipo): &quot;&amp;IF(ISBLANK(TEXT({!varAcc.Type})),&quot;[dado ausente: Tipo da conta]&quot;,TEXT({!varAcc.Type}))&amp;CHR(10)&amp;&quot;Conta (cidade): &quot;&amp;IF(ISBLANK({!varAcc.BillingCity}),&quot;[dado ausente: Cidade da conta]&quot;,{!varAcc.BillingCity})&amp;CHR(10)&amp;&quot;Conta (estado): &quot;&amp;IF(ISBLANK({!varAcc.BillingState}),&quot;[dado ausente: Estado da conta]&quot;,{!varAcc.BillingState})</expression>
    </formulas>
    <formulas>
        <name>fLinhaAtual</name>
        <dataType>String</dataType>
        <expression>&quot;- &quot;&amp;IF(ISBLANK({!Loop_Linhas.SBQQ__ProductName__c}),&quot;[dado ausente: Produto]&quot;,{!Loop_Linhas.SBQQ__ProductName__c})&amp;&quot; | quantidade: &quot;&amp;IF(ISBLANK({!Loop_Linhas.SBQQ__Quantity__c}),&quot;[dado ausente: Quantidade]&quot;,SUBSTITUTE(TEXT({!Loop_Linhas.SBQQ__Quantity__c}),&quot;.&quot;,&quot;,&quot;))&amp;&quot; | preço líquido: &quot;&amp;IF(ISBLANK({!Loop_Linhas.SBQQ__NetPrice__c}),&quot;[dado ausente: Preço líquido]&quot;,SUBSTITUTE(TEXT({!Loop_Linhas.SBQQ__NetPrice__c}),&quot;.&quot;,&quot;,&quot;))&amp;&quot; | desconto: &quot;&amp;IF(ISBLANK({!Loop_Linhas.SBQQ__Discount__c}),&quot;[dado ausente: Desconto]&quot;,SUBSTITUTE(TEXT({!Loop_Linhas.SBQQ__Discount__c}),&quot;.&quot;,&quot;,&quot;)&amp;&quot;%&quot;)&amp;&quot; | total líquido: &quot;&amp;IF(ISBLANK({!Loop_Linhas.SBQQ__NetTotal__c}),&quot;[dado ausente: Total líquido]&quot;,SUBSTITUTE(TEXT({!Loop_Linhas.SBQQ__NetTotal__c}),&quot;.&quot;,&quot;,&quot;))&amp;CHR(10)</expression>
    </formulas>
