    <assignments>
        <description>Soma Amount das oportunidades ganhas do ano da conta (regra atual, mantida: P2).</description>
        <name>AssignSumValue</name>
        <label>Atribuir Soma do Valor</label>
        <locationX>666</locationX>
        <locationY>684</locationY>
        <assignmentItems>
            <assignToReference>SumAmount</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>LoopOpportunities.Amount</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>LoopOpportunities</targetReference>
        </connector>
    </assignments>
    <assignments>
        <description>Media da conta vazia: mantem o Ranking atual da conta (nunca grava GG por falta de dado; criterio 11 da analise, P6).</description>
        <name>KeepCurrentRanking</name>
        <label>Manter Ranking Atual</label>
        <locationX>50</locationX>
        <locationY>1100</locationY>
        <assignmentItems>
            <assignToReference>NewRanking</assignToReference>
            <operator>Assign</operator>
