__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
dist/
build/
.env
.DS_Store

# apps/squad-os/ já ignora o seu próprio node_modules — mas é workspace npm
# (ver package.json na raiz), e `npm install`/`npm ci` rodado de dentro dele
# ainda hoisteia um node_modules aqui na raiz. Sem isto, toda sessão que
# instala dependências do Squad OS localmente vê "untracked files" na raiz.
node_modules/

# Per-client Salesforce DX projects are real deliverables; only ignore local auth/log noise
clients/*/.sfdx/
clients/*/.sf/
clients/*/logs/

# Local-machine permission overrides (not shared doctrine, that's .claude/settings.json)
.claude/settings.local.json
